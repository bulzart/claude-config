# ~/.claude is versioned for YOUR customizations only.
# Allow-list: everything is ignored unless re-included below, so Claude Code's own runtime data,
# caches, sessions, transcripts, credentials, plugin code, updates and installs never get committed.
# To track a new folder of yours, add a line  !/<folder>/  in the "your customizations" block.
/*

# ---- your customizations ---------------------------------------------------------------
!/.gitignore
!/VERSIONING.md
!/CLAUDE.md
!/AGENTS.md
!/rules/
!/settings.json
!/keybindings.json
!/commands/
!/skills/
!/agents/
!/hooks/
!/output-styles/
!/workflows/
!/scripts/
!/analyze-then-pick/
!/analyze-then-generate/
!/analyze-with-loupe/
!/analyze-stack/
!/create-clips/
!/create-static/
!/static-studio/
# plugin settings only (which plugins and marketplaces are installed); their downloaded code, caches and marketplace clones stay out
!/plugins/
/plugins/*
!/plugins/installed_plugins.json
!/plugins/known_marketplaces.json
!/plugins/plugin-directory-bindings.json
# (loupe/ is its own git repository now, private GitHub repo bulzart/loupe: not tracked here)

# memories only (never the session transcripts next to them)
!/projects/
/projects/*/*
!/projects/*/memory/

# ---- never, even inside the folders above ------------------------------------------------
# Encrypted-at-rest source (the user, 2026-11-15): `cc.py source unlock` regenerates these plain .py files locally, for editing; only their
# .py.enc stays tracked. Ignored by exact name (not a *.py wildcard) so a brand-new cc_*.py module is tracked plain until it is deliberately
# locked - add its name here, in create-clips/scripts/cc_crypto_loader.py's ALWAYS_PLAIN stays untouched, when it joins the protected set.
/create-clips/scripts/cc_audio.py
/create-clips/scripts/cc_common.py
/create-clips/scripts/cc_edit.py
/create-clips/scripts/cc_frames.py
/create-clips/scripts/cc_game.py
/create-clips/scripts/cc_heat.py
/create-clips/scripts/cc_hud.py
/create-clips/scripts/cc_notify.py
/create-clips/scripts/cc_proc.py
/create-clips/scripts/cc_report.py
/create-clips/scripts/cc_sheets.py
/create-clips/scripts/cc_tables.py
/create-clips/scripts/cc_wordbox.py
/create-clips/scripts/cc_voices.py
/create-clips/scripts/cc_recall.py
/create-clips/scripts/cc_paper.py
/create-clips/scripts/cc_music.py
/create-clips/scripts/cc_ops.py
/create-static/scripts/cs_core.py
/create-static/scripts/cs_compose.py
/.credentials.json
/skills/synced/
/skills/.trash/
node_modules/
__pycache__/
*.pyc
.transcript-cache/
/analyze-then-pick/runs/
/analyze-then-pick/_backups/
/analyze-then-generate/runs/
/analyze-then-generate/_backups/
/analyze-with-loupe/runs/
/analyze-with-loupe/_backups/
/analyze-stack/runs/
/analyze-stack/samples/
/create-clips/runs/
/create-clips/data/sfx-cache.json
/create-clips/data/font-cache.json
/create-static/runs/
/create-static/_backups/
/static-studio/runs/
/loupe/data/

# ---- never versioned, inside any allowed folder ------------------------------------------------
# Runtime logs grow on every run and can carry run details, and secrets never belong in a checkpoint;
# the files stay on disk, only versioning leaves them out (the auto-commit hook follows this file).
*.log
**/logs/
.env
*.env
*.pem
*.key
*.p12
*.pfx
*credentials*.json
