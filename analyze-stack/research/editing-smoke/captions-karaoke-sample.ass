[Script Info]
; TikTok-style caption sample verified with ffmpeg 9.0.1 / libass on 2026-09-16 (1080x1920).
; Style "Cap" uses an installed font (Arial Black); "CapImpact" uses Impact.
; For Montserrat/Anton pass fontsdir=<folder with the .ttf files> to the ass filter (no font install needed).
ScriptType: v4.00+
PlayResX: 1080
PlayResY: 1920
WrapStyle: 2
ScaledBorderAndShadow: yes
YCbCr Matrix: TV.709

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: Cap,Arial Black,88,&H00FFFFFF,&H0000E5FF,&H00000000,&H80000000,-1,0,0,0,100,100,0,0,1,6,2,2,80,80,560,1
Style: CapImpact,Impact,96,&H00FFFFFF,&H0000E5FF,&H00000000,&H80000000,0,0,0,0,100,100,2,0,1,7,3,2,80,80,560,1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
; Mode 1: \k karaoke (cumulative fill Secondary -> Primary)
Dialogue: 0,0:00:00.20,0:00:01.40,Cap,,0,0,0,,{\k30}THIS {\k40}IS {\k50}KARAOKE
Dialogue: 0,0:00:01.40,0:00:02.80,Cap,,0,0,0,,{\k35}WORD {\k35}BY {\k70}WORD
; Mode 2: per-word events (only the active word is highlighted) - the TikTok look
Dialogue: 0,0:00:02.80,0:00:03.30,CapImpact,,0,0,0,,{\c&HFFFFFF&}PER {\c&H00E5FF&}WORD
Dialogue: 0,0:00:03.30,0:00:03.90,CapImpact,,0,0,0,,{\c&HFFFFFF&}PER {\c&HFFFFFF&}WORD {\c&H00E5FF&}EVENTS
Dialogue: 0,0:00:04.20,0:00:05.60,Cap,,0,0,0,,{\fad(80,80)\k40}SAFE {\k40}ZONE {\k60}BOTTOM
