{
  "permissions": {
    "allow": [
      "Bash(powershell -File -:*)",
      "mcp__Roblox_Studio__run_code"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-sonnet-5",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/autocommit.py Stop",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/autocommit.py SessionStart",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/atp_resume_note.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/atp_read_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/awl_input_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__higgsfield__generate_video|mcp__higgsfield__generate_image|mcp__higgsfield__generate_video_batch|mcp__higgsfield__generate_image_batch|mcp__higgsfield__jobs_wait|mcp__higgsfield__show_generations|mcp__higgsfield__show_generation_by_ids|mcp__higgsfield__media_confirm|mcp__higgsfield__media_import_url|mcp__higgsfield__manage_reference_elements|mcp__higgsfield__execute_preset|mcp__higgsfield__media_upload",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/atp_flag_watch.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__higgsfield__generate_video|mcp__higgsfield__generate_image|mcp__higgsfield__generate_video_batch|mcp__higgsfield__generate_image_batch|mcp__higgsfield__jobs_wait|mcp__higgsfield__show_generations|mcp__higgsfield__show_generation_by_ids|mcp__higgsfield__media_confirm|mcp__higgsfield__media_import_url|mcp__higgsfield__manage_reference_elements|mcp__higgsfield__execute_preset|mcp__higgsfield__media_upload",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/atp_flag_watch.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "\"C:/Program Files/Git/bin/bash.exe\" C:/Users/Bulzart/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "github@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 850000
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-4-6": {
      "effortLevel": "xhigh"
    }
  },
  "autoCompactWindow": 850000,
  "askUserQuestionTimeout": "never",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": false,
  "terminalProgressBarEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: (unknown — no remotes configured, origin/HEAD unset)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo and its remote(s) only (no additional orgs configured) — as scoped by the Trusted repo and Repository visibility entries above",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar — note: AI/ACE-Step-1.5/.env and AI/ACE-Step-1.5/.env.example were found by filename scan and likely hold credentials",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment (hyphen/underscore/dot-delimited — e.g. matches `prod-db`, not `producer`)",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: The git repository the agent started in (its working directory) — C:\\Users\\Bulzart\\Documents has no tracked files and no configured remotes, so there is no identifiable trusted remote at this time",
      "**Org-specific CLIs**: None configured"
    ]
  },
  "voiceEnabled": true
}
