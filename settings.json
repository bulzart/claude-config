{
  "permissions": {
    "allow": [
      "Bash(powershell -File -:*)",
      "mcp__Roblox_Studio__run_code"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/autocommit.py Stop",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/autocommit.py SessionStart",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/atp_resume_note.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/atp_read_guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/awl_input_guard.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__higgsfield__generate_video|mcp__higgsfield__generate_image|mcp__higgsfield__generate_video_batch|mcp__higgsfield__generate_image_batch|mcp__higgsfield__jobs_wait|mcp__higgsfield__show_generations|mcp__higgsfield__show_generation_by_ids|mcp__higgsfield__media_confirm|mcp__higgsfield__media_import_url|mcp__higgsfield__manage_reference_elements|mcp__higgsfield__execute_preset|mcp__higgsfield__media_upload",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/atp_flag_watch.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__higgsfield__generate_video|mcp__higgsfield__generate_image|mcp__higgsfield__generate_video_batch|mcp__higgsfield__generate_image_batch|mcp__higgsfield__jobs_wait|mcp__higgsfield__show_generations|mcp__higgsfield__show_generation_by_ids|mcp__higgsfield__media_confirm|mcp__higgsfield__media_import_url|mcp__higgsfield__manage_reference_elements|mcp__higgsfield__execute_preset|mcp__higgsfield__media_upload",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Bulzart/AppData/Local/Programs/Python/Python312/python.exe C:/Users/Bulzart/.claude/hooks/atp_flag_watch.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "\"C:/Program Files/Git/bin/bash.exe\" C:/Users/Bulzart/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "github@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh",
      "autoCompactWindow": 850000
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 850000,
  "askUserQuestionTimeout": "never",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "terminalProgressBarEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
