try:
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
except Exception:
    pass

ATG_HOME = Path(__file__).resolve().parent.parent
CONFIG_PATH = ATG_HOME / "config.json"

VIDEO_EXT = {".mp4", ".mov", ".m4v", ".webm", ".mkv", ".avi", ".wmv", ".flv", ".mpg", ".mpeg",
             ".3gp", ".ts", ".mts", ".m2ts"}
