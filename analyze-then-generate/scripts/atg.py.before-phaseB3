AUDIO_EXT = {".mp3", ".wav", ".m4a", ".aac", ".flac", ".ogg", ".opus", ".wma"}
TEXT_EXT = {".txt", ".md", ".markdown", ".csv", ".tsv", ".json", ".yaml", ".yml", ".srt", ".vtt",
            ".html", ".htm", ".xml", ".rtf", ".log"}
OFFICE_EXT = {".docx", ".pptx", ".xlsx"}
PDF_EXT = {".pdf"}
FONT_EXT = {".ttf", ".otf", ".woff", ".woff2"}
VECTOR_EXT = {".svg", ".eps", ".ai"}

DERIVED_DIRS = {"files_audio", "videos_without_audio"}      # created by split-audio inside the user's path
FINAL_DIR = "final"                                          # approved Edit Mode results, inside the user's path
FINAL_MARKER = ".atg-final"                                  # hidden marker: only OUR final folder is skipped
LEGACY_FINAL_MARKER = ".atp-final"                           # the parent pipeline marker: its final/ folders are skipped too
SKIP_DIRS = {".git", "node_modules", "__pycache__", ".venv", "venv", ".idea", ".vscode",
             "$RECYCLE.BIN", "System Volume Information", ".analyze-then-generate", ".analyze-then-pick"} | DERIVED_DIRS
AUDIO_EXT_FOR_CODEC = {"aac": ".m4a", "alac": ".m4a", "mp3": ".mp3", "opus": ".opus", "vorbis": ".ogg",
                       "flac": ".flac", "pcm_s16le": ".wav", "pcm_s24le": ".wav", "pcm_f32le": ".wav"}

CONTENT_TYPES = {
    ".mp4": "video/mp4", ".mov": "video/quicktime", ".m4v": "video/mp4", ".webm": "video/webm",
    ".mkv": "video/x-matroska", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".png": "image/png",
    ".webp": "image/webp", ".gif": "image/gif", ".mp3": "audio/mpeg", ".wav": "audio/wav",
    ".m4a": "audio/mp4", ".aac": "audio/aac", ".flac": "audio/flac", ".ogg": "audio/ogg",
}


# --------------------------------------------------------------------------- utilities

def load_config() -> dict:
    try:
        return json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
    except Exception:
        return {}


def cfg_get(path: str, default=None):
    cur = load_config()
    for part in path.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


def out(obj: dict, code: int = 0):
    print(json.dumps(obj, ensure_ascii=False))
    sys.exit(code)


def fail(msg: str, code: int = 1, **extra):
    out({"ok": False, "error": msg, **extra}, code)


def now_iso() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def slugify(text: str, maxlen: int = 40) -> str:
    s = re.sub(r"[^A-Za-z0-9]+", "-", text).strip("-").lower()
    return (s or "run")[:maxlen]


def ts_label(t: float) -> str:
    m, s = divmod(max(0.0, t), 60)
    return f"{int(m):02d}:{s:05.2f}"


def ts_name(t: float) -> str:
    m, s = divmod(max(0.0, t), 60)
    return f"{int(m):02d}m{s:05.2f}s"


def _tmp_name(path: Path) -> Path:
    """A temporary file name no other process or thread uses, so two writers of one file never collide on it."""
    return path.with_name(f"{path.name}.{os.getpid()}-{threading.get_ident()}.tmp")


def _replace_retry(tmp: Path, path: Path) -> None:
    """os.replace, retried for about two seconds: on Windows a file cannot be replaced while another process has it open for reading."""
    for attempt in range(40):
        try:
            os.replace(tmp, path)
            return
        except PermissionError:
            if attempt == 39:
                raise
            time.sleep(0.05)


def write_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = _tmp_name(path)
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")
    _replace_retry(tmp, path)


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = _tmp_name(path)
    tmp.write_text(text, encoding="utf-8")
    _replace_retry(tmp, path)


def find_tool(name: str) -> str:
    cfg = load_config().get("tools", {})
    if cfg.get(name) and Path(cfg[name]).exists():
        return cfg[name]
    found = shutil.which(name)
    if found:
        return found
    local = os.environ.get("LOCALAPPDATA", "")
    patterns = [
        os.path.join(local, "Microsoft", "WinGet", "Packages", "*FFmpeg*", "*", "bin", name + ".exe"),
        os.path.join(local, "Microsoft", "WinGet", "Links", name + ".exe"),
        os.path.join("C:\\", "ffmpeg", "bin", name + ".exe"),
        os.path.join("C:\\", "Program Files", "ffmpeg", "bin", name + ".exe"),
    ]
    for pat in patterns:
        hits = sorted(glob.glob(pat), reverse=True)
        if hits:
            return hits[0]
    raise FileNotFoundError(f"{name} not found on PATH or in the usual install folders")


def run(cmd: list, cwd=None, timeout=None, check=False) -> subprocess.CompletedProcess:
    cp = subprocess.run([str(c) for c in cmd], cwd=cwd, capture_output=True, text=True,
                        encoding="utf-8", errors="replace", timeout=timeout)
    if check and cp.returncode != 0:
        raise RuntimeError(f"command failed ({cp.returncode}): {' '.join(map(str, cmd))[:300]}\n"
                           f"{cp.stderr[-1500:]}")
    return cp


def ffprobe_json(path) -> dict:
    cp = run([find_tool("ffprobe"), "-v", "error", "-show_streams", "-show_format", "-of", "json",
              str(path)], timeout=120)
    if cp.returncode != 0:
        raise RuntimeError(f"ffprobe failed on {path}: {cp.stderr.strip()[:400]}")
    return json.loads(cp.stdout or "{}")


def _ratio(s: str | None) -> float | None:
    if not s or s in ("0/0", "N/A"):
        return None
    try:
        if "/" in s:
            a, b = s.split("/", 1)
            return float(a) / float(b) if float(b) else None
        return float(s)
    except Exception:
        return None


def _rotation(stream: dict) -> int:
    rot = 0
    try:
        rot = int(float(stream.get("tags", {}).get("rotate", 0)))
    except Exception:
        rot = 0
    for sd in stream.get("side_data_list", []) or []:
        if "rotation" in sd:
            try:
                rot = int(float(sd["rotation"]))
            except Exception:
                pass
    return rot % 360


def nearest_aspect(w: int, h: int) -> str:
    if not w or not h:
        return "unknown"
    r = w / h
    common = {"9:16": 9 / 16, "16:9": 16 / 9, "1:1": 1.0, "4:5": 0.8, "3:4": 0.75, "4:3": 4 / 3,
              "21:9": 21 / 9, "2:3": 2 / 3, "3:2": 1.5, "2:1": 2.0}
    best = min(common.items(), key=lambda kv: abs(kv[1] - r))
    if abs(best[1] - r) / best[1] < 0.04:
        return best[0]
    g = math.gcd(int(w), int(h)) or 1
    return f"{int(w) // g}:{int(h) // g}"


def media_summary(path) -> dict:
    """Rotation- and SAR-aware summary following Higgsfield's media-pipeline normalisation."""
    pj = ffprobe_json(path)
    streams = pj.get("streams", [])
    fmt = pj.get("format", {})
    vids = [s for s in streams if s.get("codec_type") == "video"
            and not (s.get("disposition", {}) or {}).get("attached_pic")]
    auds = [s for s in streams if s.get("codec_type") == "audio"]
    v = next((s for s in vids if (s.get("disposition", {}) or {}).get("default") == 1), vids[0] if vids else None)
    a = next((s for s in auds if (s.get("disposition", {}) or {}).get("default") == 1), auds[0] if auds else None)
    dur = None
    for cand in (fmt.get("duration"), (v or {}).get("duration"), (a or {}).get("duration")):
        try:
            if cand is not None and math.isfinite(float(cand)) and float(cand) > 0:
                dur = float(cand)
                break
        except Exception:
            pass
    res = {"path": str(path), "duration_s": round(dur, 3) if dur else None,
           "size_bytes": int(fmt.get("size", 0) or 0), "format": fmt.get("format_name"),
           "bitrate": int(fmt.get("bit_rate", 0) or 0), "has_video": bool(v), "has_audio": bool(a)}
    if v:
        w, h = int(v.get("width", 0) or 0), int(v.get("height", 0) or 0)
        sar = _ratio(v.get("sample_aspect_ratio")) or 1.0
        rot = _rotation(v)
        dw, dh = (round(w * sar), h)
        if rot in (90, 270):
            dw, dh = dh, dw
        fps = _ratio(v.get("avg_frame_rate")) or _ratio(v.get("r_frame_rate")) or 24.0
        res.update({"codec": v.get("codec_name"), "width": w, "height": h, "rotation": rot,
                    "display_width": dw, "display_height": dh, "fps": round(fps, 3),
                    "aspect": nearest_aspect(dw, dh),
                    "orientation": "portrait" if dh > dw * 1.05 else ("landscape" if dw > dh * 1.05 else "square"),
                    "pix_fmt": v.get("pix_fmt"), "nb_frames": int(v.get("nb_frames", 0) or 0),
                    "video_start": float(v.get("start_time", 0) or 0)})
    if a:
        res.update({"audio_codec": a.get("codec_name"), "audio_index": int(a.get("index", 0)),
                    "audio_channels": a.get("channels"), "audio_rate": a.get("sample_rate"),
                    "audio_start": float(a.get("start_time", 0) or 0)})
    return res


def quick_hash(path: Path) -> str:
    h = hashlib.sha1()
    size = path.stat().st_size
    h.update(str(size).encode())
    with open(path, "rb") as f:
        h.update(f.read(1 << 20))
        if size > (2 << 20):
            f.seek(-(1 << 20), os.SEEK_END)
            h.update(f.read(1 << 20))
    return h.hexdigest()[:16]


def classify(path: Path) -> str:
    ext = path.suffix.lower()
    if ext in VIDEO_EXT:
        return "video"
    if ext == ".gif":
        try:
            s = media_summary(path)
            return "video" if (s.get("nb_frames") or 0) > 1 else "image"
        except Exception:
            return "image"
    if ext in IMAGE_EXT:
        return "image"
    if ext in AUDIO_EXT:
        return "audio"
    if ext in PDF_EXT:
        return "pdf"
    if ext in OFFICE_EXT:
        return "office"
    if ext in TEXT_EXT:
        return "text"
    if ext in FONT_EXT:
        return "font"
    if ext in VECTOR_EXT:
        return "vector"
    return "other"


# --------------------------------------------------------------------------- frame extraction

def _scale_vf(max_side: int) -> str:
    return (f"scale='if(gt(iw,ih),min({max_side},iw),-2)':'if(gt(iw,ih),-2,min({max_side},ih))'")


def extract_frame(video: str, t: float, dest: Path, max_side: int = 1280) -> bool:
    dest.parent.mkdir(parents=True, exist_ok=True)
    for attempt_t in (t, max(0.0, t - 0.15), max(0.0, t - 0.4)):
        cp = run([find_tool("ffmpeg"), "-hide_banner", "-loglevel", "error", "-nostdin", "-y",
                  "-ss", f"{attempt_t:.3f}", "-i", video, "-frames:v", "1", "-vf", _scale_vf(max_side),
                  "-q:v", "3", str(dest)], timeout=120)
        if cp.returncode == 0 and dest.exists() and dest.stat().st_size > 0:
            return True
    return False


def extract_many(video: str, items: list, max_side: int = 1280, workers: int = 4) -> list:
    """items: [(t, dest_path, extra_dict)] -> [{t, file, ok, **extra}] sorted by t."""
    results = []
    with cf.ThreadPoolExecutor(max_workers=workers) as ex:
        futs = {ex.submit(extract_frame, video, t, d, max_side): (t, d, extra) for t, d, extra in items}
        for fut in cf.as_completed(futs):
            t, d, extra = futs[fut]
            try:
                ok = fut.result()
            except Exception:
                ok = False
            results.append({"t": round(t, 3), "file": str(d), "ok": ok, **(extra or {})})
    results.sort(key=lambda r: (r["t"], r["file"]))
    return results


def extract_baseline(video: str, fps: float, dest: Path, dur: float, max_side: int = 720,
                     max_frames: int = 1800) -> tuple[list, float, str | None]:
    """One FFmpeg pass on a regular grid: frame n shows the source frame nearest to n / fps."""
    shutil.rmtree(dest, ignore_errors=True)
    dest.mkdir(parents=True, exist_ok=True)
    eff, note = fps, None
    if dur and dur * fps > max_frames:
        eff = max_frames / dur
        note = (f"baseline lowered from {fps} to {eff:.2f} fps to respect max_frames={max_frames}; "
                f"densify segments of interest with `frames --range a-b --fps {fps:g}`")
    run([find_tool("ffmpeg"), "-hide_banner", "-loglevel", "error", "-nostdin", "-y", "-i", video,
         "-map", "0:v:0", "-vf", f"fps={eff:.6f},{_scale_vf(max_side)}", "-q:v", "4",
         "-start_number", "0", str(dest / "base_%06d.jpg")], timeout=3600, check=True)
    files = sorted(dest.glob("base_*.jpg"))
    frames = []
    for p in files:
        n = int(p.stem.split("_")[1])
        t = n / eff
        if dur and t > dur:
            break
        frames.append({"t": round(t, 3), "file": str(p), "ok": True, "kind": "base"})
    return frames, eff, note


def thin_static(frames: list, threshold: float = 2.5, max_gap: float = 1.0, min_run: int = 3) -> list:
    """Drop near-duplicate baseline frames inside static stretches, keeping >= 1 frame per max_gap
    seconds. Compares each frame with the last KEPT frame (48x48 grey, mean abs difference 0-255), so
    slow continuous motion accumulates and is kept. Only runs of >= min_run consecutive duplicates
    count as a static stretch; shorter runs are restored so ordinary footage keeps its full 5 fps.
    Returns the static runs actually thinned [{start, end, dropped}]."""
    if threshold <= 0:
        for f in frames:
            f["kept"] = True
        return []
    try:
        from PIL import Image
        import numpy as np
    except Exception:
        for f in frames:
            f["kept"] = True
        return []
    ref, ref_t, runs, cur = None, -1e9, [], None
    for f in frames:
        with Image.open(f["file"]) as im:
            g = np.asarray(im.convert("L").resize((48, 48)), dtype="float32")
        if ref is None:
            keep, diff = True, None
        else:
            diff = float(np.mean(np.abs(g - ref)))
            keep = diff >= threshold or (f["t"] - ref_t) >= max_gap - 1e-6
        f["diff_prev_kept"] = None if diff is None else round(diff, 2)
        f["kept"] = keep
        if keep:
            ref, ref_t = g, f["t"]
            if cur:
                runs.append(cur)
                cur = None
        else:
            if cur is None:
                cur = {"start": f["t"], "end": f["t"], "dropped": 0}
            cur["end"] = f["t"]
            cur["dropped"] += 1
    if cur:
        runs.append(cur)
    thinned = []
    for r in runs:
        if r["dropped"] >= min_run:
            thinned.append(r)
        else:                                   # too short to be a static stretch: keep those frames
            for f in frames:
                if r["start"] - 1e-6 <= f["t"] <= r["end"] + 1e-6:
                    f["kept"] = True
    return thinned


# --------------------------------------------------------------------------- sheets

def _font(size: int):
    from PIL import ImageFont
    for cand in (r"C:\Windows\Fonts\arialbd.ttf", r"C:\Windows\Fonts\arial.ttf",
                 "/System/Library/Fonts/Helvetica.ttc", "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"):
        try:
            return ImageFont.truetype(cand, size)
        except Exception:
            continue
    return ImageFont.load_default()


def _layout(orientation: str, dense: bool = True) -> tuple:
    """(cols, rows, cell_w, cell_h). 30 frames per sheet, sized to ≤ 1.15 MP and ≤ 1568 px on the
    long side so Claude's vision reads it at full size: nothing is downscaled, every cell shows at
    its real pixels. Portrait 6 × 5 = 1.2 s per row at 5 fps (828 × 1351); landscape 5 × 6 (1200 ×
    952); square 5 × 6 (920 × 1246). The old 50-cell 1500 px sheets were 2.2 MP and came back
    shrunk by ~0.73, so a 150 px cell showed at ~109 px."""
    if orientation == "landscape":
        return (5, 6, 240, 135) if dense else (3, 4, 480, 270)
    if orientation == "square":
        return (5, 6, 184, 184) if dense else (4, 3, 360, 360)
    return (6, 5, 138, 245) if dense else (4, 3, 300, 533)


STORYBOARD_LEGEND = ("left to right, top to bottom | white = baseline | cyan + = densified | "
                     "red bar = first frame after a cut | grey = static stretch thinned")


def build_storyboard(items: list, dest_prefix: Path, title: str, orientation: str,
                     dense: bool = True, legend: str | None = None, show_times: bool = True) -> list:
    """Chronological flow layout. items: frame dicts {t, file, ok, kind base|extra, shot, flags[],
    label?} or static markers {kind: 'static', start, end, dropped}. An item's 'label' replaces the
    computed time label (used for asset sheets). Returns [{sheet, start, end, cells}]."""
    try:
        from PIL import Image, ImageDraw, ImageOps
    except Exception:
        return []
    cells = [it for it in items if it.get("kind") == "static" or (it.get("ok") and Path(it["file"]).exists())]
    if not cells:
        return []
    cols, rows, cw, ch = _layout(orientation, dense)
    label_h, head_h = 16 if dense else 24, 46
    per = cols * rows
    font, hfont, sfont = _font(12 if dense else 15), _font(17), _font(12)
    pages = math.ceil(len(cells) / per)
    per_page = math.ceil(len(cells) / pages / cols) * cols      # balanced pages, whole rows
    res = []
    for pi in range(pages):
        chunk = cells[pi * per_page:(pi + 1) * per_page]
        if not chunk:
            break
        nrows = math.ceil(len(chunk) / cols)
        sheet = Image.new("RGB", (cols * cw, head_h + nrows * (ch + label_h)), (16, 16, 16))
        dr = ImageDraw.Draw(sheet)
        t_first = chunk[0].get("t", chunk[0].get("start", 0.0))
        t_last = chunk[-1].get("t", chunk[-1].get("end", 0.0))
        span = f"  {ts_label(t_first)}-{ts_label(t_last)}" if show_times else ""
        dr.text((8, 4), f"{title}{span}  (sheet {pi + 1}/{pages})", fill=(240, 240, 240), font=hfont)
        dr.text((8, 25), legend or STORYBOARD_LEGEND, fill=(170, 170, 170), font=sfont)
        for i, it in enumerate(chunk):
            r, c = divmod(i, cols)
            x0, y0 = c * cw, head_h + r * (ch + label_h)
            if it.get("kind") == "static":
                dr.rectangle([x0 + 2, y0 + 2, x0 + cw - 3, y0 + ch - 3], fill=(58, 58, 58))
                dr.text((x0 + 8, y0 + 10), "static", fill=(220, 220, 220), font=font)
                dr.text((x0 + 8, y0 + 28), f"{it['start']:.2f}-{it['end']:.2f}s", fill=(220, 220, 220), font=font)
                dr.text((x0 + 8, y0 + 46), f"{it['dropped']} near-duplicate", fill=(200, 200, 200), font=font)
                dr.text((x0 + 8, y0 + 62), "frames omitted", fill=(200, 200, 200), font=font)
                continue
            try:
                with Image.open(it["file"]) as im:
                    im = ImageOps.exif_transpose(im).convert("RGB")
                    im.thumbnail((cw - 2, ch - 2))
                    sheet.paste(im, (x0 + (cw - im.width) // 2, y0 + (ch - im.height) // 2))
            except Exception:
                dr.rectangle([x0 + 2, y0 + 2, x0 + cw - 2, y0 + ch - 2], outline=(200, 0, 0))
            flags = it.get("flags", [])
            if "after_cut" in flags:
                dr.rectangle([x0, y0, x0 + 4, y0 + ch], fill=(235, 40, 40))
            dr.rectangle([x0, y0 + ch, x0 + cw, y0 + ch + label_h], fill=(0, 0, 0))
            extra = it.get("kind") == "extra"
            if it.get("label"):
                lab = it["label"]
                max_chars = max(8, int(cw / (7 if dense else 8.5)))
                lab = lab if len(lab) <= max_chars else lab[:max_chars - 1] + "…"
            else:
                lab = f"{'+' if extra else ''}{it['t']:.2f}"
                if it.get("shot"):
                    lab += f" S{it['shot']:02d}"
                if "after_cut" in flags:
                    lab += " CUT"
                elif "peak" in flags:
                    lab += " pk"
                if it.get("tag"):
                    lab += f" {it['tag']}"
            dr.text((x0 + 5, y0 + ch + 1), lab, fill=(90, 220, 255) if extra else (245, 245, 245), font=font)
        p = Path(f"{dest_prefix}-{pi + 1:02d}.jpg")
        p.parent.mkdir(parents=True, exist_ok=True)
        sheet.save(p, quality=86)
        res.append({"sheet": str(p), "start": round(t_first, 2), "end": round(t_last, 2), "cells": len(chunk)})
    return res


# --------------------------------------------------------------------------- analysis pieces

def scene_scores(video: str, workdir: Path) -> list:
    """Per-frame ffmpeg scene-change score (0..1) -> [(t, score)]."""
    workdir.mkdir(parents=True, exist_ok=True)
    fname = "scene-scores.txt"
    (workdir / fname).unlink(missing_ok=True)
    cp = run([find_tool("ffmpeg"), "-hide_banner", "-loglevel", "error", "-nostdin", "-i", video,
              "-map", "0:v:0", "-vf", f"scale=192:-2,select='gte(scene,0)',metadata=print:file={fname}",
              "-an", "-f", "null", "-"], cwd=str(workdir), timeout=3600)
    if cp.returncode != 0:
        raise RuntimeError("scene scoring failed: " + cp.stderr[-600:])
    pts, cur_t = [], None
    for line in (workdir / fname).read_text(encoding="utf-8", errors="replace").splitlines():
        m = re.search(r"pts_time:([0-9.eE+-]+)", line)
        if m:
            cur_t = float(m.group(1))
            continue
        m = re.search(r"lavfi\.scene_score=([0-9.eE+-]+)", line)
        if m and cur_t is not None:
            pts.append((cur_t, float(m.group(1))))
            cur_t = None
    return pts


def detect_cuts(scores: list, duration: float, hard: float = 0.30, soft: float = 0.14,
                ratio: float = 4.0, min_gap: float = 0.25) -> list:
    if not scores:
        return []
    times = [t for t, _ in scores]
    vals = [s for _, s in scores]
    n = len(vals)
    cand = []
    for i in range(1, n):
        s = vals[i]
        if s < soft:
            continue
        lo, hi = max(0, i - 8), min(n, i + 9)
        neigh = [vals[j] for j in range(lo, hi) if j != i]
        med = statistics.median(neigh) if neigh else 0.0
        is_peak = s >= max(vals[i - 1], vals[i + 1] if i + 1 < n else 0)
        if s >= hard or (is_peak and s >= ratio * max(med, 0.01)):
            cand.append((times[i], s))
    cuts = []
    for t, s in sorted(cand, key=lambda x: -x[1]):
        if t < 0.1 or t > duration - 0.1:
            continue
        if all(abs(t - c[0]) >= min_gap for c in cuts):
            cuts.append((t, s))
    return sorted(cuts)


def activity_windows(scores: list, cuts: list, duration: float, win: float = 0.5) -> list:
    nwin = max(1, math.ceil(duration / win))
    buckets = [[] for _ in range(nwin)]
    cut_ts = [c[0] for c in cuts]
    for t, s in scores:
        if any(abs(t - c) < 0.07 for c in cut_ts):
            continue
        buckets[min(nwin - 1, int(t / win))].append(s)
    res = []
    for k, b in enumerate(buckets):
        res.append({"start": round(k * win, 2), "end": round(min(duration, (k + 1) * win), 2),
                    "mean_change": round(statistics.fmean(b), 4) if b else 0.0,
                    "max_change": round(max(b), 4) if b else 0.0,
                    "has_cut": any(k * win <= c < (k + 1) * win for c in cut_ts)})
    return res


def activity_peaks(windows: list, k: int = 6) -> list:
    vals = [w["mean_change"] for w in windows]
    if not vals:
        return []
    med = statistics.median(vals)
    mad = statistics.median([abs(v - med) for v in vals]) or 0.001
    thr = med + 2.0 * mad
    peaks = []
    for i, w in enumerate(windows):
        if w["has_cut"]:
            continue
        left = vals[i - 1] if i > 0 else -1
        right = vals[i + 1] if i + 1 < len(vals) else -1
        if vals[i] >= thr and vals[i] >= left and vals[i] >= right:
            peaks.append({"t": round((w["start"] + w["end"]) / 2, 2), "mean_change": vals[i],
                          "z": round((vals[i] - med) / mad, 2)})
    peaks.sort(key=lambda p: -p["mean_change"])
    chosen = []
    for p in peaks:
        if all(abs(p["t"] - c["t"]) >= 1.0 for c in chosen):
            chosen.append(p)
        if len(chosen) >= k:
            break
    return sorted(chosen, key=lambda p: p["t"])


def densify_plan(cuts: list, peaks: list, dur: float, native_fps: float, base_fps: float,
                 dense_fps: float = 10.0, hook_dense_s: float = 1.0) -> list:
    """Adaptive extra timestamps: last/first frame around every cut, dense_fps around motion peaks
    and over the first hook_dense_s seconds. Skips points already on the baseline grid."""
    eps = 1.0 / max(native_fps, 1.0)
    tmax = max(0.0, dur - 1.5 * eps)
    want = []
    for i, (ct, _) in enumerate(cuts):
        want.append((ct - 1.25 * eps, f"c{i + 1:02d}<", "pre_cut"))         # the frame before the one the score peaks on
        want.append((ct - 0.25 * eps, f"c{i + 1:02d}>", "post_cut"))        # the frame the score peaks on: the first frame of the new shot
    for i, p in enumerate(peaks):
        for k in range(-5, 6):
            want.append((p["t"] + k / dense_fps, f"m{i + 1}", "peak"))
    for k in range(int(round(hook_dense_s * dense_fps))):
        want.append((k / dense_fps, "hook", "hook"))
    grid = 1.0 / base_fps
    picked = []
    for t, tag, why in sorted(want):
        t = min(tmax, max(0.0, t))
        on_grid = abs(t / grid - round(t / grid)) * grid < min(0.03, 0.4 * eps + 0.01)
        if on_grid and why not in ("pre_cut", "post_cut"):
            continue
        if any(abs(t - q[0]) < 0.45 / dense_fps and why == q[2] for q in picked):
            continue
        picked.append((round(t, 3), tag, why))
    return picked


def audio_analysis(video: str, info: dict, workdir: Path) -> dict:
    res = {"has_audio": bool(info.get("has_audio"))}
    if not info.get("has_audio"):
        return res
    ff = find_tool("ffmpeg")
    workdir.mkdir(parents=True, exist_ok=True)
    wav = workdir / "audio-16k.wav"
    run([ff, "-hide_banner", "-loglevel", "error", "-nostdin", "-y", "-i", video, "-map", "0:a:0",
         "-vn", "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", str(wav)], timeout=1800)
    res["wav_16k"] = str(wav) if wav.exists() else None
    cp = run([ff, "-hide_banner", "-nostdin", "-i", video, "-map", "0:a:0", "-af", "ebur128=peak=true",
              "-f", "null", "-"], timeout=1800)
    summ = cp.stderr[cp.stderr.rfind("Summary:"):] if "Summary:" in cp.stderr else ""
    for key, pat in (("integrated_lufs", r"I:\s*(-?[0-9.]+)\s*LUFS"), ("lra_lu", r"LRA:\s*(-?[0-9.]+)\s*LU"),
                     ("true_peak_dbfs", r"Peak:\s*(-?[0-9.]+)\s*dBFS")):
        m = re.search(pat, summ)
        res[key] = float(m.group(1)) if m else None
    cp = run([ff, "-hide_banner", "-nostdin", "-i", video, "-map", "0:a:0",
              "-af", "silencedetect=n=-35dB:d=0.4", "-f", "null", "-"], timeout=1800)
    sil, start = [], None
    for line in cp.stderr.splitlines():
        m = re.search(r"silence_start:\s*(-?[0-9.]+)", line)
        if m:
            start = max(0.0, float(m.group(1)))
        m = re.search(r"silence_end:\s*([0-9.]+)", line)
        if m and start is not None:
            sil.append({"start": round(start, 2), "end": round(float(m.group(1)), 2)})
            start = None
    if start is not None:
        sil.append({"start": round(start, 2), "end": info.get("duration_s")})
    res["silences"] = sil
    fname = "rms.txt"
    (workdir / fname).unlink(missing_ok=True)
    run([ff, "-hide_banner", "-loglevel", "error", "-nostdin", "-i", video, "-map", "0:a:0", "-ac", "1",
         "-ar", "16000", "-af",
         f"asetnsamples=n=8000:p=0,astats=metadata=1:reset=1,ametadata=print:key=lavfi.astats.Overall.RMS_level:file={fname}",
         "-f", "null", "-"], cwd=str(workdir), timeout=1800)
    curve, cur = [], None
    if (workdir / fname).exists():
        for line in (workdir / fname).read_text(encoding="utf-8", errors="replace").splitlines():
            m = re.search(r"pts_time:([0-9.]+)", line)
            if m:
                cur = float(m.group(1))
                continue
            m = re.search(r"RMS_level=(-?[0-9.]+|-inf)", line)
            if m and cur is not None:
                v = m.group(1)
                curve.append({"t": round(cur, 2), "rms_db": -120.0 if v == "-inf" else round(float(v), 1)})
                cur = None
    res["rms_per_0.5s"] = curve
    return res


def transcribe(wav: str, workdir: Path, model_name: str = "small", language: str = "auto", vad: bool = True) -> dict:
    res = {"engine": None, "has_speech": False, "segments": []}
    try:
        from faster_whisper import WhisperModel  # type: ignore
        model = None
        for name in [model_name] + [m for m in ("small", "base", "tiny") if m != model_name]:
            try:
                model = WhisperModel(name, device="cpu", compute_type="int8", local_files_only=True)
                res["model"] = name
                break
            except Exception:
                continue
        if model is None:
            raise RuntimeError("no cached faster-whisper model")
        segs, info = model.transcribe(wav, language=None if language == "auto" else language,
                                      word_timestamps=True, vad_filter=vad, beam_size=5)
        for s in segs:
            res["segments"].append({
                "start": round(s.start, 2), "end": round(s.end, 2), "text": s.text.strip(),
                "words": [{"w": w.word.strip(), "s": round(w.start, 2), "e": round(w.end, 2),
                           "p": round(w.probability, 2)} for w in (s.words or [])]})
        res.update({"engine": "faster-whisper", "language": info.language,
                    "language_probability": round(info.language_probability, 3), "vad_filter": vad})
    except Exception as e:  # fallback: ffmpeg's built-in whisper.cpp filter
        res["faster_whisper_error"] = str(e)[:300]
        model_file = None
        for cand in ("ggml-base.en.bin", "ggml-small.bin", "ggml-base.bin", "ggml-tiny.en.bin"):
            p = Path.home() / ".cache" / "whisper-cpp" / cand
            if p.exists():
                model_file = p
                break
        if model_file:
            esc = str(model_file).replace("\\", "/").replace(":", "\\:")
            srt = "whisper-ffmpeg.srt"
            run([find_tool("ffmpeg"), "-hide_banner", "-loglevel", "error", "-nostdin", "-i", wav, "-af",
                 f"whisper=model='{esc}':language=auto:queue=10:use_gpu=false:format=srt:destination={srt}",
                 "-f", "null", "-"], cwd=str(workdir), timeout=3600)
            p = workdir / srt
            if p.exists():
                for b in re.split(r"\n\s*\n", p.read_text(encoding="utf-8", errors="replace").strip()):
                    m = re.search(r"(\d+):(\d+):(\d+)[,.](\d+)\s*-->\s*(\d+):(\d+):(\d+)[,.](\d+)\s*\n(.*)", b, re.S)
                    if m:
                        g = [int(x) for x in m.groups()[:8]]
                        st = g[0] * 3600 + g[1] * 60 + g[2] + g[3] / 1000
                        en = g[4] * 3600 + g[5] * 60 + g[6] + g[7] / 1000
                        res["segments"].append({"start": round(st, 2), "end": round(en, 2),
                                                "text": " ".join(m.group(9).split()), "words": []})
                res.update({"engine": "ffmpeg-whisper", "model": model_file.name})
    words = sum(len(s["text"].split()) for s in res["segments"])
    res["has_speech"] = words > 0            # the transcriber returned words; what they are worth is for the reader to judge (n_words, the text, the word probabilities)
    res["n_words"] = words
    speech = sum(s["end"] - s["start"] for s in res["segments"])
    res["speech_seconds"] = round(speech, 2)
    res["wpm_speech_only"] = round(words / (speech / 60), 1) if speech > 1 else None
    return res


_OCR = None
_OCR_LOCK = threading.Lock()


def ocr_frames(frames: list) -> dict:
    """RapidOCR over frame files -> detections + spans with the numbers that describe them (frames seen, row, confidence, spelling facts). Thread-safe."""
    with _OCR_LOCK:
        return _ocr_frames_locked(frames)


def _ocr_frames_locked(frames: list) -> dict:
    global _OCR
    try:
        if _OCR is None:
            from rapidocr_onnxruntime import RapidOCR  # type: ignore
            _OCR = RapidOCR()
        from PIL import Image
        import numpy as np
    except Exception as e:
        return {"available": False, "error": str(e)[:200]}
    dets, n_frames = [], 0
    for fr in frames:
        if not fr.get("ok", True) or not Path(fr["file"]).exists():
            continue
        try:
            with Image.open(fr["file"]) as im:
                im = im.convert("RGB")
                im.thumbnail((736, 736))          # overlay text stays legible; detection is 2x faster
                arr = np.asarray(im)[:, :, ::-1].copy()   # RGB -> BGR as RapidOCR expects
                height = im.height
            result, _ = _OCR(arr)
        except Exception:
            continue
        n_frames += 1
        for box, text, score in (result or []):
            if score < 0.6 or not text.strip():          # the engine's own confidence floor: a detection setting, not a judgement of the text
                continue
            ys = [p[1] for p in box]
            dets.append({"t": fr["t"], "text": text.strip(), "score": round(float(score), 2),
                         "y_rel": round(sum(ys) / 4 / max(1, height), 3)})
    # Numbers about what was seen, and no label on any of it. Whether a text is a caption, a persistent overlay, a watermark, a product label
    # or noise is for the reader to judge from these numbers and the picture: a row of the frame (a "band") with many different texts over
    # several frames reads like a caption track, a text seen in most scanned frames reads like a fixed overlay.
    bands = {}
    for d in dets:
        bands.setdefault(round(d["y_rel"] / 0.08), []).append(d)
    band_stats = {b: {"y_rel": round(b * 0.08, 2), "detections": len(ds),
                      "distinct_texts": len({re.sub(r"\W+", "", d["text"].lower()) for d in ds}),
                      "frames": len({d["t"] for d in ds})} for b, ds in bands.items()}
    spans = {}
    for d in dets:
        key = re.sub(r"\W+", "", d["text"].lower())
        if len(key) < 2:
            continue
        sp = spans.setdefault(key, {"text": d["text"], "first_t": d["t"], "last_t": d["t"], "hits": 0, "score_sum": 0.0,
                                    "y_rel": d["y_rel"], "band": round(d["y_rel"] / 0.08)})
        sp["first_t"], sp["last_t"] = min(sp["first_t"], d["t"]), max(sp["last_t"], d["t"])
        sp["hits"] += 1
        sp["score_sum"] += d["score"]
    for sp in spans.values():
        tx = sp["text"]
        bs = band_stats[sp["band"]]
        sp["score_mean"] = round(sp.pop("score_sum") / sp["hits"], 2)
        sp["share_of_frames_scanned"] = round(sp["hits"] / n_frames, 2) if n_frames else None
        sp["chars"] = len(re.sub(r"\W+", "", tx))
        sp["words"] = len(tx.split())
        sp["band_distinct_texts"], sp["band_frames"] = bs["distinct_texts"], bs["frames"]
        sp["has_at_handle"] = bool(tx.startswith("@") or re.search(r"@\w{2,}", tx))        # spelling facts of the text itself
        sp["has_hashtag"] = tx.startswith("#")
        sp["has_url_pattern"] = bool(re.search(r"(www\.|https?:|\.com\b|\.co\b|\.io\b)", tx, re.I))
    return {"available": True, "frames_scanned": n_frames, "detections": dets,
            "bands": sorted(band_stats.values(), key=lambda b: b["y_rel"]),
            "spans": sorted(spans.values(), key=lambda s: (s["first_t"], -s["hits"]))}


def loop_similarity(first: str, last: str) -> float | None:
    try:
        from PIL import Image
        import numpy as np
        with Image.open(first) as a, Image.open(last) as b:
            da = np.asarray(a.convert("L").resize((64, 64)), dtype="float32")
            db = np.asarray(b.convert("L").resize((64, 64)), dtype="float32")
            return round(1.0 - float(np.mean(np.abs(da - db))) / 255.0, 3)
    except Exception:
        return None


def second_timeline(dur: float, shots: list, cuts: list, peaks: list, statics: list, aud: dict,
                    trans: dict, ocr: dict) -> list:
    """One row per second: the audio-visual sequence read together."""
    n = max(1, math.ceil(dur))
    rows = [{"sec": s, "shot": None, "events": [], "words": [], "rms_db": None, "text": []} for s in range(n)]
    for s in range(n):
        mid = min(dur - 1e-3, s + 0.5)
        rows[s]["shot"] = next((x["shot"] for x in shots if x["start"] <= mid < x["end"]), shots[-1]["shot"] if shots else 1)
    for ct, _ in cuts:
        rows[min(n - 1, int(ct))]["events"].append(f"CUT {ct:.2f}")
    for p in peaks:
        rows[min(n - 1, int(p["t"]))]["events"].append(f"motion peak {p['t']:.2f}")
    for st in statics:
        for s in range(int(st["start"]), min(n, int(st["end"]) + 1)):
            if "static" not in rows[s]["events"]:
                rows[s]["events"].append("static")
    for sil in aud.get("silences") or []:
        a, b = sil["start"], sil["end"] if sil["end"] is not None else dur
        for s in range(int(a), min(n, int(b) + 1)):
            if "silence" not in rows[s]["events"]:
                rows[s]["events"].append("silence")
    for c in aud.get("rms_per_0.5s") or []:
        s = min(n - 1, int(c["t"]))
        rows[s]["rms_db"] = c["rms_db"] if rows[s]["rms_db"] is None else max(rows[s]["rms_db"], c["rms_db"])
    for seg in trans.get("segments") or []:
        if seg.get("words"):
            for w in seg["words"]:
                rows[min(n - 1, int(w["s"]))]["words"].append(w["w"])
        else:
            rows[min(n - 1, int(seg["start"]))]["words"].append(seg["text"])
    for d in (ocr.get("detections") or []) if ocr.get("available") else []:
        row = rows[min(n - 1, int(d["t"]))]
        if d["text"] not in row["text"]:
            row["text"].append(d["text"])
    return rows


# --------------------------------------------------------------------------- prep-video

def prep_video(video: str, odir: Path, vid: str = "V", base_fps: float = 5.0, dense_fps: float = 10.0,
               static_threshold: float = 2.5, whisper_model: str = "small", language: str = "auto",
               do_transcript: bool = True, do_ocr: bool = True, ocr_budget: int = 12,
               max_frames: int = 1800, hook_s: float = 3.0, vad: bool = True) -> dict:
    t0 = time.time()
    odir.mkdir(parents=True, exist_ok=True)
    for stale in ("frames", "sheets", "_work"):
        shutil.rmtree(odir / stale, ignore_errors=True)
    info = media_summary(video)
    if not info.get("has_video"):
        raise RuntimeError("no video stream")
    dur = info["duration_s"] or 0.0
    fps = info.get("fps") or 24.0
    write_json(odir / "probe.json", info)
    timings = {}

    # structure: scene-change score per native frame -> cuts, shots, pacing, activity
    t = time.time()
    scores = scene_scores(video, odir / "_work")
    cuts = detect_cuts(scores, dur)
    bounds = [0.0] + [c[0] for c in cuts] + [dur]
    shots = [{"shot": i + 1, "start": round(bounds[i], 3), "end": round(bounds[i + 1], 3),
              "dur": round(bounds[i + 1] - bounds[i], 3)} for i in range(len(bounds) - 1)]
    lens = [s["dur"] for s in shots]
    pacing = {"shots": len(shots), "cuts": len(cuts),
              "median_shot_s": round(statistics.median(lens), 2) if lens else None,
              "mean_shot_s": round(statistics.fmean(lens), 2) if lens else None,
              "min_shot_s": round(min(lens), 2) if lens else None,
              "max_shot_s": round(max(lens), 2) if lens else None,
              "cuts_per_10s": round(len(cuts) / dur * 10, 2) if dur else None,
              "first_cut_s": round(cuts[0][0], 2) if cuts else None,
              "cuts_in_first_3s": sum(1 for c in cuts if c[0] <= hook_s)}
    windows = activity_windows(scores, cuts, dur)
    peaks = activity_peaks(windows, k=min(8, max(2, math.ceil(dur / 5))))
    write_json(odir / "cuts.json", {"detector": "ffmpeg select scene score on 192 px frames; cut = score>=0.30 "
                                                "or local peak >=4x neighbourhood median (>=0.14); NMS 0.25 s",
                                    "cuts": [{"t": round(c[0], 3), "score": round(c[1], 3)} for c in cuts],
                                    "shots": shots, "pacing": pacing})
    write_json(odir / "activity.json", {"window_s": 0.5, "windows": windows, "peaks": peaks})
    timings["structure"] = round(time.time() - t, 1)

    # frames: 5 fps baseline, static thinning, adaptive densification
    t = time.time()
    fr_dir = odir / "frames"
    base, eff_fps, fps_note = extract_baseline(video, base_fps, fr_dir / "base", dur, max_frames=max_frames)
    statics = thin_static(base, static_threshold)
    plan = densify_plan(cuts, peaks, dur, fps, eff_fps, dense_fps)
    extra = extract_many(video, [(tt, fr_dir / "extra" / f"x-{ts_name(tt)}.jpg", {"kind": "extra", "tag": tag, "why": why})
                                 for tt, tag, why in plan], max_side=720)
    shot_of = lambda tt: next((s["shot"] for s in shots if s["start"] <= tt < s["end"]), shots[-1]["shot"] if shots else 1)
    frames_all = [f for f in base if f.get("kept")] + [f for f in extra if f["ok"]]
    for f in frames_all:
        f["shot"] = shot_of(f["t"])
        f.setdefault("flags", [])
        if f.get("why") == "peak" or any(abs(f["t"] - p["t"]) <= 0.5 for p in peaks):
            f["flags"].append("peak")
    frames_all.sort(key=lambda f: (f["t"], f["kind"] != "base"))
    for ct, _ in cuts:
        nxt = next((f for f in frames_all if f["t"] >= ct - 1e-3), None)
        if nxt:
            nxt["flags"].append("after_cut")
    story = list(frames_all)
    for st in statics:                                     # static markers sit where the run starts
        story.append({"kind": "static", "start": st["start"], "end": st["end"], "dropped": st["dropped"],
                      "t": st["start"] - 1e-4})
    story.sort(key=lambda f: f["t"])
    timings["frames"] = round(time.time() - t, 1)

    t = time.time()
    orient = info.get("orientation", "portrait")
    sheets = build_storyboard(story, odir / "sheets" / "storyboard", f"{vid} storyboard", orient)
    timings["sheets"] = round(time.time() - t, 1)

    # audio and speech, aligned to the same clock
    t = time.time()
    aud = audio_analysis(video, info, odir / "audio")
    write_json(odir / "audio.json", aud)
    trans = {"engine": None, "has_speech": False, "segments": [], "skipped": not do_transcript}
    if do_transcript and aud.get("wav_16k"):
        trans = transcribe(aud["wav_16k"], odir / "audio", whisper_model, language, vad)
    write_json(odir / "transcript.json", trans)
    txt = [f"[{ts_label(s['start'])}-{ts_label(s['end'])}] {s['text']}" for s in trans.get("segments", [])]
    write_text(odir / "transcript.txt", "\n".join(txt) if txt else "No speech detected.")
    timings["audio"] = round(time.time() - t, 1)

    # on-screen text sample (feeds the no-visible-text rule and the source-artifact exclusion list)
    t = time.time()
    ocr = {"available": False, "skipped": not do_ocr}
    kept_base = [f for f in base if f.get("kept")]
    if do_ocr and ocr_budget > 0 and kept_base:
        step = max(1, math.ceil(len(kept_base) / ocr_budget))
        sample = kept_base[::step][:ocr_budget - 1] + kept_base[-1:]
        ocr = ocr_frames(sample)
    write_json(odir / "ocr.json", ocr)
    timings["ocr"] = round(time.time() - t, 1)

    loop = loop_similarity(base[0]["file"], base[-1]["file"]) if len(base) > 1 else None
    rows = second_timeline(dur, shots, cuts, peaks, statics, aud, trans, ocr)
    write_json(odir / "frames.json", {"baseline_fps": eff_fps, "baseline_note": fps_note,
                                      "static_threshold": static_threshold, "dense_fps": dense_fps,
                                      "static_runs": statics, "extra_frames": len([f for f in extra if f['ok']]),
                                      "frames": [{k: f.get(k) for k in ("t", "file", "kind", "shot", "flags", "why",
                                                                        "diff_prev_kept")} for f in frames_all]})
    first_word = None
    for s in trans.get("segments", []):
        first_word = s["words"][0]["s"] if s.get("words") else s["start"]
        break
    base_kept = len(kept_base)
    summary = {"id": vid, "video": video, "probe": info, "pacing": pacing, "peaks": peaks,
               "sampling": {"baseline_fps": round(eff_fps, 3), "baseline_frames": len(base),
                            "kept_after_static_thinning": base_kept,
                            "static_runs": len(statics), "extra_frames": len([f for f in extra if f["ok"]]),
                            "storyboard_cells": sum(s["cells"] for s in sheets), "note": fps_note},
               "hook": {"first_cut_s": pacing["first_cut_s"], "cuts_in_first_3s": pacing["cuts_in_first_3s"],
                        "speech_starts_s": first_word,
                        "mean_change_first_1s": round(statistics.fmean([w["mean_change"] for w in windows[:2]]), 4) if windows else None},
               "audio": {k: aud.get(k) for k in ("has_audio", "integrated_lufs", "lra_lu", "true_peak_dbfs", "note")},
               "speech": {k: trans.get(k) for k in ("engine", "model", "language", "has_speech", "n_words",
                                                    "speech_seconds", "wpm_speech_only")},
               "loop_similarity_first_last": loop,
               "ocr_spans": (ocr.get("spans") or [])[:40] if ocr.get("available") else None,
               "sheets": sheets, "timings_s": timings, "elapsed_s": round(time.time() - t0, 1)}
    write_json(odir / "video.json", summary)

    # human-readable companions
    T = [f"# {vid} — per-second timeline (sheets + this table = one continuous sequence)", "",
         "| sec | shot | events | speech in this second | audio max dB | on-screen text (OCR sample) |",
         "|---|---|---|---|---|---|"]
    for r in rows:
        T.append(f"| {r['sec']:>3} | S{r['shot']:02d} | {'; '.join(r['events'])} | {' '.join(r['words'])} | "
                 f"{'' if r['rms_db'] is None else r['rms_db']} | {' / '.join(r['text'])[:120]} |")
    write_text(odir / "timeline.md", "\n".join(T))

    L = [f"# {vid} — {Path(video).name}", "",
         f"- **Specs**: {dur:.2f} s · {info.get('display_width')}x{info.get('display_height')} ({info.get('aspect')}, "
         f"{orient}) · {fps} fps · audio {'yes' if info.get('has_audio') else 'no'}",
         f"- **Sampling**: baseline {eff_fps:g} fps ({len(base)} frames) → {base_kept} kept after static thinning "
         f"({len(statics)} static run(s)) + {summary['sampling']['extra_frames']} densified frames "
         f"(cuts, motion peaks, first second) = {summary['sampling']['storyboard_cells']} storyboard cells"
         + (f" — NOTE: {fps_note}" if fps_note else ""),
         f"- **Pacing** (measured): {pacing['shots']} shots, {pacing['cuts']} cuts, median shot {pacing['median_shot_s']} s, "
         f"{pacing['cuts_per_10s']} cuts/10 s, first cut at {pacing['first_cut_s']} s, {pacing['cuts_in_first_3s']} cut(s) in the first 3 s",
         f"- **Speech**: {trans.get('n_words', 0)} words via {trans.get('engine')} ({trans.get('language')}); "
         f"speech starts at {first_word} s; {trans.get('wpm_speech_only')} wpm (speech-only)",
         f"- **Audio**: {aud.get('integrated_lufs')} LUFS integrated, LRA {aud.get('lra_lu')}, "
         f"{len(aud.get('silences') or [])} silence span(s) ≥0.4 s{(' — ' + aud['note']) if aud.get('note') else ''}",
         f"- **Loop similarity** (first vs last frame, 0–1): {loop}",
         f"- **Motion peaks** (non-cut visual change): " + (", ".join(f"{p['t']}s (z {p['z']})" for p in peaks) or "none"),
         f"- **Static runs thinned**: " + (", ".join(f"{s['start']:.2f}–{s['end']:.2f}s ({s['dropped']})" for s in statics) or "none"),
         "", "## Storyboard sheets (read in order, with timeline.md open)", ""]
    L += [f"- `{s['sheet']}` — {ts_label(s['start'])}–{ts_label(s['end'])} ({s['cells']} cells)" for s in sheets]
    L += ["", "## Shots (heuristic cut detector — confirm on the storyboard)", "",
          "| shot | start | end | dur |", "|---|---|---|---|"]
    L += [f"| S{s['shot']:02d} | {s['start']:.2f} | {s['end']:.2f} | {s['dur']:.2f} |" for s in shots[:120]]
    L += ["", "## Transcript (machine ASR — evidence to verify, not verbatim truth)", ""]
    L += txt[:150] or ["No speech detected."]
    if ocr.get("available"):
        L += ["", f"## On-screen text sample (OCR on {ocr.get('frames_scanned')} frames)", ""]
        for sp in (ocr.get("spans") or [])[:40]:
            L.append(f"- {ts_label(sp['first_t'])}–{ts_label(sp['last_t'])} · seen in {sp['hits']} of {ocr.get('frames_scanned')} scanned frame(s) · "
                     f"row y {sp['y_rel']} ({sp['band_distinct_texts']} different text(s) in that row) · \"{sp['text']}\"")
        if not ocr.get("spans"):
            L.append("- none detected")
    L += ["", f"Machine data in `{odir}`: video.json, frames.json, cuts.json, activity.json, audio.json, "
              f"transcript.json, ocr.json, timeline.md · densify on demand: "
              f"`atg.py frames \"{video}\" --out <dir> --range a-b --fps 15 --sheet` · elapsed {summary['elapsed_s']} s"]
    write_text(odir / "video.md", "\n".join(L))
    shutil.rmtree(odir / "_work", ignore_errors=True)
    return summary


def _media_kwargs(a) -> dict:
    return dict(base_fps=a.fps, dense_fps=a.dense_fps, static_threshold=a.static_threshold,
                whisper_model=a.whisper_model, language=a.language, do_transcript=not a.no_transcript,
                do_ocr=not a.no_ocr, ocr_budget=a.ocr_frames, max_frames=a.max_frames, vad=not a.no_vad)


def cmd_prep_video(a):
    try:
        s = prep_video(a.video, Path(a.out), a.id or "V", **_media_kwargs(a))
    except Exception as e:
        fail(f"{type(e).__name__}: {e}")
    out({"ok": True, "summary_md": str(Path(a.out) / "video.md"), "timeline_md": str(Path(a.out) / "timeline.md"),
         "sheets": s["sheets"], "sampling": s["sampling"], "elapsed_s": s["elapsed_s"]})


# --------------------------------------------------------------------------- other media

def prep_image(path: str, dest: Path, max_side: int = 1280) -> dict:
    from PIL import Image, ImageOps
    dest.parent.mkdir(parents=True, exist_ok=True)
    with Image.open(path) as im:
        im = ImageOps.exif_transpose(im)
        info = {"path": path, "width": im.width, "height": im.height, "mode": im.mode,
                "aspect": nearest_aspect(im.width, im.height),
                "has_alpha": im.mode in ("RGBA", "LA") or (im.mode == "P" and "transparency" in im.info)}
        prev = im.convert("RGB")
        prev.thumbnail((max_side, max_side))
        prev.save(dest, quality=88)
    info["preview"] = str(dest)
    return info


def cmd_prep_image(a):
    try:
        out({"ok": True, **prep_image(a.image, Path(a.out), a.max_side)})
    except Exception as e:
        fail(str(e))


def _xml_text(data: bytes, para_tag: str, text_tag: str) -> str:
    s = data.decode("utf-8", errors="replace")
    lines = []
    for p in re.split(rf"</{para_tag}>", s):
        texts = re.findall(rf"<{text_tag}(?:\s[^>]*)?>(.*?)</{text_tag}>", p, re.S)
        line = html.unescape("".join(texts)).strip()
        if line:
            lines.append(line)
    return "\n".join(lines)


def doc_text(path: str) -> str:
    p = Path(path)
    ext = p.suffix.lower()
    if ext in (".html", ".htm", ".xml"):
        raw = p.read_text(encoding="utf-8", errors="replace")
        raw = re.sub(r"(?is)<(script|style).*?</\1>", " ", raw)
        return html.unescape(re.sub(r"<[^>]+>", " ", raw))
    if ext in TEXT_EXT:
        return p.read_text(encoding="utf-8", errors="replace")
    if ext == ".docx":
        with zipfile.ZipFile(p) as z:
            parts = [n for n in z.namelist() if re.match(r"word/(document|header\d*|footer\d*|footnotes)\.xml$", n)]
            return "\n\n".join(_xml_text(z.read(n), "w:p", "w:t") for n in sorted(parts))
    if ext == ".pptx":
        with zipfile.ZipFile(p) as z:
            slides = sorted((n for n in z.namelist() if re.match(r"ppt/slides/slide\d+\.xml$", n)),
                            key=lambda n: int(re.findall(r"\d+", n)[-1]))
            notes = {int(re.findall(r"\d+", n)[-1]): n for n in z.namelist()
                     if re.match(r"ppt/notesSlides/notesSlide\d+\.xml$", n)}
            outp = []
            for n in slides:
                k = int(re.findall(r"\d+", n)[-1])
                outp.append(f"--- slide {k} ---\n" + _xml_text(z.read(n), "a:p", "a:t"))
                if k in notes:
                    outp.append("[notes] " + _xml_text(z.read(notes[k]), "a:p", "a:t"))
            return "\n".join(outp)
    if ext == ".xlsx":
        with zipfile.ZipFile(p) as z:
            shared = []
            if "xl/sharedStrings.xml" in z.namelist():
                s = z.read("xl/sharedStrings.xml").decode("utf-8", errors="replace")
                for si in re.findall(r"<si>(.*?)</si>", s, re.S):
                    shared.append(html.unescape("".join(re.findall(r"<t[^>]*>(.*?)</t>", si, re.S))))
            outp = []
            sheets = sorted((n for n in z.namelist() if re.match(r"xl/worksheets/sheet\d+\.xml$", n)),
                            key=lambda n: int(re.findall(r"\d+", n)[-1]))
            for n in sheets:
                outp.append(f"--- {Path(n).stem} ---")
                s = z.read(n).decode("utf-8", errors="replace")
                for row in re.findall(r"<row[^>]*>(.*?)</row>", s, re.S):
                    vals = []
                    for attrs, body in re.findall(r"<c ([^>]*)>(.*?)</c>", row, re.S):
                        v = re.search(r"<v>(.*?)</v>", body, re.S)
                        tt = re.search(r't="(\w+)"', attrs)
                        if tt and tt.group(1) == "s" and v:
                            idx = int(v.group(1))
                            vals.append(shared[idx] if idx < len(shared) else "")
                        elif tt and tt.group(1) == "inlineStr":
                            vals.append(html.unescape("".join(re.findall(r"<t[^>]*>(.*?)</t>", body, re.S))))
                        else:
                            vals.append(html.unescape(v.group(1)) if v else "")
                    if any(x.strip() for x in vals):
                        outp.append("\t".join(vals))
            return "\n".join(outp)
    if ext == ".pdf":
        return "[PDF — read it directly with the Read tool (pages parameter for long files).]"
    return "[unsupported format for text extraction]"


def cmd_doc_text(a):
    try:
        text = doc_text(a.file)
    except Exception as e:
        fail(str(e))
    if a.out:
        write_text(Path(a.out), text)
    out({"ok": True, "chars": len(text), "out": a.out, **({} if a.out else {"text": text[:20000]})})


# --------------------------------------------------------------------------- run management

def cmd_new_run(a):
    root = Path(a.runs_root or cfg_get("runs_root") or (ATG_HOME / "runs")).expanduser()
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    sources = [str(Path(s).expanduser().resolve()) for s in (a.source or [])]
    assets = [str(Path(s).expanduser().resolve()) for s in (a.assets or [])]
    examples = [str(Path(s).expanduser().resolve()) for s in (a.examples or [])]
    baseline = [str(Path(s).expanduser().resolve()) for s in (getattr(a, "baseline", None) or [])]
    missing = [p for p in sources + assets + examples + baseline if not Path(p).exists()]
    if missing:
        fail("path(s) not found: " + "; ".join(missing), 2)
    slug = slugify(a.slug or (Path(sources[0]).stem if sources else a.mode))
    run_dir = root / f"{stamp}-{slug}"
    submode = getattr(a, "submode", None)
    subs = ["00-inventory", "10-media", "20-analysis", "30-assets", "40-briefs", "50-requests", "60-outputs", "logs"]
    if submode == "viral-browser":          # nothing is generated: research and the deliverables replace requests and outputs
        subs += ["30-research", "deliverables"]
    for sub in subs:
        (run_dir / sub).mkdir(parents=True, exist_ok=True)
    state = {"run_id": run_dir.name, "mode": a.mode,
             "source": sources[0] if len(sources) == 1 else sources,   # references folder (analyze) / videos (edit)
             "assets_paths": assets,        # user-supplied client assets (analyze: whole project, given up front)
             "examples_paths": examples,    # optional: the user's own finished videos (study only, never inputs)
             "baseline_paths": baseline,    # optional, Viral-Browser: videos that did NOT spread (contrast set)
             "analyze_submode": submode,    # recreate | create | viral-browser (None until chosen)
             "created": now_iso(), "updated": now_iso(), "stage": "created", "next_step": "inventory",
             "model": None, "requested_videos": None, "directions": [], "assets": {}, "videos": [], "notes": []}
    write_json(run_dir / "state.json", state)
    out({"ok": True, "run_dir": str(run_dir), "state": str(run_dir / "state.json"),
         "sources": sources, "assets_paths": assets, "examples_paths": examples, "baseline_paths": baseline,
         "analyze_submode": submode})


def _set_dotted(d: dict, key: str, value):
    parts = key.split(".")
    for p in parts[:-1]:
        d = d.setdefault(p, {})
    d[parts[-1]] = value


def _get_dotted(d, key: str):
    for p in key.split("."):
        if isinstance(d, dict) and p in d:
            d = d[p]
        elif isinstance(d, list) and p.isdigit() and int(p) < len(d):
            d = d[int(p)]
        else:
            return None
    return d


class FileLock:
    """Cross-process lock (O_EXCL lock file). Production agents run in parallel (one per video), so every
    read-modify-write of a shared file (state.json, CapCut's store index) holds one of these."""

    def __init__(self, path, timeout: float = 120.0, stale: float = 600.0):
        self.path, self.timeout, self.stale, self.fd = Path(path), timeout, stale, None

    def __enter__(self):
        import time
        t0 = time.time()
        while True:
            try:
                self.fd = os.open(self.path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
                os.write(self.fd, f"{os.getpid()} {now_iso()}".encode())
                return self
            except (FileExistsError, PermissionError):      # PermissionError: Windows, while the other process is deleting its lock file
                try:
                    if time.time() - self.path.stat().st_mtime > self.stale:
                        self.path.unlink()          # left behind by a killed process
                        continue
                except FileNotFoundError:
                    continue
                except PermissionError:
                    pass
                if time.time() - t0 > self.timeout:
                    fail(f"lock busy: {self.path} (another agent is writing; retry)", 4)
                time.sleep(0.1)

    def __exit__(self, *exc):
        try:
            os.close(self.fd)
        finally:
            try:
                self.path.unlink()
            except FileNotFoundError:
                pass


def cmd_state(a):
    p = Path(a.run) / "state.json"
    if not p.exists():
        fail(f"state.json not found in {a.run}", 2)
    if a.action == "get":
        st = json.loads(p.read_text(encoding="utf-8"))
        out({"ok": True, "value": _get_dotted(st, a.pairs[0]) if a.pairs else st})
    with FileLock(p.with_name("state.json.lock")):
        st = json.loads(p.read_text(encoding="utf-8"))
        for pair in a.pairs:
            if "=" not in pair:
                fail(f"expected key=value, got {pair!r}", 2)
            k, v = pair.split("=", 1)
            try:
                val = json.loads(v)
            except Exception:
                val = v
            if a.action == "append":
                cur = _get_dotted(st, k)
                if not isinstance(cur, list):
                    cur = []
                    _set_dotted(st, k, cur)
                cur.append(val)
            else:
                _set_dotted(st, k, val)
        st["updated"] = now_iso()
        write_json(p, st)
    out({"ok": True, "updated": [x.split("=", 1)[0] for x in a.pairs]})


def _collect_files(paths: list, run_dir, max_depth) -> list:
    """(file, base) for every file under the given files/folders, in stable order, no duplicates."""
    found, seen = [], set()
    for raw in paths:
        p = Path(raw).expanduser().resolve()
        if not p.exists():
            raise FileNotFoundError(f"not found: {p}")
        if p.is_file():
            if p not in seen:
                seen.add(p)
                found.append((p, p.parent))
            continue
        base_depth = len(p.parts)
        for root, dirs, fnames in os.walk(p):
            rp = Path(root)
            dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS and not d.startswith(".")
                             and not (rp / d / FINAL_MARKER).exists()          # our own final/ folder
                             and not (rp / d / LEGACY_FINAL_MARKER).exists()
                             and not (run_dir and (rp / d).resolve() == run_dir))
            if max_depth is not None and len(rp.parts) - base_depth >= max_depth:
                dirs[:] = []
            for fn in sorted(fnames):
                if fn.startswith(".") or fn.lower() in ("thumbs.db", "desktop.ini"):
                    continue
                f = rp / fn
                if f not in seen:
                    seen.add(f)
                    found.append((f, p))
    return found


def _mark_final_dir(d: Path) -> None:
    marker = d / FINAL_MARKER
    if not marker.exists():
        marker.write_text("Created by /analyze-then-generate: approved results. This folder is skipped when the "
                          "parent folder is scanned again.\n", encoding="utf-8")
        if sys.platform.startswith("win"):
            try:
                import ctypes
                ctypes.windll.kernel32.SetFileAttributesW(str(marker), 0x02)   # FILE_ATTRIBUTE_HIDDEN
            except Exception:
                pass


def cmd_inventory(a):
    """--as references : Analyze Mode reference material (everything is REFERENCE material, never a client asset)
       --as sources    : Edit Mode — only videos are edit sources; every other file is ignored
       --as assets     : user-supplied client assets (the ONLY source of client assets), per --scope
       --as examples   : the user's own finished videos: how THEY place, use, continue and blend their products.
                         Study material only (never uploaded, recreated, cut in or used as assets). May be empty.
       --as baseline   : Viral-Browser only: videos that did NOT spread (same niche). A contrast set that tells what
                         viral videos share from what all videos share. Never ideas, never inputs. May be empty."""
    run_dir = Path(a.run).resolve() if a.run else None
    try:
        files = _collect_files(a.paths, run_dir, a.max_depth)
    except FileNotFoundError as e:
        fail(str(e), 2)
    role = a.role
    if role in ("assets", "examples", "baseline"):
        letter = {"assets": "A", "examples": "E", "baseline": "B"}[role]
        prefix = {k: letter for k in ("video", "image", "audio", "pdf", "office", "text", "font", "vector", "other")}
    else:
        prefix = {"video": "V", "image": "I", "audio": "S", "pdf": "D", "office": "D", "text": "D",
                  "font": "F", "vector": "G", "other": "X"}
    seq = {k: 0 for k in set(prefix.values())}
    items, seen = [], {}
    multi_base = len({str(b) for _, b in files}) > 1
    for f, base in files:
        kind = classify(f)
        if role == "sources" and kind != "video":
            items.append({"id": "-", "kind": kind, "path": str(f), "rel": f.name, "ignored": True,
                          "reason": "Edit Mode processes only videos; name this file explicitly if it is an asset"})
            continue
        pre = prefix[kind]
        seq[pre] += 1
        rel = str(f.relative_to(base))
        if multi_base:
            rel = str(Path(base.name) / rel)
        item = {"id": f"{pre}{seq[pre]:02d}", "kind": kind, "path": str(f), "rel": rel,
                "ext": f.suffix.lower(), "size_bytes": f.stat().st_size,
                "folder": str(Path(rel).parent) if str(Path(rel).parent) != "." else "."}
        if role == "assets":
            item["group"] = item["folder"]           # sub-folders usually separate products / characters / sets; what a file is, is confirmed by viewing it
        try:
            item["hash"] = quick_hash(f)
            if item["hash"] in seen:
                item["duplicate_of"] = seen[item["hash"]]
            else:
                seen[item["hash"]] = item["id"]
        except Exception:
            pass
        if kind in ("video", "audio"):
            try:
                s = media_summary(f)
                item.update({k: s.get(k) for k in ("duration_s", "display_width", "display_height", "fps",
                                                   "aspect", "orientation", "has_audio", "codec")})
            except Exception as e:
                item["probe_error"] = str(e)[:200]
        elif kind == "image":
            try:
                from PIL import Image, ImageOps
                with Image.open(f) as im:
                    im = ImageOps.exif_transpose(im)
                    item.update({"display_width": im.width, "display_height": im.height,
                                 "aspect": nearest_aspect(im.width, im.height), "mode": im.mode})
            except Exception as e:
                item["probe_error"] = str(e)[:200]
        items.append(item)
    used = [it for it in items if not it.get("ignored")]
    by_kind = {}
    for it in used:
        by_kind.setdefault(it["kind"], []).append(it)
    titles = {"references": "Reference material (analysis only — never client assets)",
              "sources": "Edit sources (videos only)",
              "assets": f"User-supplied client assets — scope '{a.scope or 'project'}'",
              "examples": "Examples: your own finished videos (study only — never generation inputs, never client assets)",
              "baseline": "Baseline: videos that did NOT spread (contrast set only — never ideas, never inputs)"}
    inv = {"role": role, "scope": a.scope or ("project" if role == "assets" else None),
           "inputs": [str(Path(p).expanduser().resolve()) for p in a.paths], "created": now_iso(),
           "counts": {k: len(v) for k, v in by_kind.items()},
           "total_video_seconds": round(sum(i.get("duration_s") or 0 for i in by_kind.get("video", [])), 1),
           "items": items}
    lines = [f"# {titles[role]}", "", "Inputs: " + "; ".join(f"`{p}`" for p in inv["inputs"]), "",
             f"Created {inv['created']}. Counts: " + ", ".join(f"{k} {v}" for k, v in sorted(inv["counts"].items())) +
             f". Total video: {inv['total_video_seconds']} s.", ""]
    for kind in ("video", "image", "audio", "pdf", "office", "text", "font", "vector", "other"):
        rows = by_kind.get(kind, [])
        if not rows:
            continue
        extra_col = " group |" if role == "assets" else ""
        lines += [f"## {kind} ({len(rows)})", "", "| id | file | details |" + extra_col,
                  "|---|---|---|" + ("---|" if role == "assets" else "")]
        for it in rows:
            if kind == "video":
                det = (f"{it.get('duration_s')} s, {it.get('display_width')}x{it.get('display_height')} "
                       f"({it.get('aspect')}), {it.get('fps')} fps, audio {'yes' if it.get('has_audio') else 'no'}")
            elif kind == "image":
                det = f"{it.get('display_width')}x{it.get('display_height')} ({it.get('aspect')})"
            elif kind == "audio":
                det = f"{it.get('duration_s')} s"
            else:
                det = f"{round(it['size_bytes'] / 1024, 1)} KB"
            if it.get("duplicate_of"):
                det += f" — duplicate of {it['duplicate_of']}"
            if it.get("probe_error"):
                det += f" — PROBE ERROR: {it['probe_error'][:80]}"
            row = f"| {it['id']} | `{it['rel']}` | {det} |"
            if role == "assets":
                row += f" {it.get('group')} |"
            lines.append(row)
        lines.append("")
    ignored = [it for it in items if it.get("ignored")]
    if ignored:
        lines += [f"## ignored ({len(ignored)})", ""] + [f"- `{it['path']}` ({it['kind']}): {it['reason']}" for it in ignored]
    if run_dir:
        if role == "assets":
            dest = run_dir / "30-assets" / (a.scope or "project")
            jp, mp = dest / "asset-inventory.json", dest / "asset-inventory.md"
        elif role in ("examples", "baseline"):
            jp, mp = run_dir / "00-inventory" / f"{role}-inventory.json", run_dir / "00-inventory" / f"{role}-inventory.md"
        else:
            jp, mp = run_dir / "00-inventory" / "inventory.json", run_dir / "00-inventory" / "inventory.md"
        write_json(jp, inv)
        write_text(mp, "\n".join(lines))
    else:
        jp = mp = None
    out({"ok": True, "role": role, "counts": inv["counts"], "ignored": len(ignored),
         "total_video_seconds": inv["total_video_seconds"],
         "inventory_json": str(jp) if jp else None, "inventory_md": str(mp) if mp else None,
         **({} if run_dir else {"items": items})})


def cmd_prep_assets(a):
    """Previews, document text, font names and ONE labelled contact sheet of the user-supplied assets of
    a scope, so the command can see and classify exactly what the user provided (nothing else)."""
    run_dir = Path(a.run)
    scope = a.scope or "project"
    adir = run_dir / "30-assets" / scope
    inv_p = adir / "asset-inventory.json"
    if not inv_p.exists():
        fail(f"run `inventory --as assets --scope {scope}` first", 2)
    inv = json.loads(inv_p.read_text(encoding="utf-8"))
    sheet_items, lines, errors = [], [f"# Asset previews — scope '{scope}'", ""], []
    for it in inv["items"]:
        if it.get("ignored"):
            continue
        aid, kind, name = it["id"], it["kind"], it["rel"].replace("\\", "/")
        if it.get("duplicate_of"):
            lines.append(f"- {aid} `{name}` — duplicate of {it['duplicate_of']} (skipped)")
            continue
        try:
            if kind == "image":
                info = prep_image(it["path"], adir / "previews" / f"{aid}.jpg")
                sheet_items.append({"t": 0.0, "file": info["preview"], "ok": True, "kind": "base",
                                    "label": f"{aid} {name}"})
                lines.append(f"- {aid} image `{name}` {info['width']}x{info['height']}"
                             f"{' (alpha)' if info['has_alpha'] else ''} → `{info['preview']}`")
            elif kind == "video":
                s = media_summary(it["path"])
                d = s.get("duration_s") or 0
                marks = [0.0, d / 2, max(0.0, d - 0.2)]
                fr = extract_many(it["path"], [(t, adir / "previews" / f"{aid}-{ts_name(t)}.jpg",
                                                {"kind": "base", "label": f"{aid} {name} @{t:.1f}s"}) for t in marks], 720)
                sheet_items += [f for f in fr if f["ok"]]
                lines.append(f"- {aid} video `{name}` {d} s {s.get('display_width')}x{s.get('display_height')} "
                             f"(first/middle/last frames on the sheet; densify with `frames` if needed)")
            elif kind in ("text", "office"):
                dest = adir / "docs" / f"{aid}.txt"
                write_text(dest, doc_text(it["path"]))
                lines.append(f"- {aid} document `{name}` → `{dest}`")
            elif kind == "pdf":
                lines.append(f"- {aid} PDF `{name}` → read directly with the Read tool")
            elif kind == "font":
                fam = None
                try:
                    from PIL import ImageFont
                    fam = " ".join(ImageFont.truetype(it["path"], 20).getname())
                except Exception:
                    pass
                lines.append(f"- {aid} font `{name}` family: {fam or 'unknown'} → usable in captions as "
                             f"`\"font_file\": \"{it['path']}\"`")
            elif kind == "vector":
                lines.append(f"- {aid} vector `{name}` (not previewable here; ask for a PNG export if it must be "
                             f"shown to a model, or use it for post overlays)")
            elif kind == "audio":
                s = media_summary(it["path"])
                lines.append(f"- {aid} audio `{name}` {s.get('duration_s')} s (voice/music/sound reference)")
            else:
                lines.append(f"- {aid} other `{name}` — not processed")
        except Exception as e:
            errors.append({"id": aid, "error": str(e)[:200]})
            lines.append(f"- {aid} `{name}` ERROR: {str(e)[:160]}")
    sheets = build_storyboard(sheet_items, adir / "assets-sheet", f"Assets '{scope}'", "square", dense=False,
                              legend="user-supplied assets only | label = asset id + path", show_times=False)
    lines += ["", "## Contact sheets", ""] + [f"- `{s['sheet']}` ({s['cells']} cells)" for s in sheets]
    write_text(adir / "asset-previews.md", "\n".join(lines))
    out({"ok": not errors, "scope": scope, "sheets": sheets, "summary": str(adir / "asset-previews.md"),
         "errors": errors}, 0 if not errors else 1)


def cmd_prep_all(a):
    run_dir = Path(a.run)
    examples = a.inv_set in ("examples", "baseline")        # the side sets: own inventory file, own index
    inv_p = run_dir / "00-inventory" / (f"{a.inv_set}-inventory.json" if examples else "inventory.json")
    if not inv_p.exists():
        fail("run inventory first" + (f" --as {a.inv_set}" if examples else ""), 2)
    inv = json.loads(inv_p.read_text(encoding="utf-8"))
    only = set(x.strip() for x in a.only.split(",")) if a.only else None
    media = run_dir / "10-media"
    kw = _media_kwargs(a)
    lines, errors, done = {}, [], []

    def do_item(it):
        if it.get("duplicate_of"):
            return f"- {it['id']} skipped (duplicate of {it['duplicate_of']})"
        if it["kind"] == "video":
            d = media / it["id"]
            if (d / "video.json").exists() and not a.redo:
                return f"- {it['id']} video — already prepared: `{d / 'video.md'}`"
            s = prep_video(it["path"], d, it["id"], **kw)
            done.append(it["id"])
            sm = s["sampling"]
            return (f"- {it['id']} video `{it['rel']}` ({(s['probe'] or {}).get('duration_s')} s long) → `{d / 'video.md'}` · {len(s['sheets'])} storyboard sheet(s), "
                    f"{sm['storyboard_cells']} cells ({sm['baseline_fps']} fps baseline) · prepared in {s['elapsed_s']} s")
        if it["kind"] == "image" and not a.skip_images:
            info = prep_image(it["path"], media / "images" / f"{it['id']}.jpg")
            done.append(it["id"])
            return (f"- {it['id']} image `{it['rel']}` → preview `{info['preview']}` "
                    f"({info['width']}x{info['height']}{', alpha' if info['has_alpha'] else ''})")
        if it["kind"] in ("text", "office"):
            dest = media / "docs" / f"{it['id']}.txt"
            write_text(dest, doc_text(it["path"]))
            done.append(it["id"])
            return f"- {it['id']} document `{it['rel']}` → text `{dest}`"
        if it["kind"] == "pdf":
            return f"- {it['id']} PDF `{it['rel']}` → read directly with the Read tool"
        if it["kind"] == "audio":
            return f"- {it['id']} audio `{it['rel']}` ({it.get('duration_s')} s) → transcribe on demand"
        return f"- {it['id']} {it['kind']} `{it['rel']}` → not processed ({a.inv_set[:-1] if examples else 'reference material'})"

    todo = [it for it in inv["items"] if not it.get("ignored") and (not only or it["id"] in only)]
    with cf.ThreadPoolExecutor(max_workers=max(1, a.jobs)) as ex:
        futs = {ex.submit(do_item, it): it for it in todo}
        for fut in cf.as_completed(futs):
            it = futs[fut]
            try:
                lines[it["id"]] = fut.result()
            except Exception as e:
                errors.append({"id": it["id"], "error": f"{type(e).__name__}: {str(e)[:300]}"})
                lines[it["id"]] = f"- {it['id']} ERROR: {str(e)[:160]}"
    order = [it["id"] for it in todo]
    index = media / (f"{a.inv_set}-index.md" if examples else "index.md")
    write_text(index, (f"# {a.inv_set.capitalize()} index (study only)" if examples else "# Media index") + "\n\n" +
               "\n".join(lines[i] for i in order if i in lines))
    out({"ok": not errors, "set": a.inv_set, "prepared": sorted(done), "errors": errors, "index": str(index)},
        0 if not errors else 1)


# --------------------------------------------------------------------------- targeted frames

def _parse_times(s: str) -> list:
    return [float(x) for x in re.split(r"[,\s]+", s.strip()) if x]


def cmd_frames(a):
    info = media_summary(a.video)
    dur = info.get("duration_s") or 0
    tmax = max(0.0, dur - 1.5 / (info.get("fps") or 24))
    ts = []
    if a.at:
        ts += _parse_times(a.at)
    for rg in a.range or []:
        m = re.match(r"^\s*([0-9.]+)\s*-\s*([0-9.]+)\s*$", rg)
        if not m:
            fail(f"bad --range {rg!r}; use start-end in seconds", 2)
        st, en = float(m.group(1)), float(m.group(2))
        k = 0
        while st + k / a.fps <= en + 1e-6:
            ts.append(st + k / a.fps)
            k += 1
    if not ts:
        fail("give --at and/or --range", 2)
    ts = sorted(set(round(min(tmax, max(0.0, x)), 3) for x in ts))
    od = Path(a.out)
    pre = a.label or "f"
    res = extract_many(a.video, [(t, od / f"{pre}-{ts_name(t)}.jpg", {"kind": "extra"}) for t in ts], a.max_side)
    sheets = []
    if a.sheet:
        sheets = build_storyboard(res, od / f"sheet-{pre}", a.title or f"{Path(a.video).name} {pre}",
                                  info.get("orientation", "portrait"), dense=len(res) > 12)
    out({"ok": all(r["ok"] for r in res), "frames": [{"t": r["t"], "file": r["file"], "ok": r["ok"]} for r in res],
         "sheets": sheets})


# --------------------------------------------------------------------------- Higgsfield transfer helpers

def cmd_hf_put(a):
    p = Path(a.file)
    if not p.exists():
        fail(f"file not found: {p}", 2)
    ct = a.content_type or CONTENT_TYPES.get(p.suffix.lower(), "application/octet-stream")
    last = None
    for attempt in range(a.retries):
        try:
            import requests  # type: ignore
            with open(p, "rb") as f:
                r = requests.put(a.url, data=f, headers={"Content-Type": ct}, timeout=a.timeout)
            if r.status_code == 200:
                out({"ok": True, "status": 200, "bytes": p.stat().st_size, "content_type": ct,
                     "etag": r.headers.get("ETag")})
            last = f"HTTP {r.status_code}: {r.text[:300]}"
            if r.status_code in (400, 403):
                break  # signature / content-type mismatch or expired slot: request a fresh media_upload slot
        except Exception as e:
            last = str(e)[:300]
        time.sleep(2 ** attempt)
    fail(f"upload failed: {last}", 1, content_type=ct)


def _download(url: str, dest: Path, retries: int, headers=None) -> int:
    """Stream a public URL to dest (via .part, verified length). Returns the byte count; raises after the
    last retry. Refuses HTML pages: the URL must point at the media file itself."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    part = dest.with_suffix(dest.suffix + ".part")
    last = None
    for attempt in range(retries):
        try:
            import requests  # type: ignore
            with requests.get(url, stream=True, timeout=(15, 180), headers=headers or {}) as r:
                r.raise_for_status()
                if "text/html" in r.headers.get("Content-Type", ""):
                    raise IOError("got an HTML page instead of media")
                expected = int(r.headers.get("Content-Length", 0) or 0)
                n = 0
                with open(part, "wb") as f:
                    for chunk in r.iter_content(1 << 20):
                        f.write(chunk)
                        n += len(chunk)
            if expected and n != expected:
                raise IOError(f"short read {n}/{expected}")
            os.replace(part, dest)
            return n
        except Exception as e:
            last = str(e)[:300]
            time.sleep(2 ** attempt)
    raise IOError(f"download failed: {last}")


def cmd_hf_get(a):
    dest = Path(a.out)
    try:
        n = _download(a.url, dest, a.retries)
        s = media_summary(dest)
        if not s.get("has_video") and dest.suffix.lower() in VIDEO_EXT:
            raise IOError("downloaded file has no video stream")
    except Exception as e:
        fail(str(e)[:300])
    out({"ok": True, "file": str(dest), "bytes": n, **{k: s.get(k) for k in
         ("duration_s", "display_width", "display_height", "aspect", "fps", "has_audio")}})


def cmd_fetch_audio(a):
    """Download a soundtrack or sound effect (the direct audio-file URL, not the web page) for an
    Analyze Create video, verify it decodes, and record its origin and license beside it
    (<file>.source.json). Only audio with a known license goes into a deliverable."""
    dest = Path(a.out)
    try:
        n = _download(a.url, dest, a.retries, headers={"User-Agent": "Mozilla/5.0 (analyze-then-generate)"})
        s = media_summary(dest)
    except Exception as e:
        fail(str(e)[:300])
    if not s.get("has_audio"):
        fail("the downloaded file has no audio stream", 1, file=str(dest))
    meta = {"file": str(dest), "url": a.url, "page": a.page, "license": a.license, "title": a.title,
            "author": a.author, "role": a.role, "fetched": now_iso(), "duration_s": s.get("duration_s")}
    write_json(dest.with_name(dest.name + ".source.json"), meta)
    out({"ok": True, "bytes": n, **meta})


def _audio_profile(src: Path, dst: Path, transcript=None, cuts_path=None):
    """Sound-design measurements of one reference: what sits under and around the speech, so that the sound can be understood and, in Create, matched or
    reused. Measured with librosa (no listening), as NUMBERS and no verdict:
    - speech share (from the transcript) and the audible share outside it;
    - the harmonic share of the sound outside the speech (high = tonal, music-like; low = noise, percussion, ambience);
    - tempo and beat strength;
    - spectral flatness (tonal or noise-like) and the strongest frequency with how steady it is (one steady tone, such as a beep, or not);
    - energy per second, and the mean of the first and the last third of it;
    - "hits" (strong transients: stings, booms, whooshes) and whether they land on a cut.
    Whether there is a music bed, what role the sound plays (dramatic, comic, suspense, hype) and whether it could be reused are the agent's judgement from
    these numbers, the transcript and the picture. Writes dst (JSON).
    Returns (profile | None, error | None)."""
    try:
        import numpy as np
        import librosa
    except ImportError:
        return None, "librosa and numpy are required for audio-profile"
    dst.parent.mkdir(parents=True, exist_ok=True)
    wav = dst.with_suffix(".22k.wav")
    cp = run([find_tool("ffmpeg"), "-nostdin", "-y", "-loglevel", "error", "-i", str(src), "-vn", "-ac", "1",
              "-ar", "22050", str(wav)], timeout=900)
    if cp.returncode != 0 or not wav.exists():
        return None, "could not decode the audio: " + cp.stderr[-400:]
    y, sr = librosa.load(str(wav), sr=22050, mono=True)
    wav.unlink(missing_ok=True)
    dur = len(y) / sr if sr else 0
    if dur < 0.5 or not np.any(y):
        prof = {"ok": True, "format": 2, "file": str(src), "duration_s": round(dur, 2), "silent": True}
        write_json(dst, prof)
        return prof, None
    hop = 512
    speech = []
    if transcript and Path(transcript).exists():
        tj = json.loads(Path(transcript).read_text(encoding="utf-8"))
        speech = [(float(s.get("start", 0)), float(s.get("end", 0))) for s in tj.get("segments", [])
                  if s.get("end") is not None]
    cuts = []
    if cuts_path and Path(cuts_path).exists():
        cuts = [float(c["t"]) for c in json.loads(Path(cuts_path).read_text(encoding="utf-8")).get("cuts", [])]
    harm, perc = librosa.effects.hpss(y)
    rms = librosa.feature.rms(y=y, hop_length=hop)[0]
    rms_h = librosa.feature.rms(y=harm, hop_length=hop)[0]
    t = librosa.frames_to_time(np.arange(len(rms)), sr=sr, hop_length=hop)
    in_speech = np.zeros(len(t), dtype=bool)
    for s0, s1 in speech:
        in_speech |= (t >= s0) & (t <= s1)
    db = 20 * np.log10(np.maximum(rms, 1e-6))
    audible = db > -45
    non_speech = audible & ~in_speech
    harm_ratio = float(np.median((rms_h[non_speech] / np.maximum(rms[non_speech], 1e-6)))) if non_speech.any() else None
    onset = librosa.onset.onset_strength(y=y, sr=sr, hop_length=hop)
    try:
        tempo, _beats = librosa.beat.beat_track(onset_envelope=onset, sr=sr, hop_length=hop)
        tempo = float(np.atleast_1d(tempo)[0])
    except Exception:
        tempo = float(np.atleast_1d(librosa.feature.tempo(onset_envelope=onset, sr=sr, hop_length=hop))[0])
    ac = librosa.autocorrelate(onset - onset.mean())
    lag = int(round(60.0 / tempo * sr / hop)) if tempo > 0 else 0
    pulse = float(ac[lag] / ac[0]) if 0 < lag < len(ac) and ac[0] > 0 else 0.0
    speech_share = (sum(max(0.0, min(e, dur) - max(s, 0.0)) for s, e in speech) / dur) if dur else 0.0
    nonspeech_share = float(non_speech.mean()) if len(non_speech) else 0.0
    thr = onset.mean() + 2.5 * onset.std()
    pk = librosa.util.peak_pick(onset, pre_max=8, post_max=8, pre_avg=40, post_avg=40, delta=float(onset.std()), wait=20)
    hits = []
    for i in pk:
        if onset[i] < thr:
            continue
        ht = float(librosa.frames_to_time(i, sr=sr, hop_length=hop))
        near = min(cuts, key=lambda c: abs(c - ht)) if cuts else None
        hits.append({"t": round(ht, 2), "strength": round(float(onset[i] / (onset.max() or 1)), 2),
                     "in_speech": bool(any(s0 <= ht <= s1 for s0, s1 in speech)),
                     "on_cut": bool(near is not None and abs(near - ht) <= 0.25)})
    per_s = [round(float(db[(t >= k) & (t < k + 1)].mean()), 1) for k in range(int(math.ceil(dur)))
             if ((t >= k) & (t < k + 1)).any()]
    q = max(1, len(per_s) // 3)
    first, last = (statistics.mean(per_s[:q]), statistics.mean(per_s[-q:])) if per_s else (None, None)
    centroid = float(np.median(librosa.feature.spectral_centroid(y=y, sr=sr, hop_length=hop)))
    # tonal or noisy, and is it one steady tone: the median spectral flatness (near 0 = tonal, near 1 = noise-like) and the median frequency of the
    # strongest spectral peak with the share of audible frames within 3 % of it (a share near 1 = one steady tone, such as a beep)
    S = np.abs(librosa.stft(y, n_fft=2048, hop_length=hop))
    flat = librosa.feature.spectral_flatness(S=S)[0]
    pk_hz = librosa.fft_frequencies(sr=sr, n_fft=2048)[np.argmax(S, axis=0)]
    m_len = min(len(audible), flat.shape[0], pk_hz.shape[0])
    sel = audible[:m_len]
    if sel.any():
        flat_med = float(np.median(flat[:m_len][sel]))
        pk_med = float(np.median(pk_hz[:m_len][sel]))
        pk_steady = float(np.mean(np.abs(pk_hz[:m_len][sel] - pk_med) <= 0.03 * max(pk_med, 1.0)))
    else:
        flat_med = pk_med = pk_steady = None
    prof = {"ok": True, "format": 2, "file": str(src), "duration_s": round(dur, 2),
            "speech_share": round(speech_share, 2), "non_speech_audible_share": round(nonspeech_share, 2),
            "harmonic_ratio_non_speech": None if harm_ratio is None else round(harm_ratio, 2),
            "tempo_bpm": round(tempo, 1), "beat_strength": round(pulse, 2),
            "energy_db_per_s": per_s, "energy_first_third_db": None if first is None else round(first, 1),
            "energy_last_third_db": None if last is None else round(last, 1),
            "energy_change_db": None if first is None else round(last - first, 1),
            "hits": sorted(hits, key=lambda h: -h["strength"])[:12], "brightness_hz": round(centroid),
            "spectral_flatness_median": None if flat_med is None else round(flat_med, 3),
            "peak_frequency_hz_median": None if pk_med is None else round(pk_med),
            "peak_frequency_steady_share": None if pk_steady is None else round(pk_steady, 2),
            "note": "measured numbers, not listening, and no verdict: whether there is a music bed, what role the sound plays (dramatic, comic, suspense, hype ...) "
                    "and whether it could be reused (rights still apply) are for the agent to decide from these numbers, the transcript and the picture"}
    write_json(dst, prof)
    return prof, None


def cmd_audio_profile(a):
    prof, err = _audio_profile(Path(a.audio), Path(a.out), a.transcript, a.cuts)
    if err:
        fail(err, 1)
    out(prof)


# ---- audio context: what the references say and how they sound, one digest for every analysis agent in every mode

AC_PREFIX = {"references": "V", "baseline": "B", "examples": "E"}


def _ac_json(p):
    try:
        return json.loads(Path(p).read_text(encoding="utf-8"))
    except Exception:
        return None


def _ac_first_sentence(text, limit=220) -> str:
    t = " ".join(str(text or "").split())
    m = re.match(r"(.+?[.!?])(\s|$)", t)
    return (m.group(1) if m else t)[:limit]


def _ac_repeats(words):
    """Three-word phrases said at least twice: the signature of a chorus, a chant or a repeated slogan."""
    ws = [x for x in (re.sub(r"[^\w']+", "", str(w).lower()) for w in words) if x]
    grams = {}
    for i in range(len(ws) - 2):
        g = " ".join(ws[i:i + 3])
        grams[g] = grams.get(g, 0) + 1
    return [{"phrase": g, "times": n} for g, n in sorted(grams.items(), key=lambda kv: (-kv[1], kv[0])) if n >= 2][:5]


def _ac_record(vdir: Path, profile: bool = False, second=None) -> dict:
    vid = vdir.name
    vj = _ac_json(vdir / "video.json") or {}
    tr = _ac_json(vdir / "transcript.json")
    au = _ac_json(vdir / "audio.json") or {}
    src = vj.get("video")
    dur = (vj.get("probe") or {}).get("duration_s")
    has_audio = (vj.get("audio") or {}).get("has_audio")
    rec = {"id": vid, "file": Path(src).name if src else vid, "duration_s": dur, "has_audio": has_audio, "notes": []}
    cur_prof = _ac_json(vdir / "audio-profile.json")
    if profile and src and has_audio and Path(src).exists() and (cur_prof is None or cur_prof.get("format") != 2):
        _audio_profile(Path(src), vdir / "audio-profile.json", vdir / "transcript.json", vdir / "cuts.json")
    ap = _ac_json(vdir / "audio-profile.json")
    segs = (tr or {}).get("segments") or []
    # status = what the transcription step returned (a fact about the tool run), not a judgement of the audio
    if tr is None:
        status = "missing"
        rec["notes"].append("no transcript.json: this video was not prepared (T prep-all)")
    elif tr.get("skipped"):
        status = "skipped"
        rec["notes"].append("transcription was skipped (--no-transcript)")
    elif has_audio is False:
        status = "no-audio"
    elif tr.get("engine") is None:
        status = "failed"
        rec["notes"].append("transcription failed: " + str(tr.get("faster_whisper_error") or "no engine available"))
    elif not tr.get("has_speech"):
        status = "no-speech"                 # the transcriber returned no words
    else:
        status = "ok"
    rec["status"] = status
    text = " ".join(str(s.get("text", "")).strip() for s in segs).strip()
    words = [w for s in segs for w in (s.get("words") or [])]
    low = [w for w in words if w.get("p") is not None and w["p"] < 0.5]
    conf_first = next((w for w in words if w.get("p") is not None and w["p"] >= 0.5), None)
    sp_s = (tr or {}).get("speech_seconds")
    rec.update({"engine": (tr or {}).get("engine"), "model": (tr or {}).get("model"), "language": (tr or {}).get("language"),
                "language_probability": (tr or {}).get("language_probability"), "words": (tr or {}).get("n_words"), "speech_seconds": sp_s,
                "wpm": (tr or {}).get("wpm_speech_only"), "speech_share": round(float(sp_s) / dur, 2) if (dur and sp_s is not None) else None,
                "first_word_s": (vj.get("hook") or {}).get("speech_starts_s"), "first_word_p_at_least_half_s": conf_first.get("s") if conf_first else None,
                "words_below_half_probability": len(low), "low_confidence_share": round(len(low) / len(words), 2) if words else None,
                "hook_line": _ac_first_sentence(text) if text else None, "text": text,
                "lines": [{"t": s.get("start"), "end": s.get("end"), "text": str(s.get("text", "")).strip()} for s in segs[:80]],
                "repeats": _ac_repeats([w.get("w", "") for w in words] or text.split())})
    rec["audio"] = {"lufs": au.get("integrated_lufs"), "lra": au.get("lra_lu"), "silence_spans": len(au.get("silences") or []), "note": au.get("note"),
                    "tempo_bpm": (ap or {}).get("tempo_bpm"), "beat_strength": (ap or {}).get("beat_strength"),
                    "harmonic_ratio_non_speech": (ap or {}).get("harmonic_ratio_non_speech"),
                    "non_speech_audible_share": (ap or {}).get("non_speech_audible_share"),
                    "spectral_flatness_median": (ap or {}).get("spectral_flatness_median"),
                    "peak_frequency_hz_median": (ap or {}).get("peak_frequency_hz_median"),
                    "peak_frequency_steady_share": (ap or {}).get("peak_frequency_steady_share"),
                    "energy_change_db": (ap or {}).get("energy_change_db"), "profile": bool(ap and ap.get("format") == 2)}
    if status == "no-speech" and second and (dur or 0) >= 3:
        # the retry the caller asked for (--second-pass): the same audio, once more WITHOUT the voice filter, so that sung words are not dropped
        wav = vdir / "audio" / "audio-16k.wav"
        if wav.exists():
            r2 = transcribe(str(wav), vdir / "audio", second, "auto", False)
            t2 = " ".join(str(x.get("text", "")).strip() for x in r2["segments"]).strip()
            w2 = [w for x in r2["segments"] for w in (x.get("words") or [])]
            rec["second_pass"] = {"vad_filter": False, "model": r2.get("model"), "language": r2.get("language"), "language_probability": r2.get("language_probability"),
                                  "words": r2.get("n_words") or 0, "text": t2, "repeats": _ac_repeats([w.get("w", "") for w in w2] or t2.split())}
    return rec


def _ac_md(recs, set_name) -> list:
    ok = [r for r in recs if r["status"] == "ok"]
    langs = {}
    for r in ok:
        langs[r["language"]] = langs.get(r["language"], 0) + 1
    unusable = [r for r in recs if r["status"] in ("failed", "missing", "skipped")]
    L = [f"# Audio context of the {set_name}", "",
         "What the videos say and how they sound: the machine transcript (faster-whisper, local) and the measured sound facts. The transcript is ASR: it "
         "mishears, drops sung words and can invent words over music, so a line here is [E] for the words as the machine heard them, never for what the speaker "
         "meant. Judge each transcript yourself against the picture and `timeline.md` (the language probability and the share of low-probability words are given "
         "as numbers, not as a verdict), translate speech that is not English into the card (keep the hook line in its own language beside it), and decide what "
         "the sound does for the video. The numbers are measurements: no label such as music bed, song or chant is put on any video here. The audio of a "
         "reference is context for the analysis: it never goes to a generation.", "",
         f"**{len(recs)} video(s):** {len(ok)} with words found, {sum(1 for r in recs if r['status'] == 'no-speech')} with no words found, "
         f"{sum(1 for r in recs if r['status'] == 'no-audio')} without an audio track, {len(unusable)} without a usable transcript; languages heard: "
         + (", ".join(f"{k} x{v}" for k, v in sorted(langs.items(), key=lambda kv: -kv[1])) or "none") + ".", "",
         "| id | file | s | language (p) | transcript | first word (first at p >= 0.5) | words (wpm) | words below p 0.5 | sound | notes |", "|---|---|---|---|---|---|---|---|---|---|"]
    for r in recs:
        a = r["audio"]
        sound = ", ".join(x for x in (f"{a['lufs']} LUFS" if a.get("lufs") is not None else "",
                                      f"{a['tempo_bpm']} BPM, beat {a['beat_strength']}" if a.get("tempo_bpm") else "",
                                      f"harmonic {a['harmonic_ratio_non_speech']}" if a.get("harmonic_ratio_non_speech") is not None else "",
                                      f"flatness {a['spectral_flatness_median']}" if a.get("spectral_flatness_median") is not None else "",
                                      f"peak {a['peak_frequency_hz_median']} Hz (steady {a['peak_frequency_steady_share']})" if a.get("peak_frequency_hz_median") is not None else "",
                                      f"non-speech audible {a['non_speech_audible_share']}" if a.get("non_speech_audible_share") is not None else "",
                                      f"energy {a['energy_change_db']:+} dB first to last third" if a.get("energy_change_db") is not None else "") if x) or "-"
        lang = f"{r['language']} ({r['language_probability']})" if (r.get("language") and r["status"] == "ok") else "-"
        speech = f"{int((r['speech_share'] or 0) * 100)} % speech" if r.get("speech_share") is not None else ""
        low = f"{r['words_below_half_probability']} of {r['words']}" if r.get("words") else "-"
        L.append(f"| {r['id']} | {_md_cell(r['file'])} | {round(r['duration_s'], 1) if r['duration_s'] is not None else '-'} | {lang} | {r['status']} {speech} | "
                 f"{r['first_word_s'] if r.get('first_word_s') is not None else '-'} ({r['first_word_p_at_least_half_s'] if r.get('first_word_p_at_least_half_s') is not None else '-'}) | "
                 f"{r['words'] if r.get('words') is not None else '-'} ({r['wpm'] if r.get('wpm') else '-'}) | "
                 f"{low} | {_md_cell(sound)} | {_md_cell('; '.join(r['notes'])) or '-'} |")
    for r in recs:
        L += ["", f"## {r['id']} - {r['file']} ({round(r['duration_s'], 1) if r['duration_s'] is not None else '?'} s)", ""]
        a = r["audio"]
        L.append(f"- **Audio:** {'no audio track' if r['has_audio'] is False else 'yes'}; loudness {a['lufs']} LUFS (range {a['lra']} LU); {a['silence_spans']} silence span(s)"
                 + (f"; about {a['tempo_bpm']} BPM, beat strength {a['beat_strength']}, harmonic share outside speech {a['harmonic_ratio_non_speech']}, "
                    f"spectral flatness {a['spectral_flatness_median']} (near 0 tonal, near 1 noise-like), strongest frequency {a['peak_frequency_hz_median']} Hz "
                    f"in {a['peak_frequency_steady_share']} of the audible frames (near 1 = one steady tone), audible non-speech share {a['non_speech_audible_share']}, "
                    f"energy change {a['energy_change_db']} dB (last third minus first)" if a.get("profile") else "; sound profile not measured (T audio-context --profile)")
                 + (f"; {a['note']}" if a.get("note") else ""))
        L.append(f"- **Transcript:** {r['status']}" + (f" - {r['engine']} {r['model']}, language {r['language']} (p {r['language_probability']}), {r['words']} words in {r['speech_seconds']} s of speech, "
                                                          f"first word at {r['first_word_s']} s (first word of probability 0.5 or more at {r['first_word_p_at_least_half_s']} s), {r['wpm']} wpm, "
                                                          f"{r['words_below_half_probability']} word(s) below probability 0.5" if r['status'] == 'ok' else ""))
        if r.get("hook_line"):
            L.append(f"- **First sentence:** \"{r['hook_line']}\"")
        if r.get("repeats"):
            L.append("- **Repeated three-word phrases:** " + "; ".join(f"\"{x['phrase']}\" x{x['times']}" for x in r["repeats"]))
        sp2 = r.get("second_pass")
        if sp2:
            L.append(f"- **Second pass (no voice filter, {sp2['model']}):** {sp2['words']} word(s)"
                     + (f", language {sp2['language']} (p {sp2['language_probability']}): \"{sp2['text'][:400]}\"" if sp2["words"] else ""))
            if sp2.get("repeats"):
                L.append("- **Repeated three-word phrases (second pass):** " + "; ".join(f"\"{x['phrase']}\" x{x['times']}" for x in sp2["repeats"]))
        for f in r["notes"]:
            L.append(f"- **Note:** {f}")
        if r.get("lines"):
            L += ["", "Transcript (machine ASR):", ""]
            L += [f"- [{ts_label(x['t'] or 0)}-{ts_label(x['end'] or 0)}] {x['text']}" for x in r["lines"]]
    return L


def _ac_cards_missing(run, set_name, recs, require):
    d = Path(run) / "20-analysis" / ("examples" if set_name == "examples" else "cards")
    need = ("Audio context:",) if set_name == "baseline" else ("Audio context:", "Said:")
    missing = {}
    for r in recs:
        p = d / f"{r['id']}.md"
        if not p.exists():
            if require:
                missing[r["id"]] = ["no card"]
            continue
        txt = p.read_text(encoding="utf-8", errors="replace")
        lack = [k for k in need if not re.search(r"^" + re.escape(k) + r"[ \t]*\S[^\n]{2,}", txt, re.M)]
        if lack:
            missing[r["id"]] = lack
    return missing


def cmd_audio_context(a):
    """The audio context of every prepared video of a set: the transcript (language, words, first sentence, every line with its time), the speech facts and the sound facts,
    written to <run>/20-analysis/audio-context.md and .json (audio-context-<set>.* for the baseline and the examples), so that every analysis agent, in Recreate, Create
    and Viral-Browser alike, reads the same thing and writes the same 'Audio context:' lines into its cards. In Recreate the audio is context only: the reference that
    goes to a generation is still the silent copy. --check also verifies that no transcript is missing, failed or skipped and that every card has its lines."""
    base = Path(a.run) / "10-media"
    prefix = AC_PREFIX[a.set]
    vdirs = sorted((d for d in base.glob("*") if d.is_dir() and re.fullmatch(prefix + r"\d+", d.name)), key=lambda d: int(d.name[1:]))
    if not vdirs:
        fail(f"no prepared {a.set} in {base}: run `T prep-all --run RUN" + ("" if a.set == "references" else f" --set {a.set}") + "` first", 2)
    recs = [_ac_record(d, a.profile, a.whisper_model if a.second_pass else None) for d in vdirs]
    stem = "audio-context" if a.set == "references" else f"audio-context-{a.set}"
    md_path = Path(a.out) if a.out else Path(a.run) / "20-analysis" / f"{stem}.md"
    prev = _ac_json(md_path.with_suffix(".json")) or {}
    prev_second = {v.get("id"): v.get("second_pass") for v in (prev.get("videos") or []) if v.get("second_pass")}
    for r in recs:                                           # a second pass made earlier stays in the digest until the video is prepared again
        if not r.get("second_pass") and r["status"] == "no-speech" and prev_second.get(r["id"]):
            r["second_pass"] = prev_second[r["id"]]
    write_files = (not a.check) or bool(a.out)               # --check only checks: it never rewrites the digest that other agents are reading
    if write_files:
        write_text(md_path, "\n".join(_ac_md(recs, a.set)) + "\n")
        write_json(md_path.with_suffix(".json"), {"set": a.set, "generated": now_iso(), "videos": recs})
    counts = {}
    for r in recs:
        counts[r["status"]] = counts.get(r["status"], 0) + 1
    blockers = [r["id"] for r in recs if r["status"] in ("failed", "missing", "skipped")]
    res = {"ok": True, "set": a.set, "videos": len(recs), "status": counts, "without_a_transcript": blockers,
           "notes": {r["id"]: r["notes"] for r in recs if r["notes"]}, "digest": str(md_path) if write_files else None}
    if a.check:
        missing = _ac_cards_missing(a.run, a.set, recs, a.cards)
        res["cards_missing_audio_context"] = missing
        res["ok"] = not blockers and not missing         # completeness of the record only: is there a transcript for every video, and a line for it in every card
        if blockers:
            res["next"] = ("the videos without a transcript can be prepared again (T prep-all --run RUN --only <id> --redo [--whisper-model medium]); when speech "
                           "cannot be recovered, write 'transcript unavailable: <why>' in the card's Audio context line")
        elif missing:
            res["next"] = "add the 'Audio context:' and 'Said:' lines (from the digest) to the cards listed"
    out(res, 0 if res["ok"] else 1)


def cmd_split_audio(a):
    """For every ORIGINAL video under the given folder(s)/file(s): extract its audio (stream copy) into
    <root>/files_audio/<rel>.<ext> and write a silent copy (video stream copy, no audio) into
    <root>/videos_without_audio/<rel>. <root> is the given folder (or a given file's folder). The silent
    copies are what gets uploaded to Higgsfield; the audio files are merged back into approved results.
    --audio-only (Analyze Create) writes files_audio/ only: no silent copies, because no reference is
    ever uploaded; the audio feeds the sound-design analysis and the soundtrack choice.
    Idempotent (existing outputs are kept unless --redo). Writes a manifest into the run when --run."""
    ff = find_tool("ffmpeg")
    entries, errors = [], []
    for raw in a.paths:
        p = Path(raw).expanduser().resolve()
        if not p.exists():
            fail(f"not found: {p}", 2)
        root = p if p.is_dir() else p.parent
        if p.is_dir():
            vids = [f for f, _ in _collect_files([str(p)], None, None) if classify(f) == "video"]
        else:
            vids = [p] if classify(p) == "video" else []
        for f in vids:
            rel = f.relative_to(root)
            silent = None if a.audio_only else root / "videos_without_audio" / rel
            e = {"original": str(f), "silent": str(silent) if silent else None, "audio": None, "audio_offset": 0.0,
                 "root": str(root), "rel": str(rel), "final": str(root / FINAL_DIR / rel.with_suffix(".mp4"))}
            try:
                s = media_summary(f)
                e.update({"duration_s": s.get("duration_s"), "has_audio": bool(s.get("has_audio"))})
                if s.get("has_audio"):
                    codec = s.get("audio_codec") or ""
                    audio = root / "files_audio" / rel.with_suffix(AUDIO_EXT_FOR_CODEC.get(codec, ".mka"))
                    audio.parent.mkdir(parents=True, exist_ok=True)
                    if a.redo or not audio.exists():
                        cp = run([ff, "-nostdin", "-y", "-loglevel", "error", "-i", str(f), "-map",
                                  f"0:{s['audio_index']}", "-vn", "-c:a", "copy", str(audio)], timeout=1800)
                        if cp.returncode != 0 or not audio.exists():
                            audio = audio.with_suffix(".wav")
                            run([ff, "-nostdin", "-y", "-loglevel", "error", "-i", str(f), "-map",
                                 f"0:{s['audio_index']}", "-vn", "-c:a", "pcm_s24le", str(audio)], timeout=1800, check=True)
                    e["audio"] = str(audio)
                    # audio/video start offset of the ORIGINAL, applied again when merging back
                    e["audio_offset"] = round((s.get("audio_start") or 0.0) - (s.get("video_start") or 0.0), 4)
                if silent:
                    silent.parent.mkdir(parents=True, exist_ok=True)
                    if a.redo or not silent.exists():
                        extra = ["-movflags", "+faststart"] if silent.suffix.lower() in (".mp4", ".mov", ".m4v") else []
                        run([ff, "-nostdin", "-y", "-loglevel", "error", "-i", str(f), "-map", "0:v:0", "-c:v", "copy",
                             "-an", *extra, str(silent)], timeout=1800, check=True)
                    sv = media_summary(silent)
                    e["silent_ok"] = bool(sv.get("has_video")) and not sv.get("has_audio") and \
                        abs((sv.get("duration_s") or 0) - (s.get("duration_s") or 0)) <= 0.15
                    if not e["silent_ok"]:
                        errors.append({"original": str(f), "error": "silent copy failed verification"})
            except Exception as ex:
                e["error"] = str(ex)[:300]
                errors.append({"original": str(f), "error": str(ex)[:300]})
            entries.append(e)
    manifest = {"created": now_iso(), "entries": entries}
    if a.run:
        run_dir = Path(a.run)
        write_json(run_dir / "00-inventory" / "audio-split.json", manifest)
        inv_p = run_dir / "00-inventory" / "inventory.json"
        if inv_p.exists():                       # link the originals in the inventory to their pieces
            inv = json.loads(inv_p.read_text(encoding="utf-8"))
            by_orig = {str(Path(e["original"]).resolve()).lower(): e for e in entries}
            for it in inv["items"]:
                m = by_orig.get(str(Path(it["path"]).resolve()).lower())
                if m:
                    it.update({"silent_path": m["silent"], "audio_path": m["audio"], "audio_offset": m["audio_offset"],
                               "final_path": m["final"]})
            write_json(inv_p, inv)
    out({"ok": not errors, "videos": len(entries), "with_audio": sum(1 for e in entries if e.get("audio")),
         "folders": sorted({str(Path(e["silent"]).parent) for e in entries if e.get("silent")}
                           | {str(Path(e["audio"]).parent) for e in entries if e.get("audio")}),
         "audio_only": bool(a.audio_only),
         "errors": errors, "manifest": str(Path(a.run) / "00-inventory" / "audio-split.json") if a.run else None},
        0 if not errors else 1)


def cmd_finalize(a):
    """Place an APPROVED Edit Mode result (generated picture + original audio) into
    <given path>/final/<original name>.mp4 (sub-folders mirrored). Call only after the user approved it.
    A previous final of the same video is moved into the run folder first, never silently lost."""
    run_dir = Path(a.run)
    src = Path(a.file)
    if not src.exists():
        fail(f"file not found: {src}", 2)
    man_p = run_dir / "00-inventory" / "audio-split.json"
    if not man_p.exists():
        fail("no split-audio manifest in this run: run `split-audio` first", 2)
    man = json.loads(man_p.read_text(encoding="utf-8"))
    key = str(Path(a.original).resolve()).lower()
    entry = next((e for e in man["entries"] if str(Path(e["original"]).resolve()).lower() == key), None)
    if not entry:
        fail(f"original not found in the split-audio manifest: {a.original}", 2)
    dest = Path(entry.get("final") or (Path(entry["root"]) / FINAL_DIR / Path(entry["rel"]).with_suffix(".mp4")))
    final_root = Path(entry["root"]) / FINAL_DIR
    info = media_summary(src)
    # the user approved this file; the facts are recorded beside it for the agent to read, nothing here refuses the user's approval
    facts = {"has_video": bool(info.get("has_video")), "size": f"{info.get('display_width')}x{info.get('display_height')}", "expected_size": a.expect_size,
             "has_audio": bool(info.get("has_audio")), "original_has_audio": bool(entry.get("has_audio"))}
    dest.parent.mkdir(parents=True, exist_ok=True)
    _mark_final_dir(final_root)
    replaced = None
    if dest.exists():
        stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
        replaced = run_dir / "60-outputs" / "replaced-finals" / f"{dest.stem}-{stamp}{dest.suffix}"
        replaced.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(dest), str(replaced))
    shutil.copy2(src, dest)
    st_p = run_dir / "state.json"
    if st_p.exists():
        st = json.loads(st_p.read_text(encoding="utf-8"))
        vids = st.setdefault("videos", [])
        rec = {"video": a.video, "original": entry["original"], "final": str(dest), "approved_file": str(src.resolve()),
               "finalized": now_iso()}
        for i, v in enumerate(vids):
            if isinstance(v, dict) and v.get("original") == entry["original"]:
                vids[i] = {**v, **rec}
                break
        else:
            vids.append(rec)
        st["updated"] = now_iso()
        write_json(st_p, st)
    out({"ok": True, "final": str(dest), "facts": facts,
         "replaced_previous_final": str(replaced) if replaced else None})


def cmd_restore_audio(a):
    """Put the ORIGINAL audio under a generated (edited) video: the generated picture, the original sound.
    Audio source: --audio <files_audio file> (+ --audio-offset from the split manifest), or --source
    <original video> (audio extracted from it). --start selects the segment of the original timeline
    when a trimmed segment was edited. Any audio in the generated file is discarded."""
    gen, dst = Path(a.generated), Path(a.out)
    g_info = media_summary(gen)
    ff = find_tool("ffmpeg")
    work = dst.parent / "_restore"
    work.mkdir(parents=True, exist_ok=True)
    ref_info = None
    audio, off = None, 0.0
    if a.audio:
        audio = Path(a.audio)
        if not audio.exists():
            fail(f"audio file not found: {audio}", 2)
        off = a.audio_offset or 0.0
        src_dur = media_summary(audio).get("duration_s")
    elif a.source:
        ref_info = media_summary(a.source)
        src_dur = ref_info.get("duration_s")
        if ref_info.get("has_audio"):
            audio = work / "source-audio.mka"
            cp = run([ff, "-nostdin", "-y", "-loglevel", "error", "-i", str(a.source), "-map",
                      f"0:{ref_info['audio_index']}", "-vn", "-c:a", "copy", str(audio)])
            if cp.returncode != 0:
                audio = work / "source-audio.wav"
                run([ff, "-nostdin", "-y", "-loglevel", "error", "-i", str(a.source), "-map",
                     f"0:{ref_info['audio_index']}", "-vn", "-c:a", "pcm_s24le", str(audio)], check=True)
            off = (ref_info.get("audio_start") or 0.0) - (ref_info.get("video_start") or 0.0)
    else:
        fail("give --audio (from files_audio) or --source", 2)
    g_dur = g_info.get("duration_s") or 0
    want = a.duration or (src_dur - (a.start or 0.0) if src_dur else g_dur)
    dur = round(min(g_dur, want), 3) if g_dur else want          # never loop or freeze frames to pad
    if audio:
        start = a.start or 0.0
        tail = f"apad=whole_dur={dur},atrim=duration={dur}"
        shift = off - start                                        # >0: audio starts late; <0: skip into it
        if shift > 0.0005:
            af = f"adelay={int(round(shift * 1000))}:all=1,asetpts=PTS-STARTPTS,{tail}"
        elif shift < -0.0005:
            af = f"atrim=start={abs(shift):.4f},asetpts=PTS-STARTPTS,{tail}"
        else:
            af = f"asetpts=PTS-STARTPTS,{tail}"
        cp = run([ff, "-nostdin", "-y", "-loglevel", "error", "-i", str(gen), "-i", str(audio),
                  "-filter_complex", f"[1:a:0]{af}[sa]", "-map", "0:v:0", "-map", "[sa]", "-t", f"{dur}",
                  "-c:v", "copy", "-c:a", "aac", "-b:a", "256k", "-movflags", "+faststart", str(dst)])
    else:                                                          # the original had no audio → silent final
        cp = run([ff, "-nostdin", "-y", "-loglevel", "error", "-i", str(gen), "-map", "0:v:0", "-t", f"{dur}",
                  "-c:v", "copy", "-an", "-movflags", "+faststart", str(dst)])
    shutil.rmtree(work, ignore_errors=True)
    if cp.returncode != 0:
        fail("mux failed: " + cp.stderr[-600:])
    f_info = media_summary(dst)
    short_by = round(want - g_dur, 3) if want and g_dur else 0.0
    facts = {"has_video": bool(f_info.get("has_video")), "has_audio": bool(f_info.get("has_audio")), "audio_was_available": bool(audio),
             "duration_s": f_info.get("duration_s"), "requested_duration_s": dur,
             "size": f"{f_info.get('display_width')}x{f_info.get('display_height')}"}
    if ref_info:
        facts["source_size"] = f"{ref_info['display_width']}x{ref_info['display_height']}"
    out({"ok": True, "file": str(dst), "duration_s": f_info.get("duration_s"), "original_segment_s": want,
         "generated_shorter_by_s": max(short_by, 0.0),
         "note": ("the generated clip is shorter than the original segment; the original audio was cut at the "
                  "generated length (start stays in sync)") if short_by > 0.0005 else None,
         "facts": facts})


def _motion_curve(video, start: float, dur, fps: float):
    """Per-frame motion energy of a video at a fixed rate: log(1 + mean |frame - previous frame|) on
    tiny grayscale frames. Index i is the change into frame i+1, i.e. time (i+1)/fps."""
    import numpy as np
    w, h = 36, 64
    cmd = [find_tool("ffmpeg"), "-hide_banner", "-loglevel", "error", "-nostdin"]
    if start and start > 0:
        cmd += ["-ss", f"{start:.3f}"]
    cmd += ["-i", str(video)]
    if dur:
        cmd += ["-t", f"{dur:.3f}"]
    cmd += ["-an", "-vf", f"fps={fps},scale={w}:{h}:flags=area,format=gray", "-f", "rawvideo", "-"]
    cp = subprocess.run([str(c) for c in cmd], capture_output=True, timeout=900)
    if cp.returncode != 0:
        raise RuntimeError(f"ffmpeg decode failed on {video}: {cp.stderr.decode('utf-8', 'replace')[-400:]}")
    n = len(cp.stdout) // (w * h)
    if n < 4:
        raise RuntimeError(f"too few frames decoded from {video}")
    fr = np.frombuffer(cp.stdout[: n * w * h], dtype=np.uint8).reshape(n, h, w).astype(np.float32)
    return np.log1p(np.abs(np.diff(fr, axis=0)).mean(axis=(1, 2)))


def _corr_at(a, b, k: int, i0: int = 0, i1: int | None = None, min_len: int = 8):
    """Pearson correlation of a[i] with b[i+k] over i in [i0, i1); None when the overlap is too short."""
    i1 = len(a) if i1 is None else min(i1, len(a))
    lo, hi = max(i0, -k), min(i1, len(b) - k)
    if hi - lo < min_len:
        return None
    x, y = a[lo:hi], b[lo + k:hi + k]
    sx, sy = float(x.std()), float(y.std())
    if sx < 1e-6 or sy < 1e-6:
        return None
    return float(((x - x.mean()) * (y - y.mean())).mean() / (sx * sy))


def _best_lag(a, b, max_k: int, i0: int = 0, i1: int | None = None, min_len: int = 8):
    """(k, corr) maximising corr(a[i], b[i+k]); ties go to the smaller |k|."""
    best_k, best_c = None, -2.0
    for k in range(-max_k, max_k + 1):
        c = _corr_at(a, b, k, i0, i1, min_len)
        if c is None:
            continue
        if c > best_c + 1e-9 or (abs(c - best_c) <= 1e-9 and abs(k) < abs(best_k or 0)):
            best_k, best_c = k, c
    return best_k, (best_c if best_k is not None else None)


def cmd_sync_check(a):
    """Where do the generated picture's actions happen compared with the source's? The original audio
    is laid over the generated picture (restore-audio), so every action, mouth movement and impact must
    land where its sound is. Measures per-frame motion energy of the source segment and the output:
    global offset, per-window offsets (a steady offset can be fixed in post, a changing one cannot),
    duration difference, and a side-by-side sheet (source | output at the same timestamps) for visual
    confirmation. It reports numbers and never a verdict or a fix: the agent decides."""
    import numpy as np
    src, outv = Path(a.source), Path(a.output)
    for p in (src, outv):
        if not p.exists():
            fail(f"file not found: {p}", 2)
    od = Path(a.out)
    od.mkdir(parents=True, exist_ok=True)
    s_info, o_info = media_summary(src), media_summary(outv)
    start = a.start or 0.0
    seg = (s_info.get("duration_s") or 0.0) - start
    if a.duration:
        seg = min(seg, a.duration)
    o_dur = o_info.get("duration_s") or 0.0
    span = round(min(seg, o_dur), 3)
    if span < 1.0:
        fail(f"too little overlap to compare ({span}s)", 1)
    fps, tol = float(a.fps), float(a.tol)
    max_k = int(round(a.max_lag * fps))
    sc = _motion_curve(src, start, span, fps)
    oc = _motion_curve(outv, 0.0, span, fps)
    n = min(len(sc), len(oc))
    sc, oc = sc[:n], oc[:n]
    g_k, g_c = _best_lag(sc, oc, max_k, min_len=int(fps))
    g_off = round((g_k or 0) / fps, 3)
    # per-window offsets: a steady offset is fixable in post, a changing one (drift) is not
    W, hop = int(round(a.window * fps)), int(round(1.0 * fps))
    s_std = float(sc.std()) or 1e-6
    windows = []
    for i0 in range(0, max(1, n - W + 1), hop):
        x = sc[i0:i0 + W]
        k, c = _best_lag(sc, oc, max_k, i0, i0 + W, min_len=max(8, W // 2))
        windows.append({"t": round((i0 + W / 2) / fps, 2),
                        "offset_s": None if k is None else round(k / fps, 3),
                        "corr": None if k is None else round(c, 3),
                        "motion_ratio": round(float(x.std()) / s_std, 2)})          # the window's motion against the whole segment's
    # the summary below uses the windows that pass the two filters the caller names (--min-corr, --min-motion); every window is listed in sync-check.json
    rel = [w for w in windows if w["offset_s"] is not None and w["corr"] >= a.min_corr and w["motion_ratio"] >= a.min_motion]
    lags = [w["offset_s"] for w in rel]
    drift = None
    if len(rel) >= 3:
        ts, ls = np.array([w["t"] for w in rel]), np.array(lags)
        if float(ts.var()) > 0:
            drift = round(float(((ts - ts.mean()) * (ls - ls.mean())).mean() / ts.var()) * 10.0, 3)
    med = round(float(np.median(lags)), 3) if lags else g_off
    spread = round(max(lags) - min(lags), 3) if lags else None
    bad = [w for w in rel if abs(w["offset_s"]) > tol]          # a list on request: the windows whose offset is beyond the --tol the caller gave
    # anchors for the side-by-side sheet, on the output timeline (source time = start + t)
    if a.at:
        anchors = sorted(float(x) for x in re.split(r"[,\s]+", a.at.strip()) if x)
    else:
        anchors, gap = [], max(0.5, span / 16)
        for i in np.argsort(sc)[::-1]:
            t = round((int(i) + 1) / fps, 3)
            if t < span - 0.05 and all(abs(t - u) >= gap for u in anchors):
                anchors.append(t)
            if len(anchors) >= a.anchors:
                break
        anchors.sort()
    sheet = None
    if anchors:
        from PIL import Image, ImageDraw
        fd = od / "sync-frames"
        rs = extract_many(str(src), [(min(start + t, start + span - 0.04), fd / f"s{j:02d}.jpg",
                                      {"j": j, "side": "source"}) for j, t in enumerate(anchors)], max_side=360)
        ro = extract_many(str(outv), [(min(t, span - 0.04), fd / f"o{j:02d}.jpg",
                                       {"j": j, "side": "output"}) for j, t in enumerate(anchors)], max_side=360)
        got = {(r["side"], r["j"]): r for r in rs + ro if r["ok"]}
        cw, ch, cols = 180, 320, min(4, len(anchors))
        rows = math.ceil(len(anchors) / cols)
        img = Image.new("RGB", (cols * (2 * cw + 12), rows * (ch + 28)), (18, 18, 18))
        dr, fnt = ImageDraw.Draw(img), _font(15)
        for j, t in enumerate(anchors):
            x0, y0 = (j % cols) * (2 * cw + 12), (j // cols) * (ch + 28)
            dr.text((x0 + 4, y0 + 5), f"{ts_label(t)}   source | output", fill=(235, 235, 235), font=fnt)
            for side, dx in (("source", 0), ("output", cw)):
                r = got.get((side, j))
                if r:
                    with Image.open(r["file"]) as im:
                        im = im.convert("RGB")
                        im.thumbnail((cw, ch))
                        img.paste(im, (x0 + dx + (cw - im.width) // 2, y0 + 26 + (ch - im.height) // 2))
        sheet = od / "sync-sheet.jpg"
        img.save(sheet, quality=88)
    res = {"ok": True, "source": str(src), "output": str(outv),
           "start_s": start, "compared_s": span, "source_segment_s": round(seg, 3), "output_s": o_dur,
           "duration_diff_s": round(o_dur - seg, 3),
           "global_offset_s": g_off, "global_corr": None if g_c is None else round(g_c, 3),
           "filters": {"min_corr": a.min_corr, "min_motion_ratio": a.min_motion},
           "windows_used": len(rel), "windows_total": len(windows),
           "median_window_offset_s": med, "window_spread_s": spread, "drift_s_per_10s": drift,
           "tolerance_s": tol, "windows_beyond_tolerance": [{"t": w["t"], "offset_s": w["offset_s"]} for w in bad][:12],
           "windows": windows if len(windows) <= 60 else None,
           "anchors_s": anchors, "sheet": str(sheet) if sheet else None,
           "note": "measurements only, no verdict: whether the output is in sync, carries a steady offset (fixable by trimming its head or moving the audio start), "
                   "drifts (the offset changes along the clip) or cannot be told is for the agent to read from these numbers and the side-by-side sheet. "
                   "Times are on the output timeline; a positive offset = the output's action happens later than in the source (so after its sound)"}
    (od / "sync-check.json").write_text(json.dumps({**res, "windows": windows}, indent=1), encoding="utf-8")
    out(res)


def cmd_qc(a):
    """Storyboard and MEASUREMENTS of an output, beside what was expected: size, duration, aspect, audio, black and frozen stretches, and the
    on-screen text the OCR saw (how often, where, how confident) beside the text that was planned. It reports numbers and lists and says nothing
    about whether the video is good enough: reading the storyboard and these numbers against the mode's rules, and deciding, is the agent's job."""
    v = a.video
    info = media_summary(v)
    od = Path(a.out)
    shutil.rmtree(od / "frames", ignore_errors=True)
    od.mkdir(parents=True, exist_ok=True)
    dur = info.get("duration_s") or 0
    base, eff, _ = extract_baseline(v, a.fps, od / "frames", dur, max_side=720)
    sheets = build_storyboard(base, od / "qc-storyboard", f"QC {Path(v).name}", info.get("orientation", "portrait"))
    # QC checkpoints at the full frame rate (reference/anomaly-catalog.md §4): use beats, exits and
    # re-entries, occlusions, cuts, hand-offs, pours, seams. One sheet per checkpoint under <out>/dense/.
    dense = []
    shutil.rmtree(od / "dense", ignore_errors=True)
    tmax = max(0.0, dur - 1.5 / (info.get("fps") or 24))
    for i, spec in enumerate(a.dense or [], 1):
        m = re.match(r"^\s*(?:(.*?)\s*:)?\s*([0-9.]+)\s*-\s*([0-9.]+)\s*$", spec)
        if not m:
            fail(f"bad --dense {spec!r}; use label:start-end in seconds (e.g. sip:3.5-5.6)", 2)
        label = slugify(m.group(1) or f"cp{i}", 24) or f"cp{i}"
        st, en = sorted((float(m.group(2)), float(m.group(3))))
        ts, k = [], 0
        while st + k / a.dense_fps <= en + 1e-6:
            ts.append(round(min(tmax, max(0.0, st + k / a.dense_fps)), 3))
            k += 1
        ts = sorted(set(ts))
        pre = f"{i:02d}-{label}"
        res = extract_many(v, [(t, od / "dense" / f"{pre}-{ts_name(t)}.jpg", {"kind": "extra"}) for t in ts], 1280)
        dsheets = build_storyboard(res, od / "dense" / f"sheet-{pre}",
                                   f"QC checkpoint {label} {st:.2f}-{en:.2f}s @{a.dense_fps:g} fps",
                                   info.get("orientation", "portrait"), dense=len(res) > 12)
        dense.append({"label": label, "start": st, "end": en, "fps": a.dense_fps, "frames": len(res),
                      "all_frames_extracted": all(r["ok"] for r in res), "sheets": dsheets})
    ff = find_tool("ffmpeg")
    cp = run([ff, "-hide_banner", "-nostdin", "-i", v, "-map", "0:v:0", "-vf",
              "blackdetect=d=0.2:pix_th=0.10,freezedetect=n=-60dB:d=0.6", "-an", "-f", "null", "-"], timeout=1800)
    blacks = [{"start": float(m.group(1)), "end": float(m.group(2))}
              for m in re.finditer(r"black_start:([0-9.]+)\s+black_end:([0-9.]+)", cp.stderr)]
    freezes = [float(m.group(1)) for m in re.finditer(r"freeze_start:\s*([0-9.]+)", cp.stderr)]
    ew, eh = [int(x) for x in a.expect_size.lower().split("x")]
    checks = {"duration_s": dur, "aspect": info.get("aspect"), "size": f"{info.get('display_width')}x{info.get('display_height')}",
              "has_audio": info.get("has_audio"), "black_spans": blacks, "freeze_starts": freezes,
              "expected": {"size": a.expect_size, "aspect": a.expect_aspect, "duration_s": a.expect_duration}}
    checks["size_delta_px"] = [(info.get("display_width") or 0) - ew, (info.get("display_height") or 0) - eh]
    if a.expect_duration:
        checks["duration_delta_s"] = round(dur - a.expect_duration, 3)
    if a.expect_aspect:
        xw, xh = [float(x) for x in a.expect_aspect.split(":")]
        ar = info["display_width"] / info["display_height"]
        checks["aspect_error_pct"] = round(abs(ar - xw / xh) / (xw / xh) * 100, 2)
    text = {"available": False, "skipped": True}
    if not a.no_ocr and base:
        step = max(1, math.ceil(len(base) / 12))
        text = ocr_frames(base[::step][:11] + base[-1:])
    spans = (text.get("spans") or []) if text.get("available") else []
    checks["mode"] = a.mode
    checks["planned_text"] = [x.strip() for x in re.split(r"[|\n]", a.allowed_text or "") if x.strip()]
    checks["visible_text"] = ([{k: s.get(k) for k in ("text", "first_t", "last_t", "hits", "share_of_frames_scanned", "y_rel", "score_mean", "chars", "band_distinct_texts")}
                               for s in spans] if text.get("available") else None)
    checks["frames_scanned_for_text"] = text.get("frames_scanned") if text.get("available") else None
    checks["dense_checkpoints"] = [{"label": d["label"], "start": d["start"], "end": d["end"], "frames": d["frames"]}
                                   for d in dense]
    write_json(od / "qc.json", {"info": info, "checks": checks, "ocr": text, "sheets": sheets, "dense": dense})
    out({"ok": True, "qc_json": str(od / "qc.json"),
         "sheets": sheets, "dense": dense, "checks": checks,
         "note": "measurements beside the expectations, no verdict: compare planned_text with visible_text and read the storyboard yourself"})


# --------------------------------------------------------------------------- output format: 9:16 720p

def _encode_args(crf: int = 18) -> list:
    return ["-c:v", "libx264", "-preset", "medium", "-crf", str(crf), "-pix_fmt", "yuv420p", "-movflags", "+faststart"]


def cmd_conform(a):
    """Bring a clip to exactly WxH (default 720x1280) without stretching: scale-to-cover + focus crop (or --mode pad).
    It reports `lost_fraction`, the share of the picture the crop removes, and never refuses a crop: --dry-run reports it
    without writing anything, so that the agent can decide first (a large loss is a reason to use Higgsfield `reframe` or to
    regenerate from a 9:16 start frame instead)."""
    src = Path(a.video)
    info = media_summary(src)
    W, H = a.width, a.height
    iw, ih = info["display_width"], info["display_height"]
    if (iw, ih) == (W, H) and info.get("rotation", 0) == 0:
        if not a.dry_run and str(src.resolve()) != str(Path(a.out).resolve()):
            shutil.copyfile(src, a.out)
        out({"ok": True, "file": a.out, "action": "none (already exact)", "lost_fraction": 0.0, **({"dry_run": True} if a.dry_run else {})})
    ff = find_tool("ffmpeg")
    if a.mode == "pad":
        s = min(W / iw, H / ih)
        vf = (f"split[a][b];[a]scale={W}:{H}:force_original_aspect_ratio=increase,crop={W}:{H},gblur=sigma=30,"
              f"eq=brightness=-0.06[bg];[b]scale={int(round(iw * s / 2)) * 2}:{int(round(ih * s / 2)) * 2}:flags=lanczos[fg];"
              f"[bg][fg]overlay=(W-w)/2:(H-h)/2,setsar=1")
        lost, action = 0.0, "scale-to-fit + blurred fill (no crop, no stretch)"
        cmd = [ff, "-nostdin", "-y", "-loglevel", "error", "-i", str(src), "-filter_complex", vf,
               "-map", "0:a?", *_encode_args(a.crf), "-c:a", "aac", "-b:a", "192k", a.out]
    else:
        s = max(W / iw, H / ih)
        sw, sh = math.ceil(iw * s / 2) * 2, math.ceil(ih * s / 2) * 2
        lost = round(1 - (W * H) / (sw * sh), 4)
        cx = min(max(a.focus_x * sw - W / 2, 0), sw - W)
        cy = min(max(a.focus_y * sh - H / 2, 0), sh - H)
        vf = f"scale={sw}:{sh}:flags=lanczos,crop={W}:{H}:{int(cx)}:{int(cy)},setsar=1"
        action = f"scale-to-cover {iw}x{ih}->{sw}x{sh} + crop {W}x{H} at focus ({a.focus_x},{a.focus_y})"
        cmd = [ff, "-nostdin", "-y", "-loglevel", "error", "-i", str(src), "-vf", vf, "-map", "0:v:0",
               "-map", "0:a?", *_encode_args(a.crf), "-c:a", "aac", "-b:a", "192k", a.out]
    if a.dry_run:
        out({"ok": True, "dry_run": True, "action": action, "lost_fraction": lost, "input": f"{iw}x{ih}", "output_size": f"{W}x{H}"})
    cp = run(cmd, timeout=3600)
    if cp.returncode != 0:
        fail("ffmpeg failed: " + cp.stderr[-600:])
    o = media_summary(a.out)
    ok = (o["display_width"], o["display_height"]) == (W, H)          # did the tool produce the size it was asked for
    out({"ok": ok, "file": a.out, "action": action, "lost_fraction": lost,
         "output": f"{o['display_width']}x{o['display_height']}", "duration_s": o.get("duration_s")}, 0 if ok else 1)


# --------------------------------------------------------------------------- deterministic text (captions / overlays)

FONT_FILES = {
    "arial": ["arial.ttf", "arialbd.ttf"], "arial black": ["ariblk.ttf"], "impact": ["impact.ttf"],
    "segoe ui": ["segoeui.ttf", "segoeuib.ttf"], "segoe ui black": ["seguibl.ttf"],
    "segoe ui semibold": ["seguisb.ttf"], "verdana": ["verdana.ttf", "verdanab.ttf"],
    "tahoma": ["tahoma.ttf", "tahomabd.ttf"], "trebuchet ms": ["trebuc.ttf", "trebucbd.ttf"],
    "calibri": ["calibri.ttf", "calibrib.ttf"], "georgia": ["georgia.ttf", "georgiab.ttf"],
}
FONT_DIRS = [Path(os.environ.get("WINDIR", r"C:\Windows")) / "Fonts",
             Path(os.environ.get("LOCALAPPDATA", "")) / "Microsoft" / "Windows" / "Fonts",
             Path("/usr/share/fonts"), Path("/Library/Fonts")]

CAPTION_PRESETS = {   # tuned for 720x1280; safe zones keep text clear of platform UI
    "hook":    {"font": "Arial Black", "size": 62, "primary": "#FFFFFF", "outline": "#000000", "outline_width": 5,
                "shadow": 0, "align": "top", "margin_v": 0.12, "bold": True},
    "caption": {"font": "Arial Black", "size": 52, "primary": "#FFFFFF", "outline": "#000000", "outline_width": 4,
                "shadow": 0, "align": "lower", "margin_v": 0.26, "bold": True},
    "label":   {"font": "Arial", "size": 38, "primary": "#FFFFFF", "outline": "#000000", "outline_width": 0,
                "shadow": 0, "align": "center", "margin_v": 0.0, "bold": True, "box": True,
                "box_color": "#000000", "box_alpha": 0.45},
    "callout": {"font": "Arial Black", "size": 46, "primary": "#FFE14D", "outline": "#000000", "outline_width": 4,
                "shadow": 0, "align": "center", "margin_v": 0.0, "bold": True},
}


def _ass_color(hexcol: str, alpha: float = 0.0) -> str:
    h = hexcol.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return f"&H{int(round(alpha * 255)):02X}{b:02X}{g:02X}{r:02X}"


def _ass_time(t: float) -> str:
    t = max(0.0, t)
    h, rem = divmod(t, 3600)
    m, s = divmod(rem, 60)
    return f"{int(h)}:{int(m):02d}:{s:05.2f}"


def _resolve_font(style: dict, fonts_out: Path) -> str:
    """Copy the font file(s) next to the .ass so libass never depends on system font configuration."""
    fonts_out.mkdir(parents=True, exist_ok=True)
    if style.get("font_file"):
        p = Path(style["font_file"])
        shutil.copyfile(p, fonts_out / p.name)
        try:
            from PIL import ImageFont
            return ImageFont.truetype(str(p), 20).getname()[0]
        except Exception:
            return style.get("font", p.stem)
    fam = style.get("font", "Arial Black")
    for fn in FONT_FILES.get(fam.lower(), []):
        for d in FONT_DIRS:
            if (d / fn).exists():
                shutil.copyfile(d / fn, fonts_out / fn)
                break
    return fam


def _house_caption_look() -> dict:
    """The fallback burn-in imitates the CapCut house text style: CapCut's System font, white fill, black
    outline, not bold (capcut.text_style in config.json). Sizes stay the presets' own."""
    st = _house_text_style()
    look = {"primary": st["fill"], "outline": st["stroke"]["color"], "bold": False}
    font = _capcut_system_font()
    if font:
        look["font_file"] = font
    return look


def build_ass(spec: dict, W: int, H: int, fonts_out: Path) -> str:
    base = spec.get("style", {})
    styles, used = {}, set(e.get("preset", "caption") for e in spec["events"])
    for name in sorted(used):
        st = {**CAPTION_PRESETS.get(name, CAPTION_PRESETS["caption"]), **_house_caption_look(),
              **base, **spec.get("presets", {}).get(name, {})}
        st["family"] = _resolve_font(st, fonts_out)
        styles[name] = st
    align_map = {"top": 8, "upper": 8, "center": 5, "middle": 5, "lower": 2, "bottom": 2}
    lines = ["[Script Info]", "ScriptType: v4.00+", f"PlayResX: {W}", f"PlayResY: {H}", "WrapStyle: 0",
             "ScaledBorderAndShadow: yes", "", "[V4+ Styles]",
             "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, "
             "Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, "
             "MarginL, MarginR, MarginV, Encoding"]
    safe = {"left": 0.06, "right": 0.12, **spec.get("safe_area", {})}
    for name, st in styles.items():
        box = st.get("box")
        back = _ass_color(st.get("box_color", "#000000"), 1 - st.get("box_alpha", 0.5)) if box else "&H00000000"
        lines.append(
            f"Style: {name},{st['family']},{st['size']},{_ass_color(st['primary'])},&H000000FF,"
            f"{_ass_color(st.get('outline', '#000000'))},{back},{-1 if st.get('bold', True) else 0},0,0,0,100,100,0,0,"
            f"{3 if box else 1},{st.get('box_pad', 8) if box else st.get('outline_width', 4)},{st.get('shadow', 0)},"
            f"{align_map.get(st.get('align', 'lower'), 2)},{int(safe['left'] * W)},{int(safe['right'] * W)},"
            f"{int(st.get('margin_v', 0.26) * H)},1")
    lines += ["", "[Events]", "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text"]
    for e in sorted(spec["events"], key=lambda e: e["start"]):
        txt = str(e["text"]).replace("{", "(").replace("}", ")").replace("\\", "/").replace("\n", "\\N")
        if spec.get("uppercase") or e.get("uppercase"):
            txt = txt.upper()
        tags = ""
        if e.get("pos"):
            x, y = e["pos"]
            tags += f"\\pos({int(x * W if x <= 1 else x)},{int(y * H if y <= 1 else y)})"
        anim = e.get("animation", spec.get("animation", "pop"))
        if anim == "pop":
            tags += "\\fscx85\\fscy85\\t(0,90,\\fscx100\\fscy100)"
        elif anim == "fade":
            tags += "\\fad(120,120)"
        lines.append(f"Dialogue: {e.get('layer', 0)},{_ass_time(e['start'])},{_ass_time(e['end'])},"
                     f"{e.get('preset', 'caption')},,0,0,0,,{('{' + tags + '}') if tags else ''}{txt}")
    return "\n".join(lines) + "\n"


def _norm_word(w: str) -> str:
    return re.sub(r"[^\w']+", "", w.lower())


def align_script(words: list, script: str) -> list:
    """Keep the intended wording, borrow timing from ASR words (difflib alignment + interpolation)."""
    import difflib
    target = script.split()
    if not words:
        return []
    a = [_norm_word(w["w"]) for w in words]
    b = [_norm_word(t) for t in target]
    sm = difflib.SequenceMatcher(a=a, b=b, autojunk=False)
    timed = [None] * len(target)
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal" or (tag == "replace" and (i2 - i1) == (j2 - j1)):
            for k in range(j2 - j1):
                timed[j1 + k] = (words[i1 + k]["s"], words[i1 + k]["e"])
        elif tag == "replace" and i2 > i1:
            s0, e0 = words[i1]["s"], words[i2 - 1]["e"]
            step = (e0 - s0) / max(1, j2 - j1)
            for k in range(j2 - j1):
                timed[j1 + k] = (s0 + k * step, s0 + (k + 1) * step)
    last_e = words[0]["s"]
    for i in range(len(timed)):             # fill gaps (inserted words) between neighbours
        if timed[i] is None:
            nxt = next((timed[j][0] for j in range(i + 1, len(timed)) if timed[j]), last_e + 0.3)
            timed[i] = (last_e, max(last_e + 0.12, min(nxt, last_e + 0.35)))
        last_e = timed[i][1]
    return [{"w": target[i], "s": round(timed[i][0], 2), "e": round(timed[i][1], 2)} for i in range(len(target))]


def chunk_words(words: list, max_words: int = 3, max_gap: float = 0.35, max_dur: float = 1.8) -> list:
    events, cur = [], []
    for w in words:
        if cur and (len(cur) >= max_words or w["s"] - cur[-1]["e"] > max_gap or w["e"] - cur[0]["s"] > max_dur
                    or re.search(r"[.!?,;:]$", cur[-1]["w"])):
            events.append(cur)
            cur = []
        cur.append(w)
    if cur:
        events.append(cur)
    res = []
    for i, ev in enumerate(events):
        end = ev[-1]["e"]
        if i + 1 < len(events):
            end = min(max(end, ev[-1]["e"] + 0.05), events[i + 1][0]["s"])   # never overlap the next caption
        res.append({"start": round(ev[0]["s"], 2), "end": round(max(end, ev[0]["s"] + 0.25), 2),
                    "text": " ".join(w["w"] for w in ev), "preset": "caption"})
    return res


def cmd_captions(a):
    """Burn exact, frame-consistent text with libass: explicit events (--spec) and/or speech-timed
    captions (--from-speech, optionally forced to the intended wording with --script)."""
    video = Path(a.video)
    info = media_summary(video)
    W, H = info["display_width"], info["display_height"]
    spec = {"events": []}
    if a.spec:
        spec = json.loads(Path(a.spec).read_text(encoding="utf-8"))
        spec.setdefault("events", [])
    work = Path(a.out).parent / (Path(a.out).stem + "-captions")
    work.mkdir(parents=True, exist_ok=True)
    if a.from_speech:
        aud = audio_analysis(str(video), info, work / "audio")
        if not aud.get("wav_16k"):
            fail("no audio stream to time captions against")
        tr = transcribe(aud["wav_16k"], work / "audio", a.whisper_model, a.language)
        words = [w for s in tr["segments"] for w in s.get("words", [])]
        script = Path(a.script_file).read_text(encoding="utf-8") if a.script_file else a.script
        if script:
            words = align_script(words, script)
        spec["events"] += chunk_words(words, a.words_per_caption)
    if not spec["events"]:
        fail("no caption events (give --spec and/or --from-speech)", 2)
    ass = build_ass(spec, W, H, work / "fonts")
    ass_path = work / "captions.ass"
    ass_path.write_text(ass, encoding="utf-8")
    write_json(work / "caption-events.json", spec["events"])
    cp = run([find_tool("ffmpeg"), "-nostdin", "-y", "-loglevel", "error", "-i", str(video.resolve()),
              "-vf", "subtitles=captions.ass:fontsdir=fonts", "-map", "0:v:0", "-map", "0:a?",
              *_encode_args(a.crf), "-c:a", "copy", str(Path(a.out).resolve())], cwd=str(work), timeout=3600)
    if cp.returncode != 0:
        fail("burn-in failed: " + cp.stderr[-800:])
    out({"ok": True, "file": a.out, "events": len(spec["events"]), "ass": str(ass_path),
         "events_json": str(work / "caption-events.json")})


# --------------------------------------------------------------------------- deterministic clean-up (Edit Mode)

def _rect(spec: str, W: int, H: int) -> tuple:
    body, _, rng = spec.partition("@")
    x, y, w, h = [float(v) for v in body.split(",")]
    if max(x, y, w, h) <= 1.0:
        x, y, w, h = x * W, y * H, w * W, h * H
    t0 = t1 = None
    if rng:
        t0, t1 = [float(v) for v in rng.split("-")]
    return int(x), int(y), int(w), int(h), t0, t1


def cmd_clean(a):
    """Local clean-up before an edit: delogo small static overlays (handles, watermarks, corner bugs)
    and/or crop away a static text band. Large captions over the subject belong to the edit model."""
    info = media_summary(a.video)
    W, H = info["display_width"], info["display_height"]
    filters = []
    for d in a.delogo or []:
        x, y, w, h, t0, t1 = _rect(d, W, H)
        x, y = max(1, x), max(1, y)
        w, h = min(w, W - x - 2), min(h, H - y - 2)
        f = f"delogo=x={x}:y={y}:w={w}:h={h}"
        if t0 is not None:
            f += f":enable='between(t,{t0},{t1})'"
        filters.append(f)
    if a.crop:
        x, y, w, h, _, _ = _rect(a.crop, W, H)
        filters.append(f"crop={w // 2 * 2}:{h // 2 * 2}:{x}:{y}")
    if not filters:
        fail("give --delogo and/or --crop", 2)
    cp = run([find_tool("ffmpeg"), "-nostdin", "-y", "-loglevel", "error", "-i", a.video, "-vf",
              ",".join(filters + ["setsar=1"]), "-map", "0:v:0", "-map", "0:a?", *_encode_args(a.crf),
              "-c:a", "copy", a.out], timeout=3600)
    if cp.returncode != 0:
        fail("ffmpeg failed: " + cp.stderr[-600:])
    o = media_summary(a.out)
    out({"ok": True, "file": a.out, "filters": filters, "output": f"{o['display_width']}x{o['display_height']}"})


# --------------------------------------------------------------------------- trim / concat

def cmd_trim(a):
    """Frame-accurate trim (re-encode) — removes generated dead space at the head or tail."""
    info = media_summary(a.video)
    end = a.end if a.end is not None else info["duration_s"]
    if not (0 <= a.start < end):
        fail("need 0 <= start < end", 2)
    cp = run([find_tool("ffmpeg"), "-nostdin", "-y", "-loglevel", "error", "-i", a.video, "-ss", f"{a.start:.3f}",
              "-to", f"{end:.3f}", "-map", "0:v:0", "-map", "0:a?", *_encode_args(a.crf), "-c:a", "aac", "-b:a",
              "192k", a.out], timeout=3600)
    if cp.returncode != 0:
        fail("ffmpeg failed: " + cp.stderr[-600:])
    o = media_summary(a.out)
    out({"ok": True, "file": a.out, "duration_s": o.get("duration_s")})


def _count_frames(path) -> tuple[int, float]:
    """Exact decoded frame count and frame rate of the first video stream (decodes the whole clip)."""
    cp = run([find_tool("ffprobe"), "-v", "error", "-count_frames", "-select_streams", "v:0", "-show_entries",
              "stream=nb_read_frames,avg_frame_rate,r_frame_rate", "-of", "json", str(path)], timeout=900)
    if cp.returncode != 0:
        raise RuntimeError(f"ffprobe failed on {path}: {cp.stderr.strip()[:400]}")
    s = (json.loads(cp.stdout or "{}").get("streams") or [{}])[0]
    fps = _ratio(s.get("avg_frame_rate")) or _ratio(s.get("r_frame_rate")) or 24.0
    return int(s.get("nb_read_frames", 0) or 0), fps


CAUGHT_ERRORS = ATG_HOME / "caught_errors.md"
CE_CAUSES = ["prompt", "reference", "parameter", "plan", "qc-miss", "model-limit", "unknown",
             "research", "scoring", "bias", "evidence"]       # the last four: Viral-Browser picks
CE_STATUS = ["open", "fixed", "promoted"]


def _ce_parse(text: str) -> list:
    """Entries of caught_errors.md: '## CE-nnn · date · title' headings with '- **field:** value' lines."""
    entries, cur, last = [], None, None
    for line in text.splitlines():
        m = re.match(r"^## (CE-\d{3,}) · (\S+) · (.*)$", line)
        if m:
            cur = {"id": m.group(1), "date": m.group(2), "title": m.group(3).strip()}
            entries.append(cur); last = None
            continue
        if cur is None:
            continue
        m = re.match(r"^- \*\*([a-z][a-z ]*):\*\* ?(.*)$", line)
        if m:
            last = m.group(1).strip().replace(" ", "_")
            cur[last] = m.group(2).strip()
            continue
        if last and line.startswith("  ") and line.strip():
            body = line[2:]
            if last in ("brief", "prompt", "qc", "verified_prompt", "prompt_change", "errors"):
                if body.strip().startswith("```"):
                    continue
                cur[last] = (cur[last] + "\n" + body).strip("\n")
            else:
                cur[last] = (cur[last] + " " + line.strip()).strip()
    return entries


def _ce_text_or_file(v):
    """A literal text, or a file path: a .md/.txt file is read whole; a request .json gives its prompt."""
    if not v:
        return ""
    p = Path(str(v))
    try:
        if p.is_file():
            raw = p.read_bytes().decode("utf-8", "replace").replace("\r\n", "\n")
            if p.suffix.lower() == ".json":
                try:
                    j = json.loads(raw)
                    if isinstance(j, dict):
                        if isinstance(j.get("prompt"), str):
                            return j["prompt"].strip()
                        if isinstance(j.get("params"), dict) and isinstance(j["params"].get("prompt"), str):
                            return j["params"]["prompt"].strip()
                except ValueError:
                    pass
            return raw.strip("\n")
    except OSError:
        pass
    return str(v)


def _ce_autofind(run, video) -> dict:
    """The run's own files for a video: 40-briefs/video-NN-brief.md, the newest request json, the plan."""
    found = {}
    if not run or not video:
        return found
    rd = Path(str(run))
    if not rd.exists():
        rd = ATG_HOME / "runs" / str(run)
    if not rd.exists():
        return found
    v = str(video).strip()
    m = re.search(r"(\d{1,3})", v)
    nn = m.group(1).zfill(2) if m else v
    b = rd / "40-briefs" / f"video-{nn}-brief.md"
    if b.is_file():
        found["brief"] = b
    plan = rd / "40-briefs" / f"video-{nn}-plan.md"
    if plan.is_file():
        found["plan"] = plan
    res = rd / "60-outputs" / f"video-{nn}" / "result.json"
    if res.is_file():
        try:
            r = json.loads(res.read_bytes().decode("utf-8"))
            bits = [f"CapCut project {r['capcut_project']}" if r.get("capcut_project") else "",
                    f"clean {r['clean']}" if r.get("clean") else "",
                    f"credits {r['credits']}" if r.get("credits") is not None else "",
                    f"run QC: {r['qc']}" if r.get("qc") else ""]
            found["delivered"] = " · ".join(b for b in bits if b)
            if r.get("qc"):
                found["qc"] = str(r["qc"])
        except (ValueError, OSError):
            pass
    reqs = [p for p in (rd / "50-requests").glob(f"video-{nn}*-request.json")] if (rd / "50-requests").is_dir() else []
    if reqs:
        found["prompt"] = max(reqs, key=lambda p: p.stat().st_mtime)
    return found


def _ce_params(src) -> str:
    """Compact generation parameters from a request .json: model, mode, duration, format, media roles."""
    if not src:
        return ""
    p = Path(str(src))
    if not (p.is_file() and p.suffix.lower() == ".json"):
        return ""
    try:
        j = json.loads(p.read_bytes().decode("utf-8"))
    except (ValueError, OSError):
        return ""
    prm = j.get("params") if isinstance(j.get("params"), dict) else j
    bits = []
    for k in ("model", "mode", "duration", "duration_policy", "aspect_ratio", "resolution", "generate_audio", "enable_thinking"):
        if k in prm:
            bits.append(f"{k}={prm[k]}")
    roles = {}
    for m in prm.get("medias") or []:
        if isinstance(m, dict):
            r = m.get("role", "?")
            roles[r] = roles.get(r, 0) + 1
    if roles:
        bits.append("medias=" + ", ".join(f"{r}×{n}" if n > 1 else r for r, n in roles.items()))
    bits.append(f"request={p.name}")
    return " · ".join(bits)


def _ce_sentence_diff(old: str, new: str, cap: int = 14) -> str:
    """What changed between the failed and the verified prompt, sentence by sentence (- removed, + added)."""
    import difflib
    def sp(t):
        return [s.strip() for s in re.split(r"(?<=[.;!?])\s+|\n+", t or "") if s.strip()]
    a_, b_ = sp(old), sp(new)
    lines = []
    for op, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a_, b_, autojunk=False).get_opcodes():
        if op in ("replace", "delete"):
            lines += ["- " + s[:300] for s in a_[i1:i2]]
        if op in ("replace", "insert"):
            lines += ["+ " + s[:300] for s in b_[j1:j2]]
    if len(lines) > cap:
        lines = lines[:cap] + [f"… {len(lines) - cap} more changed sentences"]
    return "\n".join(lines)


def _ce_block_field(name: str, text: str) -> str:
    """A multi-line field as an indented fenced block (the parser joins the lines back)."""
    text = (text or "").strip("\n")
    if not text:
        return f"- **{name}:** not recorded\n"
    lines = "\n".join("  " + l for l in text.splitlines())
    return f"- **{name}:**\n  ```text\n{lines}\n  ```\n"


def cmd_caught_error(a):
    """The feedback ledger (caught_errors.md at the library root): add an entry for a video the user
    was not satisfied with, list the entries that apply to a run, or set an entry's status."""
    if not CAUGHT_ERRORS.exists():
        CAUGHT_ERRORS.write_bytes(b"# Caught errors: the feedback ledger\n")
    if a.action == "list":
        entries = _ce_parse(CAUGHT_ERRORS.read_bytes().decode("utf-8").replace("\r\n", "\n"))
        def keep(e):
            if a.mode and a.mode.lower() not in (e.get("mode", "") + " any all").lower(): return False
            if a.model and a.model.lower() not in (e.get("model", "") + " any all unknown").lower(): return False
            if a.cls and a.cls.lower() not in e.get("class", "").lower(): return False
            if a.status and e.get("status", "").lower() != a.status.lower(): return False
            if a.grep and a.grep.lower() not in json.dumps(e, ensure_ascii=False).lower(): return False
            return True
        sel = [e for e in entries if keep(e)]
        if a.digest:
            def short(s, n=240):
                s = re.sub(r"\s+", " ", s or "").strip()
                return s if len(s) <= n else s[:n - 1] + "…"
            skip = ("", "not recorded", "none", "unknown", "—")
            sel = [{k: v for k, v in {
                "id": e["id"], "title": e["title"], "source": e.get("source", "user"), "status": e.get("status", ""),
                "mode": e.get("mode", ""), "model": e.get("model", ""), "product": e.get("product", ""),
                "assets": e.get("assets", ""), "class": e.get("class", ""), "evidence": e.get("evidence", ""),
                "wrong": short(e.get("what_was_wrong", "")), "params": e.get("params", ""),
                "errors": short(e.get("errors", ""), 300), "rule": e.get("rule", ""),
                "verified": e.get("verified", ""), "prompt_change": e.get("prompt_change", ""),
            }.items() if v not in skip} for e in sel]
        elif a.rules:
            sel = [{"id": e["id"], "title": e["title"], "class": e.get("class", ""), "status": e.get("status", ""),
                    "rule": e.get("rule", "")} for e in sel]
        out({"ok": True, "file": str(CAUGHT_ERRORS), "total": len(entries), "count": len(sel), "entries": sel})
    if a.action == "set":
        if not a.id:
            fail("--id CE-nnn is required", 2)
        with FileLock(CAUGHT_ERRORS.with_suffix(".lock")):
            text = CAUGHT_ERRORS.read_bytes().decode("utf-8").replace("\r\n", "\n")
            m = re.search(rf"^## {re.escape(a.id)} · .*$", text, re.M)
            if not m:
                fail(f"{a.id} not found", 1)
            nxt = re.search(r"^## CE-", text[m.end():], re.M)
            s, e = m.start(), (m.end() + nxt.start()) if nxt else len(text)
            block = text[s:e]
            if a.status == "fixed" and not a.qc_pass:
                fail("--status fixed needs --qc-pass: the verdict of the regenerated (or re-edited) video that passed QC "
                     "or that the user approved; a fix is recorded only once it is verified", 2)
            if a.verified_prompt:
                if not a.qc_pass:
                    fail("--verified-prompt needs --qc-pass: insert the working prompt only after the new generation "
                         "came back correct and passed QC", 2)
                vp = _ce_text_or_file(a.verified_prompt)
                pm = re.search(r"^- \*\*prompt:\*\*\n  ```text\n(.*?)\n  ```", block, re.S | re.M)
                old_prompt = "\n".join(l[2:] for l in pm.group(1).splitlines()) if pm else ""
                change = _ce_sentence_diff(old_prompt, vp) if old_prompt else ""
                vparams = _ce_params(a.verified_prompt)
                new_fields = (_ce_block_field("verified prompt", vp)
                              + _ce_block_field("prompt change", change or "not computed (the entry has no failed prompt)")
                              + (f"- **verified params:** {vparams}\n" if vparams else ""))
                block, n = re.subn(r"^- \*\*verified prompt:\*\* pending.*\n", lambda m: new_fields, block, count=1, flags=re.M)
                if not n:
                    block = block.rstrip("\n") + "\n" + new_fields + ("\n" if nxt else "")
                a.status = a.status or "fixed"
                a.fix = a.fix or "regenerated with the verified prompt; see prompt change"
            if a.qc_pass:
                vline = f"- **verified:** {a.qc_pass.strip()} ({dt.date.today().isoformat()})\n"
                block, n = re.subn(r"^- \*\*verified:\*\* .*\n", lambda m: vline, block, count=1, flags=re.M)
                if not n:
                    block = block.rstrip("\n") + "\n" + vline + ("\n" if nxt else "")
            for key, val in (("status", a.status), ("promoted to", a.promoted_to), ("fix", a.fix)):
                if val:
                    block, n = re.subn(rf"^- \*\*{key}:\*\* .*$", f"- **{key}:** {val}", block, count=1, flags=re.M)
                    if not n:
                        block = block.rstrip("\n") + f"\n- **{key}:** {val}\n"
            text = text[:s] + block + text[e:]
            CAUGHT_ERRORS.write_bytes(text.encode("utf-8"))
        out({"ok": True, "id": a.id, "status": a.status, "promoted_to": a.promoted_to, "file": str(CAUGHT_ERRORS)})
    # add
    need = ("title", "wrong", "rule") if a.source == "agent" else ("title", "user", "wrong", "rule")
    missing = [k for k in need if not getattr(a, k)]
    if missing:
        fail("missing " + ", ".join("--" + k for k in missing)
             + (" (an agent entry needs the diagnosis and the rule)" if a.source == "agent"
                else " (the user's words, the diagnosis and the rule are required)"), 2)
    with FileLock(CAUGHT_ERRORS.with_suffix(".lock")):
        text = CAUGHT_ERRORS.read_bytes().decode("utf-8").replace("\r\n", "\n")
        ids = [int(x) for x in re.findall(r"^## CE-(\d{3,}) · ", text, re.M)]
        cid = f"CE-{(max(ids) + 1) if ids else 1:03d}"
        date = a.date or dt.date.today().isoformat()
        user = (a.user or "").strip().strip('"')
        said = f"\"{user}\"" if user else "— (caught by the agent during the run)"
        auto = _ce_autofind(a.run, a.video)
        brief = _ce_text_or_file(a.brief) or (_ce_text_or_file(auto["brief"]) if "brief" in auto else "")
        prompt = _ce_text_or_file(a.prompt) or (_ce_text_or_file(auto["prompt"]) if "prompt" in auto else "")
        qc = _ce_text_or_file(a.qc) or auto.get("qc", "")
        delivered = a.delivered or auto.get("delivered", "")
        plan = a.plan or (str(auto["plan"]) if "plan" in auto else "")
        req_src = a.prompt if (a.prompt and str(a.prompt).lower().endswith(".json")) else (None if a.prompt else auto.get("prompt"))
        params = a.params or _ce_params(req_src)
        errors = _ce_text_or_file(a.errors)
        attached = [k for k, v in (("brief", brief), ("prompt", prompt), ("qc", qc), ("plan", plan)) if v]
        ctx = (_ce_block_field("brief", brief)
               + _ce_block_field("prompt", prompt)
               + f"- **params:** {params or 'not recorded'}\n"
               + (_ce_block_field("errors", errors) if errors else "- **errors:** none\n")
               + f"- **evidence:** {a.evidence or 'not recorded'}\n"
               + _ce_block_field("qc", qc)
               + f"- **plan:** {plan or 'not recorded'}\n")
        block = (f"\n## {cid} · {date} · {a.title.strip()}\n"
                 f"- **source:** {a.source}\n"
                 f"- **video:** {a.video or 'unknown'}\n"
                 f"- **run:** {a.run or 'unknown'}\n"
                 f"- **delivered:** {delivered or 'not recorded'}\n"
                 f"- **mode:** {a.mode or 'unknown'}\n"
                 f"- **model:** {a.model or 'unknown'}\n"
                 f"- **product:** {a.product or 'unknown'}\n"
                 f"- **assets:** {a.assets or 'not recorded'}\n"
                 f"- **user said:** {said}\n"
                 f"- **what was wrong:** {a.wrong.strip()}\n"
                 + ctx +
                 f"- **class:** {a.cls or 'new'}\n"
                 f"- **cause:** {a.cause}\n"
                 f"- **fix:** {a.fix or 'none yet'}\n"
                 f"- **verified prompt:** pending (inserted only after a new generation passes QC)\n"
                 f"- **rule:** {a.rule.strip()}\n"
                 f"- **status:** {a.status or 'open'}\n"
                 f"- **promoted to:** {a.promoted_to or '—'}\n")
        CAUGHT_ERRORS.write_bytes((text.rstrip("\n") + "\n" + block).encode("utf-8"))
    missing_ctx = [k for k in ("brief", "prompt") if k not in attached]
    out({"ok": True, "id": cid, "date": date, "title": a.title.strip(), "file": str(CAUGHT_ERRORS),
         "attached": attached, "missing": missing_ctx,
         "note": ("attach the brief and the final prompt (--brief/--prompt, text or file; or --run + --video to find them) so the cause can be read; " if missing_ctx else "")
                 + "promote the rule into its reference when it is general or recurs, then `caught-error set --status promoted --promoted-to …`"})


def _px_span(spec: str, what: str) -> float:
    """'y0-y1' (pixel rows) or a plain pixel height."""
    s = (spec or "").strip()
    m = re.match(r"^\s*([0-9.]+)\s*-\s*([0-9.]+)\s*$", s)
    if m:
        a, b = float(m.group(1)), float(m.group(2))
        return abs(b - a)
    try:
        return float(s)
    except ValueError:
        fail(f"bad {what} {spec!r}: give pixel rows 'y0-y1' or a pixel height", 2)


def cmd_scale(a):
    """Size reckoning for a product in a frame (anomaly-catalog.md §2.7): arithmetic only, no verdict.

    Before generation (plan): `scale --product-cm 15.7 --distance 1.5 --lens 26` gives the fraction
    of the frame height and the pixel height the product should have at that depth, plus a table
    over the usual shot distances, so the prompt and a start frame can be built at the right size.
    After generation (QC): add `--product-px <y0-y1 | px>` measured on a full-resolution frame, and
    a neighbour of known size at (about) the same depth: `--ref-cm 22 --ref-px <y0-y1 | px>`
    (`--depth-ratio` = product distance / neighbour distance when they differ). It then gives the
    observed size as a multiple of the expected one for each estimate that could be made (against the
    neighbour, against the distance and the lens) and, when there are two, how far they are from each
    other. What those numbers mean (within what deviation a size is acceptable, when two estimates agree
    enough, whether a distance was assumed) is the agent's reading, guided by anomaly-catalog.md §2.7.

    The distance is never assumed (CE-028): derive it from the frame (the surface the product stands
    on, a same-plane neighbour of known size) and say how with `--distance-basis "<how d was
    derived>"`; the text is recorded with the numbers.

    Geometry (approximate, 9:16 portrait, 35 mm-equivalent focal length f): the frame height covers
    36·d/f metres at distance d, so a product of height H fills H·f/(36·d) of the frame height."""
    if a.product_cm is None or a.product_cm <= 0:
        fail("--product-cm (the product's real height in cm, from the registry) is required", 2)
    H = a.product_cm / 100.0
    f = a.lens
    frame_h = a.frame_h
    if a.frame:
        im = media_summary(Path(a.frame))
        if im.get("display_height"):
            frame_h = int(im["display_height"])
    res = {"ok": True, "product_cm": a.product_cm, "lens_mm_eq": f, "frame_h_px": frame_h,
           "label": a.label or "product", "notes": []}
    # 1. expected size from distance + lens
    if a.distance:
        frac = H * f / (36.0 * a.distance)
        res["distance_m"] = a.distance
        res["expected_fraction_of_frame_height"] = round(frac, 4)
        res["expected_px"] = round(frac * frame_h, 1)
        res["distance_basis"] = a.distance_basis or None
    shots = [("extreme close-up", 0.4), ("close-up", 0.7), ("medium close-up", 1.0), ("medium", 1.5),
             ("medium-wide", 2.5), ("wide", 4.0)]
    res["table"] = [{"shot": s, "distance_m": d, "fraction": round(H * f / (36.0 * d), 4),
                     "px": round(H * f / (36.0 * d) * frame_h, 1)} for s, d in shots]
    # 2. expected ratio to a neighbour of known size
    if a.ref_cm:
        ratio = (a.product_cm / a.ref_cm) / max(1e-6, a.depth_ratio)
        res["neighbour_cm"] = a.ref_cm
        res["depth_ratio"] = a.depth_ratio
        res["expected_ratio_to_neighbour"] = round(ratio, 3)
    # 3. observed, as a multiple of the expected size, per estimate
    estimates = []
    if a.product_px:
        ppx = _px_span(a.product_px, "--product-px")
        res["observed_px"] = round(ppx, 1)
        res["observed_fraction_of_frame_height"] = round(ppx / frame_h, 4)
        if a.ref_cm and a.ref_px:
            rpx = _px_span(a.ref_px, "--ref-px")
            obs_ratio = ppx / max(1e-6, rpx)
            res["neighbour_px"] = round(rpx, 1)
            res["observed_ratio_to_neighbour"] = round(obs_ratio, 3)
            res["size_vs_neighbour"] = round(obs_ratio / res["expected_ratio_to_neighbour"], 3)
            estimates.append({"basis": "neighbour ratio", "size_factor": res["size_vs_neighbour"],
                              "deviation_pct": round((res["size_vs_neighbour"] - 1.0) * 100.0, 1)})
        if a.distance:
            res["size_vs_distance"] = round((ppx / frame_h) / res["expected_fraction_of_frame_height"], 3)
            estimates.append({"basis": "distance+lens fraction", "size_factor": res["size_vs_distance"],
                              "deviation_pct": round((res["size_vs_distance"] - 1.0) * 100.0, 1)})
        if not estimates:
            res["notes"].append("observed size given, but nothing to compare it with: add --ref-cm/--ref-px or --distance")
    res["estimates"] = estimates
    if len(estimates) == 2:
        lo, hi = sorted(e["size_factor"] for e in estimates)
        res["estimates_spread_pct"] = round((hi / max(1e-6, lo) - 1.0) * 100.0, 1)
    if a.distance and not a.distance_basis:
        res["notes"].append("--distance-basis not stated: say how the distance was derived from the frame")
    if estimates:
        line = "; ".join(f"{e['basis']}: {e['size_factor']}x ({e['deviation_pct']:+.1f} %)" for e in estimates)
        print(f"size of {res['label']} as a multiple of the expected size - {line}", file=sys.stderr)
    if a.out:
        write_json(Path(a.out), res)
        res["file"] = a.out
    out(res)


def cmd_last_frame(a):
    """Hand-off frame for chaining clips: the exact LAST decoded frame of a clip (or the frame --back
    seconds earlier, when the final frames freeze, fade or morph) as a lossless PNG at native size.
    `frames --at` cannot do this: it stops short of the end and writes resized JPEGs."""
    try:
        n, fps = _count_frames(a.video)
    except RuntimeError as e:
        fail(str(e))
    if n < 1:
        fail("no decodable video frames", 1)
    back = int(round(max(0.0, a.back) * fps))
    k = n - 1 - back
    if k < 0:
        fail(f"--back {a.back} s goes before the first frame (clip has {n} frames at {fps:g} fps)", 2)
    dest = Path(a.out)
    if dest.suffix.lower() != ".png":
        fail("--out must be a .png file (lossless hand-off frame)", 2)
    dest.parent.mkdir(parents=True, exist_ok=True)
    cp = run([find_tool("ffmpeg"), "-nostdin", "-y", "-loglevel", "error", "-i", a.video, "-map", "0:v:0",
              "-vf", f"select=eq(n\\,{k})", "-fps_mode", "passthrough", "-frames:v", "1", str(dest)], timeout=900)
    if cp.returncode != 0 or not dest.exists():
        fail("ffmpeg failed: " + cp.stderr[-600:])
    im = media_summary(dest)
    res = {"ok": True, "file": str(dest), "frame_index": k, "total_frames": n, "fps": round(fps, 3),
           "t": round(k / fps, 3), "width": im.get("display_width"), "height": im.get("display_height"),
           "aspect": im.get("aspect")}
    if back:
        res["trim_end_s"] = round((k + 1) / fps, 3)
        res["note"] = (f"hand-off frame is {back} frame(s) before the end: trim the clip with "
                       f"`trim --end {res['trim_end_s']}` so it ends on this frame")
    out(res)


def cmd_concat(a):
    """Normalise clips to one format (WxH, fps, yuv420p, 48 kHz stereo AAC; silent track added when
    missing) and join them in the given order. Cuts are hard cuts: any transition must be planned.
    --seams marks each join: 'cut' (a planned hard cut, untouched) or 'continuous' (the next clip was
    chained from this clip's last frame): its first --seam-trim-frames frames, which repeat the
    hand-off frame, are dropped, and the audio gets a few-millisecond fade on both sides (no click)."""
    W, H = a.width, a.height
    joins = len(a.clips) - 1
    seams = [s.strip() for s in a.seams.split(",")] if a.seams else ["cut"] * joins
    if len(seams) != joins or any(s not in ("cut", "continuous") for s in seams):
        fail(f"--seams needs {joins} comma-separated value(s), each 'cut' or 'continuous'", 2)
    infos = [media_summary(c) for c in a.clips]
    rates = {round(i.get("fps") or 0, 2) for i in infos}
    fps = a.fps or (infos[0].get("fps") if len(rates) == 1 and infos[0].get("fps") else 30)
    work = Path(a.out).parent / "_concat"
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True, exist_ok=True)
    ff = find_tool("ffmpeg")
    parts = []
    for i, c in enumerate(a.clips):
        info = infos[i]
        if (info["display_width"], info["display_height"]) != (W, H):
            iw, ih = info["display_width"], info["display_height"]
            if abs(iw / ih - W / H) / (W / H) > 0.02:
                fail(f"clip {c} is {iw}x{ih}; conform it to {W}x{H} first (no stretching)", 2)
        p = work / f"part{i:02d}.mp4"
        after_cont = i > 0 and seams[i - 1] == "continuous"
        before_cont = i < joins and seams[i] == "continuous"
        head = a.seam_trim_frames if after_cont else 0
        t0 = head / (info.get("fps") or fps)
        vf = (f"trim=start_frame={head},setpts=PTS-STARTPTS," if head else "") + \
             f"scale={W}:{H}:force_original_aspect_ratio=increase:flags=lanczos,crop={W}:{H},setsar=1,fps={fps}"
        afl, d = [], a.audio_seam_fade_ms / 1000.0
        if head:
            afl.append(f"atrim=start={t0:.4f},asetpts=PTS-STARTPTS")
        part_dur = (info.get("duration_s") or 0) - t0
        if d > 0 and after_cont:
            afl.append(f"afade=t=in:st=0:d={d:.3f}")
        if d > 0 and before_cont and part_dur > 2 * d:
            afl.append(f"afade=t=out:st={part_dur - d:.3f}:d={d:.3f}")
        af = ["-af", ",".join(afl)] if afl else []
        if info.get("has_audio"):
            cmd = [ff, "-nostdin", "-y", "-loglevel", "error", "-i", c, "-vf", vf, *af, "-map", "0:v:0", "-map", "0:a:0",
                   *_encode_args(a.crf), "-c:a", "aac", "-ar", "48000", "-ac", "2", "-b:a", "192k", str(p)]
        else:
            cmd = [ff, "-nostdin", "-y", "-loglevel", "error", "-i", c, "-f", "lavfi", "-i",
                   "anullsrc=channel_layout=stereo:sample_rate=48000", "-vf", vf, "-map", "0:v:0", "-map", "1:a:0",
                   "-shortest", *_encode_args(a.crf), "-c:a", "aac", "-b:a", "192k", str(p)]
        cp = run(cmd, timeout=3600)
        if cp.returncode != 0:
            fail(f"normalising {c} failed: " + cp.stderr[-500:])
        parts.append(p)
    lst = work / "list.txt"
    lst.write_text("".join(f"file '{p.name}'\n" for p in parts), encoding="utf-8")
    cp = run([ff, "-nostdin", "-y", "-loglevel", "error", "-f", "concat", "-safe", "0", "-i", "list.txt", "-c", "copy",
              "-movflags", "+faststart", str(Path(a.out).resolve())], cwd=str(work), timeout=3600)
    if cp.returncode != 0:
        fail("concat failed: " + cp.stderr[-500:])
    o = media_summary(a.out)
    shutil.rmtree(work, ignore_errors=True)
    out({"ok": True, "file": a.out, "duration_s": o.get("duration_s"), "size": f"{o['display_width']}x{o['display_height']}",
         "fps": o.get("fps"), "seams": seams})


# --------------------------------------------------------------------------- CapCut project helpers (Analyze Mode)

MONTHS_EN = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]


def _capcut_store(explicit=None) -> Path:
    return Path(explicit or os.environ.get("CAPCUT_DRAFTS_DIR") or cfg_get("capcut.drafts_dir", "")
                or os.path.join(os.environ.get("LOCALAPPDATA", ""), "CapCut", "User Data", "Projects", "com.lveditor.draft"))


def cmd_capcut_name(a):
    """Free CapCut project name for one Analyze Mode video: DD_Mon_YYYY_vNN (e.g. 01_Oct_2026_v03), with
    -2, -3 … appended when that folder already exists in the drafts store. English month names, any locale."""
    try:
        d = dt.date.fromisoformat(a.date) if a.date else dt.date.today()
        nn = int(a.video)
    except ValueError:
        fail("--video must be a number and --date YYYY-MM-DD", 2)
    store = _capcut_store(a.store)
    if not store.is_dir():
        fail(f"CapCut drafts store not found: {store}", 2)
    base = f"{d.day:02d}_{MONTHS_EN[d.month - 1]}_{d.year}_v{nn:02d}"
    name, k = base, 1
    while (store / name).exists():
        k += 1
        name = f"{base}-{k}"
    out({"ok": True, "name": name, "path": str(store / name), "store": str(store)})


def cmd_capcut_prep(a):
    """Run right after capcut_clone_draft (empty:true) and before any other CapCut call on the new draft.
    The clone copies the template's identity sidecar (draft_meta_info.json: the TEMPLATE's draft id, name
    and folder) and its timeline_layout.json (the template's timeline id). Set both aside (*.atpbak), drop
    the template's build artefacts, and point the layout at the new timeline id, so that
    `capcut register --apply --materials` (after capcut_save) recreates a correct identity."""
    d = Path(a.draft)
    cp = d / "draft_content.json"
    if not cp.is_file():
        fail(f"not a CapCut draft (no draft_content.json): {d}", 2)
    if (d / ".locked").exists():
        fail("the draft is open in CapCut (.locked present): close CapCut first", 2)
    content = json.loads(cp.read_text(encoding="utf-8"))
    tid, name = content.get("id"), content.get("name")
    if not tid:
        fail("draft_content.json has no timeline id", 2)
    if name and name != d.name:
        fail(f"draft_content.json name {name!r} differs from the folder {d.name!r}: is this the fresh clone?", 2)
    moved = []
    for fn in ("draft_meta_info.json", "timeline_layout.json", "build-report.json", "build.log", "lint.json"):
        f = d / fn
        if f.exists():
            os.replace(f, d / (fn + ".atpbak"))
            moved.append(fn)
    write_json(d / "timeline_layout.json", {"dockItems": [{"dockIndex": 0, "ratio": 1, "timelineIds": [tid],
                                                           "timelineNames": ["Timeline 01"]}], "layoutOrientation": 1})
    out({"ok": True, "draft": str(d), "timeline_id": tid, "name": name, "set_aside": moved,
         "next": "capcut_read_timeline → edits → capcut_validate → capcut_save, then: atg.py capcut-repair "
                 "--draft \"<draft>\" --preview \"<run>/60-outputs/video-NN/capcut-preview.mp4\""})


def _capcut_cli() -> str:
    exe = shutil.which("capcut")
    if exe:
        return exe
    for cand in (os.path.join(os.environ.get("APPDATA", ""), "npm", "capcut.cmd"),):
        if os.path.exists(cand):
            return cand
    fail("capcut-cli not found on PATH (npm i -g capcut-cli)", 1)


def _last_json(text: str):
    for line in reversed((text or "").strip().splitlines()):
        line = line.strip()
        if line.startswith("{"):
            try:
                return json.loads(line)
            except Exception:
                continue
    return None


def cmd_capcut_repair(a):
    """After every capcut_save: the house text style on every text layer (capcut-text-style), then
    `capcut register --apply --materials` (identity from draft_content.json,
    the media list CapCut needs, the store index), `capcut sync-timelines --nested --apply` (the nested
    timeline copy CapCut 9.x reads first) and `capcut lint`. register rewrites the store's SHARED
    root_meta_info.json, so all three run under one machine-wide lock: production agents assemble their
    projects in parallel. --preview then renders capcut-cli's low-res proxy (outside the lock)."""
    d = Path(a.draft)
    if not (d / "draft_content.json").is_file():
        fail(f"not a CapCut draft (no draft_content.json): {d}", 2)
    cli = _capcut_cli()
    if (d / ".locked").exists() or _capcut_running():
        out({"ok": False, "draft": str(d), "steps": [],
             "action": "CapCut is running: close it and run this again (nothing was changed)"}, 1)
    lock = Path(cfg_get("runs_root", str(Path(__file__).resolve().parent.parent / "runs"))) / ".capcut-store.lock"
    lock.parent.mkdir(parents=True, exist_ok=True)
    steps = [{"step": "text-style", "exit": 0, "result": _text_style_pass(d, write=True)}]   # before sync-timelines
    with FileLock(lock, timeout=900):
        for name, args in (("register", ["register", str(d), "--apply", "--materials"]),
                           ("sync-timelines", ["sync-timelines", str(d), "--nested", "--apply"]),
                           ("lint", ["lint", str(d)])):
            cp = run([cli, *args], timeout=900)
            steps.append({"step": name, "exit": cp.returncode,
                          "result": _last_json(cp.stdout) or (cp.stdout or "").strip()[-800:],
                          "stderr": (cp.stderr or "").strip()[-400:]})
            if name != "lint" and cp.returncode != 0:
                break
    codes = {s["step"]: s["exit"] for s in steps}
    ok = codes.get("register") == 0 and codes.get("sync-timelines") == 0 and codes.get("lint") in (0, 1)
    res = {"ok": ok, "draft": str(d), "steps": steps}
    if not ok:
        res["action"] = ("a step refused or lint found errors: CapCut running → close it and run this again; "
                         "lint errors → fix the timeline through the MCP, capcut_save, then run this again")
    elif a.preview:
        Path(a.preview).parent.mkdir(parents=True, exist_ok=True)
        cp = run([cli, "render", str(d), "--out", a.preview, "--burn-captions"], timeout=1800)
        res["preview"] = {"exit": cp.returncode, "file": a.preview if cp.returncode == 0 else None,
                          "result": _last_json(cp.stdout), "stderr": (cp.stderr or "").strip()[-400:]}
    out(res, 0 if ok else 1)


# --------------------------------------------------------------------------- CapCut house text style

HOUSE_TEXT_DEFAULT = {"font": "System", "size": 10, "fill": "#FFFFFF",
                      "stroke": {"color": "#000000", "width": 0.08}}
# material-level keys that a CapCut font / preset choice sets (copied by --learn from a text the user styled)
_TEXT_STYLE_KEY = re.compile(r"^(font_|fonts$|text_color$|text_alpha$|has_border$|border_|has_shadow$|shadow_|"
                             r"background_|bold_width$|italic_degree$|underline|letter_spacing$|line_spacing$|"
                             r"preset_|style_name$|check_flag$|use_effect_default_color$|text_preset_resource_id$|"
                             r"global_alpha$|ktv_color$|effect_style$)")


def _house_text_style() -> dict:
    st = {**HOUSE_TEXT_DEFAULT, **(cfg_get("capcut.text_style") or {})}
    st["stroke"] = {**HOUSE_TEXT_DEFAULT["stroke"], **(st.get("stroke") or {})}
    return st


def _capcut_system_font() -> str:
    """CapCut's 'System' font, the one a fresh text gets: <CapCut>/Apps/<newest version>/Resources/Font/SystemFont/en.ttf."""
    found = []
    for d in (Path(os.environ.get("LOCALAPPDATA", "")) / "CapCut" / "Apps").glob("*"):
        f = d / "Resources" / "Font" / "SystemFont" / "en.ttf"
        if f.is_file():
            try:
                found.append((tuple(int(x) for x in d.name.split(".")), f))
            except ValueError:
                continue
    return str(max(found)[1]).replace("\\", "/") if found else ""


def _capcut_running() -> bool:
    if os.name != "nt":
        return False
    try:
        return "capcut.exe" in (run(["tasklist", "/FI", "IMAGENAME eq CapCut.exe", "/NH"], timeout=30).stdout or "").lower()
    except Exception:
        return False


def _hex_rgb(h: str) -> list:
    h = h.lstrip("#")
    return [round(int(h[i:i + 2], 16) / 255, 6) for i in (0, 2, 4)]


def _house_text_material(m: dict, st: dict, font_path: str) -> bool:
    """Rewrite one text material to the house style; True when it changed. The text, its ranges, position
    and timing stay; font, size, fill, outline, shadow, background and preset fields become the house ones."""
    before = json.dumps(m, sort_keys=True)
    size = float(st["size"])
    learned = st.get("learned") or {}
    lmat, lsty = learned.get("material") or {}, learned.get("style")
    if lmat:
        for k, v in lmat.items():
            m[k] = json.loads(json.dumps(v))
    else:
        m.update({"font_name": "", "font_title": "none", "font_id": "", "font_resource_id": "",
                  "font_category_id": "", "font_category_name": "", "font_source_platform": 0,
                  "font_team_id": "", "font_url": "", "fonts": [],
                  "text_color": st["fill"], "text_alpha": 1.0, "has_border": True,
                  "border_color": st["stroke"]["color"], "border_width": st["stroke"]["width"], "border_alpha": 1.0,
                  "has_shadow": False, "background_alpha": 0.0, "background_style": 0})
    m["font_path"] = font_path
    m["font_size"] = size
    try:
        content = json.loads(m.get("content") or "{}")
    except Exception:
        content = {}
    text = content.get("text", "")
    styles = []
    for old in (content.get("styles") or [{"range": [0, len(text)]}]):
        if lsty is not None:
            ns = json.loads(json.dumps(lsty))
        else:
            ns = {"fill": {"alpha": 1.0, "content": {"render_type": "solid",
                                                     "solid": {"alpha": 1.0, "color": _hex_rgb(st["fill"])}}},
                  "strokes": [{"content": {"render_type": "solid",
                                           "solid": {"alpha": 1.0, "color": _hex_rgb(st["stroke"]["color"])}},
                               "width": st["stroke"]["width"]}],
                  "useLetterColor": True}
        ns["range"] = old.get("range", [0, len(text)])
        ns["size"] = size
        ns["font"] = {"id": "", "path": font_path}
        styles.append(ns)
    content["styles"] = styles
    m["content"] = json.dumps(content, ensure_ascii=False, separators=(",", ":"))
    return json.dumps(m, sort_keys=True) != before


def _draft_contents(d: Path) -> list:
    """The root draft_content.json plus CapCut 9.x's nested timeline copies."""
    return [p for p in [d / "draft_content.json", *sorted((d / "Timelines").glob("*/draft_content.json"))] if p.is_file()]


def _text_style_pass(d: Path, write: bool) -> dict:
    st = _house_text_style()
    font = _capcut_system_font() or (st.get("learned") or {}).get("font_path") or ""
    if not font:
        fail("CapCut's System font was not found (<LOCALAPPDATA>/CapCut/Apps/<version>/Resources/Font/SystemFont/en.ttf)", 1)
    files, changed_ids = [], set()
    for p in _draft_contents(d):
        content = json.loads(p.read_text(encoding="utf-8"))
        changed = [m.get("id") for m in content.get("materials", {}).get("texts", [])
                   if _house_text_material(m, st, font)]
        changed_ids.update(changed)
        if changed and write:
            shutil.copyfile(p, p.with_name(p.name + ".textstyle.bak"))
            write_text(p, json.dumps(content, ensure_ascii=False))
        files.append({"file": str(p), "texts_off_style": len(changed)})
    return {"font": font, "size": st["size"], "preset": "learned" if st.get("learned") else "default (not calibrated)",
            "files": files, "texts_off_style": len(changed_ids), "written": bool(write and changed_ids)}


def _learn_text_style(d: Path, which, replace: bool = False) -> dict:
    """Copy the exact style of a text the user styled once in CapCut (font System, the wanted preset).
    A learned preset the user locked (capcut.text_style.locked) is only replaced with --replace."""
    cur = cfg_get("capcut.text_style") or {}
    if cur.get("learned") and cur.get("locked") and not replace:
        fail(f"the house text preset is locked (learned from {cur['learned'].get('from')}); the user chose it for "
             "every video. Pass --replace only when the user asks for a different preset", 3)
    src = max(_draft_contents(d), key=lambda p: p.stat().st_mtime, default=None)
    if not src:
        fail(f"not a CapCut draft (no draft_content.json): {d}", 2)
    content = json.loads(src.read_text(encoding="utf-8"))
    texts = content.get("materials", {}).get("texts", [])
    if not texts:
        fail("no text in that draft: add one text in CapCut, pick the preset, close CapCut, then --learn again", 2)
    if which is not None:
        if not 1 <= which <= len(texts):
            fail(f"--text must be 1..{len(texts)}", 2)
        m = texts[which - 1]
    else:
        withp = [t for t in texts if t.get("preset_id") or t.get("preset_name") or t.get("style_name")]
        if len(withp) == 1 or len(texts) == 1:
            m = (withp or texts)[0]
        else:
            listing = []
            for i, t in enumerate(texts, 1):
                try:
                    txt = json.loads(t.get("content") or "{}").get("text", "")
                except Exception:
                    txt = ""
                listing.append(f"{i}: {txt[:30]!r}")
            fail("several texts in that draft; pick one with --text N: " + "; ".join(listing), 2)
    mat = {k: v for k, v in m.items() if _TEXT_STYLE_KEY.match(k) and k not in ("font_path", "font_size")}
    if m.get("preset_has_set_alignment"):
        mat["alignment"] = m.get("alignment")
    try:
        sty = dict((json.loads(m.get("content") or "{}").get("styles") or [{}])[0])
    except Exception:
        sty = {}
    for k in ("range", "size", "font"):
        sty.pop(k, None)
    refs = []
    for tr in content.get("tracks", []):
        for seg in tr.get("segments", []):
            if seg.get("material_id") == m.get("id"):
                for rid in seg.get("extra_material_refs", []):
                    for kind, lst in content.get("materials", {}).items():
                        if isinstance(lst, list):
                            for x in lst:
                                if isinstance(x, dict) and x.get("id") == rid:
                                    refs.append({"kind": kind, "type": x.get("type")})
    learned = {"from": f"{d.name} / text {m.get('id')}", "at": now_iso(), "font_path": m.get("font_path"),
               "material": mat, "style": sty, "segment_refs": refs}
    cfg = load_config()
    cfg.setdefault("capcut", {}).setdefault("text_style", {})["learned"] = learned
    write_text(CONFIG_PATH, json.dumps(cfg, ensure_ascii=False, indent=2) + "\n")
    extra = [r for r in refs if r["kind"] in ("effects", "text_templates") or "text" in str(r["type"]).lower()]
    return {"learned_from": learned["from"], "preset_fields": {k: v for k, v in mat.items() if k.startswith("preset_")},
            "style_keys": sorted(sty), "segment_refs": refs,
            "warning": ("the preset also uses extra material(s) " + json.dumps(extra) + ": tell Claude, they are not copied yet")
            if extra else None}


def cmd_capcut_text_style(a):
    """House style for every CapCut text layer: font System, size 10, and the user's chosen preset, stored in
    config.json (capcut.text_style.learned; locked). Rewrites every text material of the draft (root and nested
    timeline copies); capcut-repair runs it before register/sync. --check only reports. --learn copies the
    exact preset fields from a text the user styled once in CapCut; a locked preset needs --replace."""
    d = Path(a.draft)
    if not (d / "draft_content.json").is_file():
        fail(f"not a CapCut draft (no draft_content.json): {d}", 2)
    if a.learn:
        out({"ok": True, **_learn_text_style(d, a.text, a.replace)})
    if not a.check and ((d / ".locked").exists() or _capcut_running()):
        fail("CapCut is running: close it, then run this again", 3)
    res = _text_style_pass(d, write=not a.check)
    out({"ok": True, "draft": str(d), **res}, 1 if a.check and res["texts_off_style"] else 0)


def cmd_strip_inserts(a):
    """The reference minus its inserts (memes, film/TV snippets, reaction images from other sources), in
    ONE pass at the original resolution and fps: <out>/own.mp4 (original audio kept), <out>/own-silent.mp4
    (the copy to upload) and <out>/map.json (where each insert goes back: its split point in the stripped
    timeline, its source in/out). Used by Recreate (the edit source) and for split-point maths."""
    info = media_summary(a.video)
    dur = info.get("duration_s") or 0
    spans = []
    for s in a.inserts.split(","):
        m = re.match(r"^\s*([0-9.]+)\s*-\s*([0-9.]+)\s*$", s)
        if not m:
            fail(f"bad insert range {s!r}; use start-end in seconds, comma-separated", 2)
        t0, t1 = float(m.group(1)), min(float(m.group(2)), dur)
        if not (0 <= t0 < t1):
            fail(f"insert {s!r} is outside the video (0-{dur:.3f} s)", 2)
        spans.append((t0, t1))
    spans.sort()
    for (x0, x1), (y0, y1) in zip(spans, spans[1:]):
        if y0 < x1:
            fail(f"inserts overlap: {x0}-{x1} and {y0}-{y1}", 2)
    od = Path(a.out)
    od.mkdir(parents=True, exist_ok=True)
    expr = "+".join(f"gte(t\\,{t0:.4f})*lt(t\\,{t1:.4f})" for t0, t1 in spans)
    ff = find_tool("ffmpeg")
    own, silent = od / "own.mp4", od / "own-silent.mp4"
    cmd = [ff, "-nostdin", "-y", "-loglevel", "error", "-i", a.video, "-map", "0:v:0",
           "-vf", f"select=not({expr}),setpts=N/FRAME_RATE/TB"]
    if info.get("has_audio"):
        cmd += ["-map", "0:a:0", "-af", f"aselect=not({expr}),asetpts=N/SR/TB", "-c:a", "aac", "-b:a", "192k"]
    cmd += [*_encode_args(a.crf), str(own)]
    cp = run(cmd, timeout=3600)
    if cp.returncode != 0:
        fail("ffmpeg failed: " + cp.stderr[-600:])
    cp = run([ff, "-nostdin", "-y", "-loglevel", "error", "-i", str(own), "-map", "0:v:0", "-c:v", "copy", "-an",
              str(silent)], timeout=600)
    if cp.returncode != 0:
        fail("ffmpeg (silent copy) failed: " + cp.stderr[-600:])
    removed, inserts = 0.0, []
    for i, (t0, t1) in enumerate(spans, 1):
        inserts.append({"insert": i, "source_in": round(t0, 3), "source_out": round(t1, 3),
                        "duration": round(t1 - t0, 3), "split_at": round(t0 - removed, 3)})
        removed += t1 - t0
    o = media_summary(own)
    mp = {"source": str(a.video), "source_duration": round(dur, 3), "own_duration": o.get("duration_s"),
          "expected_own_duration": round(dur - removed, 3), "inserts": inserts,
          "own": str(own), "own_silent": str(silent)}
    write_json(od / "map.json", mp)
    out({"ok": True, **mp, "map": str(od / "map.json")})


# --------------------------------------------------------------------------- submission ledger (anti-duplicate)

LEDGER_OPEN = {"pending", "submitted", "unknown"}          # outcome not final yet → counted as open (in flight)
LEDGER_DONE_OK = {"completed", "accepted"}                  # a finished, usable job for this exact request


def _fingerprint(req: dict) -> str:
    params = dict(req.get("params", req))
    params.pop("get_cost", None)
    blob = json.dumps(params, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()[:20]


def _lane(video) -> str:
    """Ledger lane = the video number: '03', '03-c2' (clip 2) and '03-frame' share lane '03'."""
    return str(video).split("-")[0]


def cmd_ledger(a):
    """Record of every paid Higgsfield generation (generate_video, and generate_image for start frames), kept so that parallel production
    agents can see each other. state.json is written under a lock. The ledger RECORDS and REPORTS; it never refuses and never decides: whether to
    submit is the agent's decision, taken from the production rules of the mode.
    begin  : records a 'pending' entry (call it immediately BEFORE the generation call) and reports what the ledger already holds that bears on
             it, as facts: `conflicts` lists, with the entries involved, an open submission (pending/submitted/unknown) in this video's lane, the
             number of open submissions in the run against `production.max_parallel_jobs` (config, default 5; `--max-open` overrides), the
             number of times this exact request (the same fingerprint) failed, and a finished job (completed/accepted) of this exact request.
             An agent that decides not to submit records that with `set --status superseded --note "why"`, which also frees the lane.
    set    : record the job id / outcome right AFTER the call and after polling
             (submitted | unknown | completed | failed | accepted | rejected | superseded).
    show   : list entries (optionally one video)."""
    p = Path(a.run) / "state.json"
    if not p.exists():
        fail(f"state.json not found in {a.run}", 2)
    if a.action == "show":
        led = json.loads(p.read_text(encoding="utf-8")).get("submissions", [])
        rows = [e for e in led if not a.video or e["video"] == a.video]
        out({"ok": True, "entries": rows, "open": [e for e in rows if e["status"] in LEDGER_OPEN]})
    with FileLock(p.with_name("state.json.lock")):
        _ledger_write(a, p)


def _ledger_write(a, p: Path):
    st = json.loads(p.read_text(encoding="utf-8"))
    led = st.setdefault("submissions", [])
    if a.action == "begin":
        if not a.request or not a.video:
            fail("begin needs --video and --request", 2)
        req = json.loads(Path(a.request).read_text(encoding="utf-8"))
        fp = _fingerprint(req)
        lane = a.lane or _lane(a.video)
        open_all = [e for e in led if e["status"] in LEDGER_OPEN]
        open_lane = [e for e in open_all if (e.get("lane") or _lane(e["video"])) == lane]
        cap = a.max_open or int(cfg_get("production.max_parallel_jobs", 5))
        failed = [e for e in led if e["fingerprint"] == fp and e["status"] == "failed"]
        dup = [e for e in led if e["fingerprint"] == fp and e["status"] in LEDGER_DONE_OK]
        conflicts = []
        if open_lane:
            conflicts.append({"what": "an open submission in this video's lane", "entries": open_lane})
        if len(open_all) >= cap:
            conflicts.append({"what": "submissions in flight in this run against the cap", "open": len(open_all), "cap": cap})
        if failed:
            conflicts.append({"what": "this exact request failed before", "times": len(failed), "entries": failed})
        if dup:
            conflicts.append({"what": "this exact request already produced a finished job", "entry": dup[-1]})
        entry = {"video": a.video, "lane": lane, "attempt": a.attempt, "fingerprint": fp, "status": "pending",
                 "job_id": None, "model": (req.get("params", req)).get("model"),
                 "request_file": str(Path(a.request).resolve()), "created": now_iso(), "history": [],
                 "conflicts_seen": [c["what"] for c in conflicts]}
        led.append(entry)
        st["updated"] = now_iso()
        write_json(p, st)
        out({"ok": True, "recorded": True, "fingerprint": fp, "entry": entry, "conflicts": conflicts,
             "open_in_run": len(open_all) + 1, "cap": cap,
             "note": "recorded as pending, nothing was refused: whether to submit is your decision from the conflicts listed, under the mode's production rules "
                     "(one job in flight per video; not past the cap; not the same request again once it produced a finished job; diagnose before another attempt). "
                     "If you decide not to submit, record it: ledger set --fingerprint ... --status superseded --note \"why\""})
    elif a.action == "set":
        if not a.fingerprint and not a.job:
            fail("set needs --fingerprint or --job", 2)
        hits = [e for e in led if (a.fingerprint and e["fingerprint"] == a.fingerprint)
                or (a.job and e.get("job_id") == a.job)]
        if not hits:
            fail("no ledger entry matches", 2)
        e = hits[-1]
        e["history"].append({"at": now_iso(), "from": e["status"], "to": a.status, "note": a.note})
        e["status"] = a.status
        if a.job:
            e["job_id"] = a.job
        st["updated"] = now_iso()
        write_json(p, st)
        out({"ok": True, "entry": e})


def cmd_open(a):
    """Open a finished video in the user's default player so they can review it."""
    f = Path(a.file)
    if not f.exists():
        fail(f"file not found: {f}", 2)
    if a.dry_run:
        out({"ok": True, "would_open": str(f.resolve())})
    try:
        if sys.platform.startswith("win"):
            os.startfile(str(f.resolve()))  # type: ignore[attr-defined]
        elif sys.platform == "darwin":
            subprocess.Popen(["open", str(f)])
        else:
            subprocess.Popen(["xdg-open", str(f)])
        out({"ok": True, "opened": str(f.resolve())})
    except Exception as e:
        fail(f"could not open: {e}", 1, file=str(f.resolve()))


# --------------------------------------------------------------------------- model menu

OPS_SHORT = {"t2v": "text", "start_frame": "first-frame", "end_frame": "last-frame", "image_refs": "image-refs",
             "video_refs": "video-refs", "audio_refs": "audio-refs", "elements": "Elements",
             "video_edit": "video-edit", "video_extension": "extend", "object_replace": "object-swap",
             "motion_transfer": "motion-transfer", "multi_shot": "multi-shot"}


def _edit_fit(e: dict) -> str:
    kind = (e.get("edit_kind") or "none").lower()
    if kind.startswith("pixel-preserving"):
        return "✓ edits video"
    if kind.startswith("recreate"):
        return "≈ recreates from video ref"
    if kind.startswith("motion-transfer"):
        return "↔ motion transfer"
    if kind.startswith("video continuation"):
        return "≈ continues/recreates"
    return "✗ frames only"


def cmd_model_menu(a):
    """Print EVERY available video model as one numbered table (pinned models first), plus a JSON line
    with the numbering and the pinned ids. Live catalog ids (from models_explore) mark availability and add
    models that have no guide yet. It does not pick a model: which ones to offer is the agent's decision."""
    idx = json.loads((ATG_HOME / "models" / "index.json").read_text(encoding="utf-8"))
    models = idx["models"]
    menu = idx.get("menu", {})
    order = [m for m in menu.get("order", []) if m in models] + [m for m in models if m not in menu.get("order", [])]
    pinned = set(menu.get("pinned", []))
    live = None
    if a.live_ids:
        live = {x.strip() for x in re.split(r"[,\s]+", a.live_ids) if x.strip()}
    elif a.live_file:
        data = json.loads(Path(a.live_file).read_text(encoding="utf-8"))
        items = data.get("items", data) if isinstance(data, dict) else data
        live = {it["id"] if isinstance(it, dict) else str(it) for it in items}
    skip = set(idx.get("not_selectable", {}).get("utility", [])) | {"higgsfield_preset"}
    rows, unavailable, n = [], [], 0
    for mid in order:
        e = models[mid]
        if live is not None and mid not in live:
            unavailable.append(mid)
            continue
        n += 1
        ops = [OPS_SHORT[o] for o in e.get("operations", []) if o in OPS_SHORT]
        dur = e.get("duration_s")
        dur = "/".join(map(str, dur)) if isinstance(dur, list) else str(dur)
        note = e.get("status", "active")
        note = "" if note == "active" else f"[{note}] "
        best = (e.get("best_for") or "")
        rows.append({"n": n, "id": mid, "star": mid in pinned, "name": e.get("name", mid),
                     "provider": e.get("provider", ""), "ops": ", ".join(ops), "dur": dur[:34],
                     "audio": "yes" if "native_audio" in e.get("operations", []) else "—",
                     "analyze": "✓" if "analyze" in e.get("modes", []) else "edit-only",
                     "edit": _edit_fit(e), "note": (note + best)[:90]})
    for mid in sorted((live or set()) - set(models) - skip):
        n += 1
        rows.append({"n": n, "id": mid, "star": False, "name": mid, "provider": "?", "ops": "see live catalog",
                     "dur": "?", "audio": "?", "analyze": "?", "edit": "?",
                     "note": "no guide yet — conservative fallback guide"})
    mode = a.mode or "analyze"
    lines = [f"**All available video models** ({len(rows)}) — mode: {mode}. ★ = pinned. Reply with a number or a name.",
             "", "| # | Model | id | What it can do | Length (s) | Audio | Analyze | Edit | Notes |",
             "|---|---|---|---|---|---|---|---|---|"]
    for r in rows:
        star = "★ " if r["star"] else ""
        lines.append(f"| {r['n']} | {star}{r['name']} ({r['provider']}) | `{r['id']}` | {r['ops']} | {r['dur']} | "
                     f"{r['audio']} | {r['analyze']} | {r['edit']} | {r['note']} |")
    if unavailable:
        lines += ["", "Not in the live catalog right now: " + ", ".join(f"`{u}`" for u in unavailable)]
    print("\n".join(lines))
    out({"ok": True, "count": len(rows), "pinned": [r["id"] for r in rows if r["star"]],
         "numbers": {str(r["n"]): r["id"] for r in rows}, "unavailable": unavailable})


# --------------------------------------------------------------------------- Viral-Browser (analyze_submode=viral-browser)
# The references are a source of IDEAS here, not material to edit or imitate. THE RULE OF THIS WHOLE TOOLKIT (user, 2026-10-12): scripts gather,
# extract, record, tabulate and calculate; they never evaluate. Nothing in this block compares two texts for sameness, counts words to find a winner,
# applies a threshold that refuses or changes an answer, ranks, or hands out a status, a flag or a verdict. What a card says, which labels are one niche,
# whether evidence is enough, which candidate wins and why are decisions of the AGENTS that run the pipeline (reference/viral-browser.md sections 5 and 8);
# the ledgers below record those decisions with who, when and why, and the tables put the recorded values side by side.
# Allowed here: measuring prepared videos (viral-stats), keeping the candidate, evidence, niche, specification and photo-link ledgers, probing a link with
# a header request, reading a page for the image addresses it declares, and pure formulas (unit conversion, unit economics).

VB_DEFAULTS = {
    # Only the NAMES the scripts need. Every number that used to gate, cap or rank an answer (pool shares, dominance thresholds, score floors, evidence
    # caps, tolerances, minimum angles ...) is guidance for the agents now: it lives in config.json under viral_browser.rules_of_thumb and in
    # reference/viral-browser.md, is applied by the agent that runs the pipeline, and is recorded with the reason.
    "rubric": {"demand": 15, "commercial": 15, "fit": 20, "economics": 15, "competition": 10,
               "compliance": 10, "logistics": 5, "timing": 5, "producibility": 5},      # the rating criteria `candidates rate` accepts; the weights feed the optional weighted-sum column
    "spec_core_fields": ["width", "height", "depth", "length", "diameter", "thickness", "weight", "material", "texture", "finish", "usage"],     # the rows of `spec gaps`
    "photo_core_angles": ["front", "back", "left", "right", "top"],                                                                              # the columns of the photo coverage table
}
VB_REPLACE_KEYS = {"rubric", "spec_core_fields", "photo_core_angles"}
EV_LANES = ["demand", "commercial", "competition", "economics", "compliance", "logistics", "voice", "content",
            "timing", "fit", "other"]
CAND_STATUS = ["long", "shortlisted", "researching", "researched", "eliminated", "picked", "runner-up", "watch"]
CAND_ORIGINS = ["reference", "mechanism", "trend-feed", "problem-scan", "variant", "other"]
CONF_ORDER = {"low": 0, "medium": 1, "high": 2}
FACT_KEYS = ["category", "product_form", "price_tier", "format", "creator_style", "creator_group", "hook_type",
             "demo_type", "cta", "commerce_signal", "driver_primary", "dependence_on_product", "claims_risk",
             "awareness_stage", "platform", "voice_type"]
FACTS_RX = re.compile(r"^Facts:\s*(\{.*\})\s*$", re.M)


def _deep_merge(base: dict, over: dict) -> dict:
    for k, v in over.items():
        if k in VB_REPLACE_KEYS or not (isinstance(v, dict) and isinstance(base.get(k), dict)):
            base[k] = v
        else:
            _deep_merge(base[k], v)
    return base


def vb_cfg() -> dict:
    return _deep_merge(json.loads(json.dumps(VB_DEFAULTS)), cfg_get("viral_browser", {}) or {})


def _vb_dir(run) -> Path:
    d = Path(run) / "30-research"
    d.mkdir(parents=True, exist_ok=True)
    return d


import unicodedata


def _norm(s) -> str:
    return re.sub(r"\s+", " ", unicodedata.normalize("NFKC", str(s or "")).strip().casefold())


VB_LEDGER_FILES = {"candidates.json", "evidence.json", "niche-vocabulary.json", "specs.json", "photos.json"}


def _vb_load(path: Path, default):
    d = None
    for attempt in range(20):
        try:
            d = json.loads(path.read_text(encoding="utf-8"))
            break
        except FileNotFoundError:
            return default
        except ValueError as e:
            if path.name in VB_LEDGER_FILES:       # never read a damaged ledger as empty: the next write would destroy it
                fail(f"{path.name} is unreadable ({e}); nothing was changed. Restore it from a backup or repair the JSON before going on", 1)
            return default
        except OSError as e:                       # busy for a moment (another process is replacing it): wait, then stop rather than read it as empty
            if attempt == 19:
                if path.name in VB_LEDGER_FILES:
                    fail(f"{path.name} cannot be read right now ({e}); nothing was changed. Try again", 1)
                return default
            time.sleep(0.05)
    if path.name in VB_LEDGER_FILES:
        shape_ok = isinstance(d, dict) and (isinstance(d.get("niches", {}), dict) if path.name == "niche-vocabulary.json" else isinstance(d.get("items"), list))
        if not shape_ok:
            fail(f"{path.name} does not have the expected structure; nothing was changed. Restore it from a backup or repair it before going on", 1)
    return d


def _fold(s) -> str:
    """NFKC and casefold; every character that is not a letter, a digit or a combining mark becomes a space ('&' reads as 'and').
    Combining marks stay: the vowel signs of Indic scripts and the harakat of Arabic would otherwise split one word and merge two others."""
    s = unicodedata.normalize("NFKC", str(s or "")).casefold().replace("&", " and ")
    return re.sub(r"\s+", " ", "".join(ch if unicodedata.category(ch)[0] in "LNM" else " " for ch in s)).strip()


def _niche_key(label) -> str:
    return _fold(label)


def _has_word(label) -> bool:
    return any(unicodedata.category(ch)[0] in "LN" for ch in _fold(label))


def _vocab_path(run) -> Path:
    return Path(run) / "20-analysis" / "niche-vocabulary.json"


def _vocab_load(run) -> dict:
    d = _vb_load(_vocab_path(run), {"niches": {}})
    d.setdefault("niches", {})
    return d


def _vocab_index(vocab: dict) -> dict:
    """normalised label -> canonical niche, over the canonical names and every member label."""
    idx = {}
    for canon, rec in vocab["niches"].items():
        idx[_niche_key(canon)] = canon
        for m in rec.get("members", []):
            idx[_niche_key(m)] = canon
    return idx


def _niche(label, run):
    """The canonical niche of a label as the AGENTS recorded it in the run's niche vocabulary (`niches add`, `niches map`), as (name, None), or
    (None, reason) when the label is empty or not recorded yet. A lookup in the agents' record: it compares nothing and decides nothing, and what counts
    as the same niche is the agents' judgement, recorded as data. Nothing about niches, products or categories is built into this script."""
    vocab = _vocab_load(run)
    k = _niche_key(label)
    if not k:
        return None, "label is empty"
    idx = _vocab_index(vocab)
    if k in idx:
        return idx[k], None
    known = ", ".join(sorted(vocab["niches"])) or "none yet"
    return None, f"{str(label)!r} is not recorded in this run's niche vocabulary yet (recorded niches: {known})"


def _domain(src) -> str:
    s = str(src or "").strip()
    if re.match(r"^https?://", s, re.I):
        from urllib.parse import urlparse
        h = urlparse(s).netloc.lower()
        return h[4:] if h.startswith("www.") else h
    return "method"


SITE_SECOND_LEVEL = {"co", "com", "org", "net", "gov", "edu", "ac", "or", "ne", "go"}


def _site_key(src) -> str:
    """The site behind an address, for independence: the label before the public suffix, so brand.example, www.brand.example, shop.brand.example and
    brand.co.xx are one site, while the maker's page and a retailer's page are two."""
    from urllib.parse import urlsplit
    sv = str(src or "").strip()
    if not re.match(r"^https?://", sv, re.I):
        return "method"
    host = (urlsplit(sv).hostname or "").lower()
    labels = [x for x in host.split(".") if x]
    if len(labels) <= 1:
        return host or "method"
    suffix = 2 if len(labels) >= 3 and len(labels[-1]) == 2 and labels[-2] in SITE_SECOND_LEVEL else 1
    return labels[-(suffix + 1)] if len(labels) > suffix else labels[0]


def _num(v):
    try:
        if v is None or isinstance(v, bool):
            return None
        f = float(v)
        return f if math.isfinite(f) else None
    except (TypeError, ValueError):
        return None


def _quant(vals, q):
    vals = sorted(vals)
    if not vals:
        return None
    if len(vals) == 1:
        return vals[0]
    pos = (len(vals) - 1) * q
    lo, hi = int(math.floor(pos)), int(math.ceil(pos))
    return vals[lo] + (vals[hi] - vals[lo]) * (pos - lo)


def _dist(vals, nd=2):
    vals = [v for v in (_num(x) for x in vals) if v is not None]
    if not vals:
        return None
    return {"n": len(vals), "min": round(min(vals), nd), "p25": round(_quant(vals, .25), nd),
            "median": round(_quant(vals, .5), nd), "mean": round(sum(vals) / len(vals), nd),
            "p75": round(_quant(vals, .75), nd), "max": round(max(vals), nd)}


def _share(flags):
    flags = [f for f in flags if f is not None]
    if not flags:
        return None
    y = sum(1 for f in flags if f)
    return {"n": len(flags), "yes": y, "share": round(y / len(flags), 3)}


def _vs_measure(vdir: Path):
    """Machine measurements of one prepared video (video.json from prep-video, audio-profile.json and transcript.json if present): numbers only."""
    vj = vdir / "video.json"
    if not vj.exists():
        return None
    j = _vb_load(vj, {})
    pr, pa, hk = j.get("probe") or {}, j.get("pacing") or {}, j.get("hook") or {}
    au, sp = j.get("audio") or {}, j.get("speech") or {}
    dur = _num(pr.get("duration_s"))
    spans = j.get("ocr_spans") or []
    text_first = (any((_num(x.get("first_t")) if _num(x.get("first_t")) is not None else 99) <= 1.0 for x in spans)
                  if j.get("ocr_spans") is not None else None)
    ap = _vb_load(vdir / "audio-profile.json", {})
    tr = _vb_load(vdir / "transcript.json", {})
    words = [w for x in (tr.get("segments") or []) for w in (x.get("words") or [])]
    conf_first = next((w for w in words if _num(w.get("p")) is not None and w["p"] >= 0.5), None)
    n_words = _num(sp.get("n_words"))
    return {"id": vdir.name, "duration_s": dur, "aspect": pr.get("aspect"),
            "res": f"{pr.get('width')}x{pr.get('height')}" if pr.get("width") else None, "fps": _num(pr.get("fps")),
            "shots": _num(pa.get("shots")), "cuts": _num(pa.get("cuts")), "cuts_per_10s": _num(pa.get("cuts_per_10s")),
            "median_shot_s": _num(pa.get("median_shot_s")), "first_cut_s": _num(hk.get("first_cut_s")),
            "cuts_in_first_3s": _num(hk.get("cuts_in_first_3s")), "speech_starts_s": _num(hk.get("speech_starts_s")),
            "speech_starts_confident_s": _num(conf_first.get("s")) if conf_first else None,
            "words_found": ((n_words or 0) > 0) if sp else None, "n_words": n_words,
            "words_per_s": round(n_words / dur, 2) if (n_words is not None and dur) else None,
            "lufs": _num(au.get("integrated_lufs")), "loop": _num(j.get("loop_similarity_first_last")),
            "text_first_s": text_first, "n_text_spans": len(spans) if j.get("ocr_spans") is not None else None,
            "tempo_bpm": _num(ap.get("tempo_bpm")), "beat_strength": _num(ap.get("beat_strength")),
            "harmonic_ratio": _num(ap.get("harmonic_ratio_non_speech")), "spectral_flatness": _num(ap.get("spectral_flatness_median")),
            "non_speech_audible_share": _num(ap.get("non_speech_audible_share"))}


def _vs_facts(run_dir: Path, ids):
    facts, bad, missing = {}, [], []
    for i in ids:
        p = run_dir / "20-analysis" / "cards" / f"{i}.md"
        if not p.exists():
            missing.append(i)
            continue
        m = FACTS_RX.search(p.read_text(encoding="utf-8", errors="replace"))
        if not m:
            missing.append(i)
            continue
        try:
            facts[i] = json.loads(m.group(1))
        except ValueError:
            bad.append(i)
    return facts, bad, missing


def _label_rows(entries):
    """entries: [(video id, label as written)] -> rows [{label, count, share, videos}], most frequent first (a tabulation: no label is better than another)."""
    rows, first = {}, {}
    for vid, lab in entries:
        k = _norm(lab)
        first.setdefault(k, str(lab).strip())
        rows.setdefault(k, []).append(vid)
    total = sum(len(v) for v in rows.values())
    return total, [{"label": first[k], "count": len(v), "share": round(len(v) / total, 3), "videos": v}
                   for k, v in sorted(rows.items(), key=lambda kv: (-len(kv[1]), kv[0]))]


def _vs_aggregate(ms, facts, run, niche=True):
    from collections import Counter
    n = len(ms)
    g = lambda k: [m.get(k) for m in ms]
    agg = {"n_videos": n,
           "duration_s": _dist(g("duration_s")), "median_shot_s": _dist(g("median_shot_s")),
           "cuts_per_10s": _dist(g("cuts_per_10s")), "first_cut_s": _dist([m["first_cut_s"] for m in ms if m["first_cut_s"] is not None]),
           "share_no_cut_at_all": _share([(m["cuts"] == 0) if m["cuts"] is not None else None for m in ms]),
           "share_cut_in_first_3s": _share([(m["cuts_in_first_3s"] > 0) if m["cuts_in_first_3s"] is not None else None for m in ms]),
           "share_words_found": _share(g("words_found")),
           "speech_starts_s": _dist([m["speech_starts_s"] for m in ms if m["words_found"] and m["speech_starts_s"] is not None]),
           "speech_starts_confident_s": _dist([m["speech_starts_confident_s"] for m in ms if m["words_found"] and m["speech_starts_confident_s"] is not None]),
           "share_word_in_first_second": _share([(m["speech_starts_s"] is not None and m["speech_starts_s"] <= 1.0) if m["words_found"] is not None else None for m in ms]),
           "words_per_s": _dist(g("words_per_s")), "lufs": _dist(g("lufs")), "loop_similarity": _dist(g("loop")),
           "share_text_in_first_second": _share(g("text_first_s")), "text_spans": _dist(g("n_text_spans"), 1),
           "tempo_bpm": _dist(g("tempo_bpm"), 1), "beat_strength": _dist(g("beat_strength")), "harmonic_ratio_non_speech": _dist(g("harmonic_ratio")),
           "spectral_flatness_median": _dist(g("spectral_flatness"), 3), "non_speech_audible_share": _dist(g("non_speech_audible_share")),
           "share_vertical_9_16": _share([(m["aspect"] == "9:16") if m["aspect"] else None for m in ms]),
           "aspects": dict(Counter(m["aspect"] for m in ms if m["aspect"]))}
    product_layer = () if niche else ("category", "product_form", "price_tier")        # Create: the references' product layer is discarded, not profiled
    idx = _vocab_index(_vocab_load(run)) if niche else {}
    labels = {}
    for k in FACT_KEYS:
        if k in product_layer:
            continue
        if k == "category":
            ents = [(i, f.get("category")) for i, f in facts.items() if f.get("category") not in (None, "", [])]
            by = {}
            for i, lab in ents:                                   # through the niche vocabulary the AGENTS recorded; a label they have not recorded stays as written
                canon = idx.get(_niche_key(lab))
                r = by.setdefault(canon or str(lab).strip(), {"niche": canon or str(lab).strip(), "recorded_in_vocabulary": canon is not None, "count": 0, "labels": {}, "videos": []})
                r["count"] += 1
                r["labels"][str(lab).strip()] = r["labels"].get(str(lab).strip(), 0) + 1
                r["videos"].append(i)
            total = len(ents)
            if total:
                labels[k] = {"total": total, "table": [{**r, "share": round(r["count"] / total, 3)} for r in sorted(by.values(), key=lambda r: (-r["count"], r["niche"].casefold()))]}
            continue
        ents = [(i, f.get(k)) for i, f in facts.items() if f.get(k) not in (None, "", [])]
        if ents:
            total, rows = _label_rows(ents)
            labels[k] = {"total": total, "table": rows}
    agg["labels"] = labels
    agg["share_attention_only"] = _share([f.get("attention_only") for f in facts.values() if isinstance(f.get("attention_only"), bool)])
    return agg


def _vs_md(sets, contrast, notes):
    L = ["# Corpus statistics (measured and counted; viral-stats)", "",
         "Distributions of what was MEASURED on the prepared videos and counts of what the agents WROTE on the cards. Nothing here is a verdict: whether a niche, "
         "a format or a style stands out, and whether there are enough videos to read a share, is for you to judge and to write down.", ""]
    for name, a in sets.items():
        L += [f"## {name} - {a['n_videos']} video(s)", "",
              "| measure | n | min | p25 | median | mean | p75 | max |", "|---|---|---|---|---|---|---|---|"]
        for k in ("duration_s", "median_shot_s", "cuts_per_10s", "first_cut_s", "speech_starts_s", "speech_starts_confident_s", "words_per_s", "lufs",
                  "loop_similarity", "text_spans", "tempo_bpm", "beat_strength", "harmonic_ratio_non_speech", "spectral_flatness_median", "non_speech_audible_share"):
            d = a.get(k)
            if d:
                L.append(f"| {k} | {d['n']} | {d['min']} | {d['p25']} | {d['median']} | {d['mean']} | {d['p75']} | {d['max']} |")
        L += ["", "| share of videos | yes / n | share |", "|---|---|---|"]
        for k in ("share_cut_in_first_3s", "share_no_cut_at_all", "share_words_found", "share_word_in_first_second",
                  "share_text_in_first_second", "share_vertical_9_16", "share_attention_only"):
            d = a.get(k)
            if d:
                L.append(f"| {k[6:].replace('_', ' ')} | {d['yes']} / {d['n']} | {d['share']} |")
        for k, t in a.get("labels", {}).items():
            L += ["", f"### {k} ({t['total']} card(s) carry this key)", ""]
            if k == "category":
                L += ["| niche as recorded | count | share | labels written on the cards | videos |", "|---|---|---|---|---|"]
                L += [f"| {r['niche']}{'' if r['recorded_in_vocabulary'] else ' (not in the vocabulary)'} | {r['count']} | {r['share']} | "
                      f"{_md_cell('; '.join(f'{x} x{c}' for x, c in r['labels'].items()))} | {', '.join(r['videos'])} |" for r in t["table"]]
            else:
                L += ["| label | count | share | videos |", "|---|---|---|---|"]
                L += [f"| {_md_cell(r['label'])} | {r['count']} | {r['share']} | {', '.join(r['videos'])} |" for r in t["table"]]
        L.append("")
    if contrast:
        L += ["## contrast (references vs baseline; plain differences)", "", "| measure | references | baseline | difference |", "|---|---|---|---|"]
        L += [f"| {k} | {v['ref']} | {v['base']} | {v['delta']} |" for k, v in contrast.items()]
        L.append("")
    if notes:
        L += ["## notes on the inputs", ""] + [f"- {n}" for n in notes] + [""]
    return "\n".join(L)


def cmd_viral_stats(a):
    """Measured profile of the prepared videos plus counts of what the cards' Facts lines say. It tabulates; it flags nothing."""
    run_dir = Path(a.run)
    media = run_dir / "10-media"
    if not media.exists():
        fail("run prep-all first (10-media/ not found)", 2)
    sets, notes = {}, []
    want = ["references", "baseline"] if a.vs_set == "both" else [a.vs_set]
    for name in want:
        pre = "V" if name == "references" else "B"
        ms = [m for m in (_vs_measure(d) for d in sorted(media.glob(f"{pre}[0-9]*")) if d.is_dir()) if m]
        if not ms:
            if name == "references":
                fail("no prepared reference videos (10-media/V*/video.json)", 2)
            continue
        facts, bad, missing = _vs_facts(run_dir, [m["id"] for m in ms])
        if bad:
            notes.append(f"{name}: unreadable Facts JSON in cards {', '.join(bad)}")
        if missing:
            notes.append(f"{name}: no Facts line in cards {', '.join(missing)} (the label counts leave them out)")
        sets[name] = _vs_aggregate(ms, facts, run_dir, niche=not a.no_niche)
        sets[name]["cards_without_facts"], sets[name]["cards_with_unreadable_facts"] = missing, bad
    base = "corpus-profile" if a.no_niche else "corpus-stats"       # the profile alone never overwrites the niche-aware statistics
    jp, mp = run_dir / "20-analysis" / f"{base}.json", run_dir / "20-analysis" / f"{base}.md"
    prior = _vb_load(jp, {})
    prior_sets = prior.get("sets") if isinstance(prior, dict) and isinstance(prior.get("sets"), dict) else {}
    kept = {k: v for k, v in prior_sets.items() if k not in sets}      # a set this run did not recompute stays
    all_sets = {**kept, **sets}
    contrast = {}
    if "references" in all_sets and "baseline" in all_sets:
        r, b = all_sets["references"], all_sets["baseline"]
        for k in ("duration_s", "median_shot_s", "cuts_per_10s", "first_cut_s", "speech_starts_s", "words_per_s", "loop_similarity", "text_spans"):
            if r.get(k) and b.get(k):
                contrast[k + " (median)"] = {"ref": r[k]["median"], "base": b[k]["median"], "delta": round(r[k]["median"] - b[k]["median"], 2)}
        for k in ("share_cut_in_first_3s", "share_words_found", "share_word_in_first_second", "share_text_in_first_second"):
            if r.get(k) and b.get(k):
                contrast[k] = {"ref": r[k]["share"], "base": b[k]["share"], "delta": round(r[k]["share"] - b[k]["share"], 3)}
    result = {"created": now_iso(), "niche": not a.no_niche, "sets": all_sets, "contrast": contrast, "notes": notes}
    write_json(jp, result)
    write_text(mp, _vs_md(all_sets, contrast, notes))
    refs = all_sets.get("references") or {}
    out({"ok": True, "json": str(jp), "md": str(mp), "references": refs.get("n_videos"), "baseline": (all_sets.get("baseline") or {}).get("n_videos"),
         "category_table": [{k: r[k] for k in ("niche", "count", "recorded_in_vocabulary", "videos")} for r in ((refs.get("labels") or {}).get("category") or {}).get("table", [])],
         "notes": notes})


# ---- candidate ledger helpers (needed by econ --apply as well)

def _cd_paths(run):
    d = _vb_dir(run)
    return d / "candidates.json", d / "candidates.json.lock"


def _ev_paths(run):
    d = _vb_dir(run)
    return d / "evidence.json", d / "evidence.json.lock"


# ---- the niche vocabulary (built by the agents from the data)

def _raw_labels(run):
    """Every raw niche label in use, with its source and count: the cards' Facts.category and the candidates' category."""
    from collections import Counter
    run_dir = Path(run)
    labels = Counter()
    media = run_dir / "10-media"
    ids_v = [d.name for d in sorted(media.glob("V[0-9]*")) if d.is_dir()] if media.exists() else []
    facts, _, _ = _vs_facts(run_dir, ids_v)
    for f in facts.values():
        if f.get("category") not in (None, "", []):
            labels[("card", str(f["category"]).strip())] += 1
    for c in _vb_load(_cd_paths(run)[0], {"items": []})["items"]:
        if c.get("category"):
            labels[("candidate", str(c["category"]).strip())] += 1
    return labels


def _place_label(vocab, label, niche):
    """Record that `label` belongs to `niche`. If another niche held it as a member it moves (the niche it came from is returned)."""
    key = _niche_key(label)
    came_from = None
    for nm, rec in vocab["niches"].items():
        if nm != niche and any(_niche_key(m) == key for m in rec.get("members", [])):
            rec["members"] = [m for m in rec["members"] if _niche_key(m) != key]
            came_from = nm
    mem = vocab["niches"][niche].setdefault("members", [])
    if key != _niche_key(niche) and not any(_niche_key(m) == key for m in mem):
        mem.append(str(label).strip())
    return came_from


def cmd_niches(a):
    """The run's niche vocabulary: a RECORD of the agents' decisions about which labels are one niche. Nothing here decides or compares: it does not look
    at words, does not warn about look-alike names and does not refuse a niche because of how it is named. `add`, `map` and `merge` record what an agent
    decided (`merge` also renames the niche on the candidates that carried the old one); `audit` records that a fresh audit agent reviewed the vocabulary
    and what it concluded; `list` and `propose` tabulate the labels in use, with their counts, and the niche each is recorded under."""
    run = a.run
    p = _vocab_path(run)
    lk = p.with_suffix(".json.lock")
    if a.action in ("add", "map", "merge", "audit"):
        notes = []
        with FileLock(lk):
            vocab = _vocab_load(run)
            hist = vocab.setdefault("history", [])
            if a.action == "add":
                if not a.name:
                    fail("niches add needs --name", 2)
                name = re.sub(r"\s+", " ", a.name.strip())
                if not _has_word(name):
                    fail("a niche name needs at least one letter or digit", 2)
                name = next((n for n in vocab["niches"] if _niche_key(n) == _niche_key(name)), name)
                created = name not in vocab["niches"]
                vocab["niches"].setdefault(name, {"members": [], "created": now_iso()})
                for m in [x.strip() for x in re.split(r"[;,]", a.members or "") if x.strip()]:
                    if not _has_word(m):
                        fail(f"{m!r} is not a usable label: it needs at least one letter or digit", 2)
                    other = next((n for n in vocab["niches"] if n != name and _niche_key(n) == _niche_key(m)), None)
                    if other:
                        notes.append(f"{m!r} is the name of the niche {other!r}, so it was not added as a label of {name!r}; to fold one niche into another use `niches merge`")
                        continue
                    src_ = _place_label(vocab, m, name)
                    if src_:
                        notes.append(f"label {m!r} moved from niche {src_!r} to {name!r}")
                hist.append({"at": now_iso(), "by": a.by, "action": "add", "niche": name, "created": created, "members": a.members, "reason": a.reason})
            elif a.action == "map":
                if not (a.label and a.to):
                    fail("niches map needs --label and --to", 2)
                to = next((n for n in vocab["niches"] if _niche_key(n) == _niche_key(a.to)), None)
                if not to:
                    fail(f"unknown niche {a.to!r}; record it with `niches add` first", 2)
                if not _has_word(a.label):
                    fail(f"{a.label!r} is not a usable label: it needs at least one letter or digit", 2)
                other = next((n for n in vocab["niches"] if n != to and _niche_key(n) == _niche_key(a.label)), None)
                if other:
                    fail(f"{a.label!r} is the name of the niche {other!r}: to fold that niche into {to!r} use `niches merge --from ... --to ... --reason ...`", 2)
                src_ = _place_label(vocab, a.label, to)
                if src_:
                    notes.append(f"label {a.label!r} moved from niche {src_!r} to {to!r}")
                hist.append({"at": now_iso(), "by": a.by, "action": "map", "label": a.label, "niche": to, "moved_from": src_, "reason": a.reason})
            elif a.action == "merge":
                if not (a.from_ and a.to):
                    fail("niches merge needs --from and --to", 2)
                src = next((n for n in vocab["niches"] if _niche_key(n) == _niche_key(a.from_)), None)
                dst = next((n for n in vocab["niches"] if _niche_key(n) == _niche_key(a.to)), None)
                if not src or not dst:
                    fail("both niches must exist (see `niches list`)", 2)
                if src == dst:
                    fail("--from and --to are the same niche", 2)
                if not (a.reason or "").strip():
                    fail("niches merge needs --reason: the sentence saying why they are one niche (it is kept in the vocabulary file)", 2)
                for m in [src] + vocab["niches"][src].get("members", []):
                    if _niche_key(m) != _niche_key(dst) and not any(_niche_key(x) == _niche_key(m) for x in vocab["niches"][dst]["members"]):
                        vocab["niches"][dst]["members"].append(m)
                del vocab["niches"][src]
                vocab.setdefault("merges", []).append({"from": src, "to": dst, "reason": a.reason.strip(), "by": a.by, "at": now_iso()})
                hist.append({"at": now_iso(), "by": a.by, "action": "merge", "from": src, "to": dst, "reason": a.reason.strip()})
                moved = 0
                with FileLock(_cd_paths(run)[1]):
                    data = _vb_load(_cd_paths(run)[0], {"items": []})
                    for c in data["items"]:
                        if c.get("category") == src:
                            c["category"] = dst
                            moved += 1
                    if moved:
                        write_json(_cd_paths(run)[0], data)
                notes.append(f"{moved} candidate(s) moved to {dst!r}; run `viral-stats` again so the corpus statistics follow the vocabulary")
            else:       # audit: the record of a fresh audit agent's review of the vocabulary
                if not (a.by and a.result):
                    fail("niches audit needs --by (the agent that audited) and --result (what it found and what was applied)", 2)
                rec = {"by": a.by, "result": a.result, "at": now_iso(), "niches": sorted(vocab["niches"]), "report": a.report}
                if a.report and Path(a.report).exists():
                    rec["report_bytes"] = Path(a.report).stat().st_size
                vocab["audit"] = rec
                vocab.setdefault("audits", []).append(rec)
                hist.append({"at": now_iso(), "by": a.by, "action": "audit", "result": a.result})
            vocab["updated"] = now_iso()
            write_json(p, vocab)
        out({"ok": True, "niches": {k: v["members"] for k, v in vocab["niches"].items()}, "notes": notes})
    vocab = _vocab_load(run)
    idx = _vocab_index(vocab)
    labels = _raw_labels(run)
    rows, unmapped = [], []
    for (src, lab), n in sorted(labels.items(), key=lambda kv: (-kv[1], kv[0][1].casefold())):
        canon = idx.get(_niche_key(lab))
        rows.append({"source": src, "label": lab, "count": n, "niche": canon})
        if canon is None and lab not in unmapped:
            unmapped.append(lab)
    audits = vocab.get("audits") or ([vocab["audit"]] if vocab.get("audit") else [])
    if a.action == "propose":
        print("| label in use | where | count | recorded under niche |\n|---|---|---|---|")
        for r in rows:
            print(f"| {r['label']} | {r['source']} | {r['count']} | {r['niche'] or '-- not recorded --'} |")
    else:
        print("| niche | member labels | cards | candidates |\n|---|---|---|---|")
        for name, rec in sorted(vocab["niches"].items()):
            cards = sum(r["count"] for r in rows if r["niche"] == name and r["source"] == "card")
            cands = sum(r["count"] for r in rows if r["niche"] == name and r["source"] == "candidate")
            print(f"| {name} | {', '.join(rec.get('members', [])) or '-'} | {cards} | {cands} |")
        if unmapped:
            print("\nlabels in use that are not recorded under any niche: " + "; ".join(unmapped))
        print("\naudits on record: " + (("; ".join(f"by {x.get('by')} at {x.get('at')}: {x.get('result')}" for x in audits)) if audits else "none"))
    out({"ok": True, "niches": {k: v.get("members", []) for k, v in vocab["niches"].items()},
         "labels_in_use": rows, "unmapped_labels": unmapped, "audits": audits})


# ---- unit economics

def cmd_econ(a):
    """Unit economics: PURE ARITHMETIC from the inputs given (retail price, VAT, landed cost, fulfilment, fees, returns). It judges nothing: no gate, no
    floor, no 'good' or 'bad'. With --cand and --market the result is stored on the candidate, one result per market, side by side; which market counts, and
    whether a margin is enough, is the agent's decision (reference/viral-browser.md section 2 and 8)."""
    if a.cand and not (a.market or "").strip():
        fail("econ --cand needs --market (the market this calculation is for, e.g. US, EU, DE): a candidate keeps one result per market, side by side", 2)
    vat = (a.vat_pct or 0.0) / 100.0
    net = a.retail / (1.0 + vat)
    base = a.retail if a.fees_on == "gross" else net          # card and platform fees are charged on the amount paid
    fees = base * ((a.platform_fee_pct or 0.0) + (a.payment_fee_pct or 0.0)) / 100.0 + (a.payment_fixed or 0.0)

    def contribution(retail_mult=1.0, returns_mult=1.0, landed_mult=1.0):
        rt = a.retail * retail_mult
        nt = rt / (1.0 + vat)
        fe = (rt if a.fees_on == "gross" else nt) * ((a.platform_fee_pct or 0.0) + (a.payment_fee_pct or 0.0)) / 100.0 + (a.payment_fixed or 0.0)
        r = min(1.0, (a.returns_pct or 0.0) / 100.0 * returns_mult)
        ld = a.landed * landed_mult
        rl = r * (nt + (a.return_cost or 0.0) - (a.resale_pct or 0.0) / 100.0 * ld)
        return nt, nt - ld - (a.fulfil or 0.0) - fe - rl

    _, c0 = contribution()
    r = (a.returns_pct or 0.0) / 100.0
    ret_loss = r * (net + (a.return_cost or 0.0) - (a.resale_pct or 0.0) / 100.0 * a.landed)
    gm = (net - a.landed) / net if net else 0.0
    res = {"currency": a.currency, "retail_price": round(a.retail, 2), "vat_pct_included": a.vat_pct or 0.0,
           "net_revenue": round(net, 2), "landed_cost": round(a.landed, 2), "fulfilment": round(a.fulfil or 0.0, 2),
           "fees": round(fees, 2), "fees_charged_on": a.fees_on, "expected_return_loss": round(ret_loss, 2),
           "contribution_per_order": round(c0, 2),
           "contribution_pct_of_net": round(100 * c0 / net, 1) if net else None,
           "gross_margin_pct": round(100 * gm, 1), "markup_net_over_landed": round(net / a.landed, 2) if a.landed else None,
           "break_even_cpa": round(c0, 2),
           "break_even_roas_net": round(net / c0, 2) if c0 > 0 else None,
           "break_even_roas_gross": round(a.retail / c0, 2) if c0 > 0 else None,
           "landed_ceiling_at_markup": {str(k): round(net / k, 2) for k in (3, 4)}}
    if a.moq:
        res["capital_at_moq"] = round(a.moq * a.landed, 2)
    if a.stress:
        sc = {}
        for label, kw in (("retail -20%", {"retail_mult": 0.8}), ("returns x2", {"returns_mult": 2.0}),
                          ("landed +15%", {"landed_mult": 1.15}),
                          ("all three", {"retail_mult": 0.8, "returns_mult": 2.0, "landed_mult": 1.15})):
            nt, cc = contribution(**kw)
            sc[label] = {"contribution_per_order": round(cc, 2), "contribution_pct_of_net": round(100 * cc / nt, 1) if nt else None}
        res["stress"] = sc
    # the inputs left at zero, as a fact about the call: the result then assumes none of that cost
    res["inputs_left_at_zero"] = [k for k, v in (("returns_pct", a.returns_pct), ("vat_pct", a.vat_pct), ("fulfil", a.fulfil), ("platform_fee_pct", a.platform_fee_pct),
                                                 ("payment_fee_pct", a.payment_fee_pct), ("payment_fixed", a.payment_fixed), ("return_cost", a.return_cost),
                                                 ("resale_pct", a.resale_pct)) if not v]
    rows = [("retail price (consumer)", res["retail_price"]), (f"net revenue (VAT {res['vat_pct_included']}% removed)", res["net_revenue"]),
            ("landed cost", res["landed_cost"]), ("fulfilment", res["fulfilment"]), (f"fees (on {a.fees_on})", res["fees"]),
            ("expected return loss", res["expected_return_loss"]), ("contribution per order", res["contribution_per_order"]),
            ("contribution % of net", res["contribution_pct_of_net"]), ("break-even CPA", res["break_even_cpa"]),
            ("break-even ROAS (on net revenue)", res["break_even_roas_net"]), ("break-even ROAS (on the amount paid)", res["break_even_roas_gross"])]
    print(f"| item ({a.currency}) | value |\n|---|---|\n" + "\n".join(f"| {k} | {v} |" for k, v in rows))
    if res.get("stress"):
        print("\n| stress | contribution | % of net |\n|---|---|---|\n" + "\n".join(
            f"| {k} | {v['contribution_per_order']} | {v['contribution_pct_of_net']} |" for k, v in res["stress"].items()))
    if res["inputs_left_at_zero"]:
        print("\ninputs left at zero (the result assumes none of that cost): " + ", ".join(res["inputs_left_at_zero"]))
    if a.cand:
        if not a.run:
            fail("econ --cand needs --run", 2)
        p, lk = _cd_paths(a.run)
        ep, elk = _ev_paths(a.run)
        with FileLock(lk):
            data = _vb_load(p, {"items": []})
            c = next((x for x in data["items"] if x["id"] == a.cand), None)
            if not c:
                fail(f"unknown candidate {a.cand}", 2)
            mk = _norm(a.market)
            ebm = c.setdefault("economics_by_market", {})
            ebm[mk] = {"market": a.market.strip(), "at": now_iso(),
                       **{k: res[k] for k in ("retail_price", "net_revenue", "landed_cost", "contribution_per_order", "contribution_pct_of_net",
                                              "break_even_cpa", "break_even_roas_gross", "currency")},
                       "inputs": {"vat_pct": a.vat_pct, "fulfil": a.fulfil, "platform_fee_pct": a.platform_fee_pct, "payment_fee_pct": a.payment_fee_pct,
                                  "payment_fixed": a.payment_fixed, "returns_pct": a.returns_pct, "return_cost": a.return_cost, "resale_pct": a.resale_pct,
                                  "fees_on": a.fees_on, "moq": a.moq}}
            data["updated"] = now_iso()
            write_json(p, data)
        with FileLock(elk):
            ed = _vb_load(ep, {"items": []})
            nid = f"EV{len(ed['items']) + 1:03d}"
            method = (f"method: econ retail={a.retail} vat={a.vat_pct} landed={a.landed} fulfil={a.fulfil} platform={a.platform_fee_pct}% "
                      f"payment={a.payment_fee_pct}%+{a.payment_fixed} returns={a.returns_pct}% return_cost={a.return_cost} fees_on={a.fees_on}")
            ed["items"].append({"id": nid, "cand": a.cand, "lane": "economics",
                                "claim": f"contribution {res['contribution_pct_of_net']}% of net at {a.currency} {a.retail} ({a.market.strip()})",
                                "value": str(res["contribution_pct_of_net"]), "unit": "% of net", "source": method, "grade": "C",
                                "retrieved": dt.date.today().isoformat(), "independent": True, "market": a.market,
                                "signal": "calculation", "note": None, "added": now_iso()})
            write_json(ep, ed)
        res["applied_to"] = a.cand
        res["evidence_id"] = nid
    out({"ok": True, **res})


# ---- evidence ledger

def _md_cell(v) -> str:
    return str(v if v is not None else "").replace("|", "\\|").replace("\r", " ").replace("\n", " ").replace("\u2028", " ").replace("\u2029", " ")


def _ev_counts(rows):
    """Plain counts of evidence rows by lane, signal and grade, and the sites behind them. A tabulation: it weighs nothing."""
    by_lane = {}
    for e in rows:
        l = by_lane.setdefault(e["lane"], {"rows": 0, "signal": {}, "grade": {}, "independent": 0, "sites": set(), "ab_positive_sites": set()})
        l["rows"] += 1
        l["signal"][e.get("signal") or "none"] = l["signal"].get(e.get("signal") or "none", 0) + 1
        l["grade"][e["grade"]] = l["grade"].get(e["grade"], 0) + 1
        l["independent"] += 1 if e.get("independent") else 0
        site = _site_key(e.get("source"))
        l["sites"].add(site)
        if e["grade"] in ("A", "B") and e.get("signal") == "positive":
            l["ab_positive_sites"].add(site)
    return {k: {**{kk: vv for kk, vv in v.items() if kk not in ("sites", "ab_positive_sites")}, "sites": len(v["sites"]),
                "sites_behind_positive_grade_A_or_B_rows": len(v["ab_positive_sites"])} for k, v in sorted(by_lane.items())}


def cmd_evidence(a):
    """The research evidence ledger: each row is a claim with its source, date, grade, signal and independence AS THE RESEARCHING AGENT STATED THEM. The
    ledger checks the form (the required fields, and a URL behind an independent grade A or B row) and tabulates; it does not weigh a row, count it toward
    anything or decide what is enough evidence."""
    p, lk = _ev_paths(a.run)
    cands = _vb_load(_cd_paths(a.run)[0], {"items": []})["items"]
    if a.action == "add":
        for need, val in (("--cand", a.cand), ("--lane", a.lane), ("--claim", a.claim), ("--source", a.source), ("--grade", a.grade),
                          ("--signal", a.signal), ("--independent", a.independent)):
            if not val:
                fail(f"evidence add needs {need}", 2)
        if not any(c["id"] == a.cand for c in cands):
            fail(f"unknown candidate {a.cand}; add it with `candidates add` first", 2)
        if a.independent == "yes" and a.grade in ("A", "B") and not re.match(r"^https?://", a.source.strip(), re.I):
            fail("an independent grade A or B row needs a URL as its source (a primary or reputable secondary page); "
                 "use grade C with a method for an estimate, or grade D for what could not be verified", 2)
        with FileLock(lk):
            data = _vb_load(p, {"items": []})
            nid = f"EV{len(data['items']) + 1:03d}"
            row = {"id": nid, "cand": a.cand, "lane": a.lane, "claim": a.claim, "value": a.value, "unit": a.unit,
                   "source": a.source, "domain": _domain(a.source), "grade": a.grade,
                   "retrieved": a.retrieved or dt.date.today().isoformat(),
                   "independent": a.independent == "yes", "market": a.market, "signal": a.signal, "note": a.note, "by": a.by, "added": now_iso()}
            data["items"].append(row)
            write_json(p, data)
        out({"ok": True, "id": nid})
    if a.action == "retract":
        if not (a.id and (a.reason or "").strip()):
            fail("evidence retract needs --id and --reason (the record is kept; the row is marked retracted and left out of the counts)", 2)
        with FileLock(lk):
            data = _vb_load(p, {"items": []})
            row = next((e for e in data["items"] if e["id"] == a.id), None)
            if not row:
                fail(f"unknown evidence row {a.id}", 2)
            row["retracted"], row["retracted_reason"], row["retracted_at"], row["retracted_by"] = True, a.reason.strip(), now_iso(), a.by
            write_json(p, data)
        out({"ok": True, "id": a.id, "retracted": True})
    data = _vb_load(p, {"items": []})
    rows = [e for e in data["items"] if (not a.cand or e["cand"] == a.cand) and (not a.lane or e["lane"] == a.lane)
            and (not a.grade or e["grade"] == a.grade) and (not a.signal or e.get("signal") == a.signal)]
    live = [e for e in rows if not e.get("retracted")]
    counts = _ev_counts(live) if a.counts else None
    if a.counts:
        print("| lane | rows | signals | grades | independent | sites | sites behind positive A/B rows |\n|---|---|---|---|---|---|---|")
        for k, v in counts.items():
            print(f"| {k} | {v['rows']} | {', '.join(f'{x} {n}' for x, n in sorted(v['signal'].items()))} | {', '.join(f'{x} {n}' for x, n in sorted(v['grade'].items()))} | "
                  f"{v['independent']} | {v['sites']} | {v['sites_behind_positive_grade_A_or_B_rows']} |")
    if a.md or a.out:
        L = ["| id | cand | lane | claim | value | grade | signal | indep. | market | retrieved | source | retracted |",
             "|---|---|---|---|---|---|---|---|---|---|---|---|"]
        for e in rows:
            L.append(f"| {e['id']} | {e['cand']} | {e['lane']} | {_md_cell(e['claim'])} | {_md_cell((e.get('value') or ''))} {_md_cell((e.get('unit') or ''))} | "
                     f"{e['grade']} | {e.get('signal') or ''} | {'yes' if e['independent'] else 'no'} | {_md_cell(e.get('market'))} | {e['retrieved']} | {_md_cell(e['source'])} | "
                     f"{_md_cell(e.get('retracted_reason')) if e.get('retracted') else ''} |")
        if a.out:
            write_text(Path(a.out), "\n".join(L) + "\n")
        else:
            print("\n".join(L))
    out({"ok": True, "count": len(rows), "out": a.out, "counts": counts, "items": rows if not (a.md or a.out or a.counts) else [e["id"] for e in rows]})


# ---- candidate ledger

def _cd_next_id(items):
    n = max([int(re.sub(r"\D", "", c["id"]) or 0) for c in items] + [0]) + 1
    return f"C{n:02d}" if n < 100 else f"C{n}"


def _cd_new(spec):
    return {"name": spec.get("name"), "definition": spec.get("definition"), "category": spec.get("category"),
            "type": spec.get("type") or spec.get("ptype"), "origin": spec.get("origin"),
            "origin_note": spec.get("origin_note"), "mechanisms": spec.get("mechanisms") or [],
            "status": "long", "eliminated_by": None, "price_fit": "unknown", "compliance": "unknown", "excluded": "no",
            "ratings": {}, "rating_refs": {}, "confidence": None, "redteam": None, "defence": None, "role": None, "pick_rank": None,
            "notes": spec.get("note") or spec.get("notes"), "added": now_iso(), "history": []}


def _cd_blind(c):
    return {k: v for k, v in c.items() if k not in ("origin", "origin_note", "mechanisms", "added")}


def _cd_ids(a):
    ids = [a.id] if a.id else []
    ids += [x for x in re.split(r"[,\s]+", a.ids or "") if x]
    return ids


def _cd_select(items, a):
    """Rows by the filters the caller names (a plain selection, not a judgement)."""
    ids = set(_cd_ids(a))
    stat = {x for x in re.split(r"[,\s]+", a.statuses or "") if x}
    if a.status:
        stat.add(a.status)
    cat = _niche_key((_niche(a.category, a.run)[0] or a.category)) if a.category else None
    return [c for c in items if (not ids or c["id"] in ids) and (not stat or c["status"] in stat)
            and (not cat or _niche_key(c.get("category")) == cat) and (not a.origin or c.get("origin") == a.origin)]


def _cd_weighted(c, rubric, exclude=()):
    """The plain weighted sum of the agent's own ratings (arithmetic, not a score the tool stands behind): unrated criteria add nothing, and the criteria
    named in `exclude` are left out (for the agent's own what-if, for example the sum without the criterion derived from the references)."""
    r = c.get("ratings") or {}
    done = [k for k in rubric if k in r and k not in exclude]
    return round(sum(rubric[k] * r[k] / 5.0 for k in done), 1) if done else None, len(done)


def _cd_evidence_cell(rows):
    live = [e for e in rows if not e.get("retracted")]
    sig = {}
    for e in live:
        sig[e.get("signal") or "none"] = sig.get(e.get("signal") or "none", 0) + 1
    ab = [e for e in live if e["grade"] in ("A", "B")]
    sites = len({_site_key(e.get("source")) for e in ab})
    return {"rows": len(live), "grade_A_or_B": len(ab), "signals": sig, "sites_behind_A_or_B": sites}


def _cd_rows(items, a, cfg):
    """The side-by-side table: every recorded value of every selected candidate in one row, no total chosen for you and no order imposed."""
    evid = _vb_load(_ev_paths(a.run)[0], {"items": []})["items"]
    excl = {x for x in re.split(r"[,\s]+", getattr(a, "exclude_criteria", None) or "") if x}
    rows = []
    for c in items:
        wsum, n_rated = _cd_weighted(c, cfg["rubric"], excl)
        eco = {m: {"market": v.get("market"), "currency": v.get("currency"), "retail": v.get("retail_price"), "landed": v.get("landed_cost"),
                   "contribution_pct_of_net": v.get("contribution_pct_of_net"), "contribution_per_order": v.get("contribution_per_order")}
               for m, v in (c.get("economics_by_market") or {}).items()}
        row = {"id": c["id"], "name": c["name"], "niche": c.get("category"), "type": c.get("type"), "origin": c.get("origin"), "status": c["status"],
               "price_fit": c.get("price_fit"), "compliance": c.get("compliance"), "excluded": c.get("excluded"),
               "ratings": c.get("ratings") or {}, "weighted_sum_of_rated": wsum, "criteria_rated": n_rated, "confidence": c.get("confidence"),
               "redteam": c.get("redteam"), "pick_rank": c.get("pick_rank"), "economics": eco,
               "evidence": _cd_evidence_cell([e for e in evid if e["cand"] == c["id"]])}
        if a.blind:
            row.pop("origin")
        rows.append(row)
    return rows


def _cd_sort_key(row, key):
    k, _, arg = (key or "id").partition(":")
    if k == "rating":
        return (row["ratings"].get(arg) is None, -(row["ratings"].get(arg) or 0))
    if k == "weighted":
        return (row["weighted_sum_of_rated"] is None, -(row["weighted_sum_of_rated"] or 0))
    if k == "economics":
        v = (row["economics"].get(_norm(arg)) or {}).get("contribution_pct_of_net")
        return (v is None, -(v if v is not None else 0))
    if k == "confidence":
        return (CONF_ORDER.get(row.get("confidence") or "", -1) < 0, -CONF_ORDER.get(row.get("confidence") or "", -1))
    if k == "evidence":
        return (False, -row["evidence"]["rows"])
    v = row.get({"niche": "niche", "name": "name", "type": "type", "status": "status", "id": "id", "pick": "pick_rank"}.get(k, "id"))
    return (v is None, str(v).casefold() if not isinstance(v, (int, float)) else v)


def _cd_md(rows, rubric, blind=False, excl=()):
    crit = list(rubric)
    head = ["id", "product", "niche", "type"] + ([] if blind else ["origin"]) + ["status"] + crit + ["weighted sum" + (f" (without {', '.join(sorted(excl))})" if excl else ""), "conf", "red team", "price fit", "compliance", "economics by market", "evidence rows (A/B; sites)", "pick"]
    L = ["| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
    for r in rows:
        eco = "; ".join(f"{v['market']}: {v['contribution_pct_of_net']} % of net ({v['currency']} {v['retail']})" for v in r["economics"].values()) or ""
        ev = r["evidence"]
        cells = [r["id"], _md_cell(r["name"]), _md_cell(r["niche"]), _md_cell(r["type"])] + ([] if blind else [_md_cell(r.get("origin"))]) + [r["status"]]
        cells += [str(r["ratings"].get(k, "")) for k in crit]
        cells += ["" if r["weighted_sum_of_rated"] is None else f"{r['weighted_sum_of_rated']} ({r['criteria_rated']}/{len(crit)} rated)", r.get("confidence") or "", r.get("redteam") or "",
                  r.get("price_fit") or "", r.get("compliance") or "", _md_cell(eco), f"{ev['rows']} ({ev['grade_A_or_B']}; {ev['sites_behind_A_or_B']})", str(r["pick_rank"] or "")]
        L.append("| " + " | ".join(cells) + " |")
    return "\n".join(L)


def cmd_candidates(a):
    """The candidate-product ledger. It records what the agents decide about each candidate (status, ratings, red-team reading, defence, pick order), with who,
    when and why, and puts the recorded values side by side (`table`, `summary`). It has no gate, no cap, no quota, no floor, no tie-break and no ranking: which
    candidates go to research, which are eliminated, how they compare and which are picked are the agents' decisions (reference/viral-browser.md sections 6 to 8)."""
    p, lk = _cd_paths(a.run)
    cfg = vb_cfg()
    act = a.action
    if act == "add":
        if a.from_json:
            src = json.loads(Path(a.from_json).read_text(encoding="utf-8"))
            specs = src if isinstance(src, list) else (src.get("items") if isinstance(src, dict) else None)
            if not isinstance(specs, list) or not specs or not all(isinstance(x, dict) for x in specs):
                fail("--from-json must hold a non-empty JSON list of candidate objects (or an object whose `items` is such a list)", 2)
        else:
            specs = [{"name": a.name, "definition": a.definition, "category": a.category, "type": a.ptype, "origin": a.origin,
                      "origin_note": a.origin_note, "mechanisms": [m for m in re.split(r"[,\s]+", a.mechanisms or "") if m],
                      "note": a.note}]
        errs, clean = [], []
        for i, sp_ in enumerate(specs, 1):
            sp_ = dict(sp_)
            for need in ("name", "definition", "category", "type", "origin"):
                if not (sp_.get(need) or (need == "type" and sp_.get("ptype"))):
                    errs.append(f"#{i}: missing {need}")
            if sp_.get("origin") and sp_["origin"] not in CAND_ORIGINS:
                errs.append(f"#{i}: origin must be one of {CAND_ORIGINS}")
            if sp_.get("category"):
                d, _why = _niche(sp_["category"], a.run)
                sp_["category"] = d or str(sp_["category"]).strip()       # recorded under the agents' niche when they have recorded the label, as written otherwise
            clean.append(sp_)
        if errs:
            fail("; ".join(errs), 2)
        ids, unrecorded = [], []
        with FileLock(lk):
            data = _vb_load(p, {"created": now_iso(), "items": []})
            for sp_ in clean:
                c = _cd_new(sp_)
                c["id"] = _cd_next_id(data["items"])
                c["history"].append({"at": now_iso(), "by": a.by, "action": "added"})
                data["items"].append(c)
                ids.append(c["id"])
                if _niche(c["category"], a.run)[0] is None:
                    unrecorded.append(f"{c['id']}: {c['category']}")
            data["updated"] = now_iso()
            write_json(p, data)
        out({"ok": True, "added": ids, "total": len(data["items"]), "niche_not_recorded_in_the_vocabulary": unrecorded})
    data = _vb_load(p, {"items": []})
    items = data["items"]
    if act in ("list", "table"):
        rows = _cd_select(items, a)
        if act == "list":
            shown = [_cd_blind(c) for c in rows] if a.blind else rows
            if a.md:
                print(_cd_md(_cd_rows(rows, a, cfg), cfg["rubric"], a.blind, {x for x in re.split(r"[,\s]+", a.exclude_criteria or "") if x}))
            out({"ok": True, "count": len(rows), "items": shown if not a.md else [c["id"] for c in rows]})
        tr = _cd_rows(rows, a, cfg)
        tr.sort(key=lambda r: _cd_sort_key(r, a.sort))
        if a.desc:
            tr.reverse()
        md = _cd_md(tr, cfg["rubric"], a.blind, {x for x in re.split(r"[,\s]+", a.exclude_criteria or "") if x})
        if a.out:
            write_text(Path(a.out), md + "\n")
        else:
            print(md)
        out({"ok": True, "count": len(tr), "sorted_by": a.sort or "id", "out": a.out, "rows": tr if a.json else None})
    if act == "summary":
        from collections import Counter
        rows = _cd_select(items, a)
        if a.exclude_eliminated:
            rows = [c for c in rows if c["status"] != "eliminated"]
        summ = {"n": len(rows),
                "niches": dict(Counter(_niche(c.get("category"), a.run)[0] or str(c.get("category")) for c in rows).most_common()),
                "types": dict(Counter(c.get("type") for c in rows).most_common()),
                "origins": dict(Counter(c.get("origin") for c in rows).most_common()),
                "statuses": dict(Counter(c["status"] for c in rows).most_common())}
        for title, key in (("niche", "niches"), ("type", "types"), ("origin", "origins"), ("status", "statuses")):
            print(f"| {title} | candidates |\n|---|---|\n" + "\n".join(f"| {k} | {v} |" for k, v in summ[key].items()) + "\n")
        out({"ok": True, **summ})
    if act == "show":
        if not a.id:
            fail("candidates show needs --id", 2)
        c = next((x for x in items if x["id"] == a.id), None)
        if not c:
            fail(f"unknown candidate {a.id}", 2)
        ev = [e for e in _vb_load(_ev_paths(a.run)[0], {"items": []})["items"] if e["cand"] == a.id]
        print(json.dumps(_cd_blind(c) if a.blind else c, indent=2, ensure_ascii=False))
        print("\nevidence rows:\n" + "\n".join(
            f"- {e['id']} [{e['lane']}] {e['claim']} (grade {e['grade']}, signal {e.get('signal') or 'n/a'}, {'independent' if e['independent'] else 'not independent'}"
            f"{', RETRACTED: ' + str(e.get('retracted_reason')) if e.get('retracted') else ''}; {e['source']}; {e['retrieved']})" for e in ev))
        out({"ok": True, "id": a.id, "evidence_rows": len(ev)})
    # set / rate
    ids = _cd_ids(a)
    if not ids:
        fail(f"candidates {act} needs --id (or --ids for several)", 2)
    unknown = [i for i in ids if i not in {c["id"] for c in items}]
    if unknown:
        fail(f"unknown candidate(s): {unknown}", 2)
    if act == "set":
        if a.category:
            d, _why = _niche(a.category, a.run)
            a.category = d or a.category.strip()
        with FileLock(lk):
            data = _vb_load(p, {"items": []})
            for cid in ids:
                c = next(x for x in data["items"] if x["id"] == cid)
                changes = {}
                for fld, val in (("name", a.name), ("definition", a.definition), ("category", a.category), ("type", a.ptype), ("status", a.status),
                                 ("price_fit", a.price_fit), ("compliance", a.compliance), ("excluded", a.excluded), ("defence", a.defence),
                                 ("role", a.role), ("confidence", a.confidence), ("redteam", a.redteam), ("origin_note", a.origin_note),
                                 ("pick_rank", a.pick_rank)):
                    if val is not None and val != c.get(fld):
                        changes[fld] = {"from": c.get(fld), "to": val}
                        c[fld] = val
                if a.note:
                    c["notes"] = ((c.get("notes") or "") + " | " + a.note).strip(" |")
                    changes["note"] = {"added": a.note}
                if a.status == "eliminated":
                    c["eliminated_by"] = a.reason
                c.setdefault("history", []).append({"at": now_iso(), "by": a.by, "action": "set", "changes": changes, "reason": a.reason})
            data["updated"] = now_iso()
            write_json(p, data)
        out({"ok": True, "ids": ids, "status": {c["id"]: c["status"] for c in data["items"] if c["id"] in ids}})
    if act == "rate":
        if len(ids) != 1:
            fail("candidates rate takes one candidate (--id)", 2)
        if not a.ratings:
            fail("candidates rate needs --ratings demand=4,commercial=3,... (1-5 each: the agent's own reading, recorded as given)", 2)
        evrows = {e["id"]: e for e in _vb_load(_ev_paths(a.run)[0], {"items": []})["items"]}
        rt = {}
        for kv in re.split(r"[,\s]+", a.ratings.strip()):
            if not kv:
                continue
            k, _, v = kv.partition("=")
            if k not in cfg["rubric"]:
                fail(f"unknown criterion {k!r}; the criteria are {list(cfg['rubric'])}", 2)
            try:
                iv = int(v)
            except ValueError:
                fail(f"the rating for {k} must be an integer 1-5", 2)
            if not 1 <= iv <= 5:
                fail(f"the rating for {k} must be 1-5", 2)
            rt[k] = iv
        refs = {}
        for kv in (re.split(r"\s+", a.refs.strip()) if a.refs else []):
            k, _, v = kv.partition("=")
            if not k:
                continue
            if k not in cfg["rubric"]:
                fail(f"--refs: unknown criterion {k!r}", 2)
            ids_ = [x for x in v.split("+") if x]
            bad = [x for x in ids_ if x not in evrows or evrows[x]["cand"] != ids[0]]
            if bad:
                fail(f"--refs: evidence row(s) {bad} do not exist for {ids[0]}", 2)
            refs[k] = ids_
        with FileLock(lk):
            data = _vb_load(p, {"items": []})
            c = next(x for x in data["items"] if x["id"] == ids[0])
            c.setdefault("ratings", {}).update(rt)
            c.setdefault("rating_refs", {}).update(refs)
            if a.confidence:
                c["confidence"] = a.confidence
            if a.note:
                c["notes"] = ((c.get("notes") or "") + " | " + a.note).strip(" |")
            c.setdefault("history", []).append({"at": now_iso(), "by": a.by, "action": "rated", "ratings": rt, "refs": refs, "confidence": a.confidence, "note": a.note})
            data["updated"] = now_iso()
            write_json(p, data)
        wsum, n_rated = _cd_weighted(c, cfg["rubric"])
        out({"ok": True, "id": ids[0], "ratings": c["ratings"], "criteria_not_rated": [k for k in cfg["rubric"] if k not in c["ratings"]],
             "weighted_sum_of_rated": wsum, "criteria_rated": n_rated})


# ---- the product reference pack of a pick: sourced specifications and photo references (reference/viral-browser.md section 9.1)

SPEC_UNITS = {      # unit -> (class, factor to the canonical unit: mm, g, ml)
    "mm": ("length", 1.0), "millimeter": ("length", 1.0), "millimeters": ("length", 1.0), "millimetre": ("length", 1.0), "millimetres": ("length", 1.0),
    "cm": ("length", 10.0), "centimeter": ("length", 10.0), "centimeters": ("length", 10.0), "centimetre": ("length", 10.0), "centimetres": ("length", 10.0),
    "m": ("length", 1000.0), "meter": ("length", 1000.0), "meters": ("length", 1000.0), "metre": ("length", 1000.0), "metres": ("length", 1000.0),
    "in": ("length", 25.4), "inch": ("length", 25.4), "inches": ("length", 25.4), "ft": ("length", 304.8), "foot": ("length", 304.8), "feet": ("length", 304.8),
    "g": ("weight", 1.0), "gram": ("weight", 1.0), "grams": ("weight", 1.0), "gramme": ("weight", 1.0), "grammes": ("weight", 1.0),
    "kg": ("weight", 1000.0), "kilogram": ("weight", 1000.0), "kilograms": ("weight", 1000.0), "kilo": ("weight", 1000.0), "kilos": ("weight", 1000.0),
    "oz": ("weight", 28.349523125), "ounce": ("weight", 28.349523125), "ounces": ("weight", 28.349523125),
    "lb": ("weight", 453.59237), "lbs": ("weight", 453.59237), "pound": ("weight", 453.59237), "pounds": ("weight", 453.59237),
    "ml": ("volume", 1.0), "milliliter": ("volume", 1.0), "milliliters": ("volume", 1.0), "millilitre": ("volume", 1.0), "millilitres": ("volume", 1.0),
    "cl": ("volume", 10.0), "l": ("volume", 1000.0), "liter": ("volume", 1000.0), "liters": ("volume", 1000.0), "litre": ("volume", 1000.0), "litres": ("volume", 1000.0),
    "fl oz": ("volume", 29.5735295625), "floz": ("volume", 29.5735295625), "fluid ounce": ("volume", 29.5735295625), "fluid ounces": ("volume", 29.5735295625),
    "gal": ("volume", 3785.411784), "gallon": ("volume", 3785.411784), "gallons": ("volume", 3785.411784),
}
SPEC_CANON = {"length": "mm", "weight": "g", "volume": "ml"}
SPEC_LENGTH_FIELDS = ("length", "width", "height", "depth", "diameter", "thickness")
SPEC_FIELD_CLASS = {**{f: "length" for f in SPEC_LENGTH_FIELDS}, "weight": "weight", "volume": "volume"}      # capacity is free: litres, kilograms or mAh
SPEC_SOURCE_KINDS = ["manufacturer", "brand", "regulatory", "supplier", "retailer", "marketplace", "test", "derived", "measured", "other"]
SPEC_DOC_FIELDS = ("documents", "manual", "datasheet", "video")
SPEC_TEXT_SPLIT_FIELDS = {"dimensions", "measurements", "dims"}
PHOTO_ANGLE_RX = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")
PHOTO_RIGHTS = ["unknown", "stated-for-resellers", "licensed", "own-sample"]      # anything but unknown needs a --note saying where the page states it
PHOTO_SOURCE_KINDS = ["manufacturer", "brand", "supplier", "retailer", "marketplace", "test", "other"]


def _spec_paths(run):
    d = _vb_dir(run)
    return d / "specs.json", d / "specs.json.lock"


def _photo_paths(run):
    d = _vb_dir(run)
    return d / "photos.json", d / "photos.json.lock"


def _spec_field(s) -> str:
    """The field a fact is filed under: lowercase words joined by underscores. Spellings are NOT folded (colour and color are two fields to the table: use one)."""
    return re.sub(r"[^a-z0-9]+", "_", unicodedata.normalize("NFKC", str(s or "")).casefold()).strip("_")


def _pick_number(run, cand):
    """The pick order the AGENT recorded on the candidate (`candidates set --pick-rank N`), or None."""
    c = next((x for x in _vb_load(_cd_paths(run)[0], {"items": []})["items"] if x["id"] == cand), None)
    return (c or {}).get("pick_rank")


def _fmt_num(x, nd=2) -> str:
    s = f"{x:.{nd}f}"
    if "." in s:
        s = s.rstrip("0").rstrip(".")
    return s or "0"


def _pack_dir(run, cand, name=None, create=False):
    """The reference-pack folder of a candidate. It is named after the CANDIDATE (reference-C##-<name>) and remembered in photos.json, so that a
    re-ranking, which renumbers the picks, can never send two products into one folder or move a pack. Returns None when it does not exist
    and create is False."""
    p, lk = _photo_paths(run)
    rel = (_vb_load(p, {"items": []}).get("packs") or {}).get(cand)
    if rel is None:
        if not create:
            return None
        with FileLock(lk):
            data = _vb_load(p, {"created": now_iso(), "items": []})
            rel = data.setdefault("packs", {}).get(cand)
            if rel is None:
                rel = f"deliverables/reference-{cand}-{slugify(name or cand, 28)}"
                data["packs"][cand] = rel
                data["updated"] = now_iso()
                write_json(p, data)
    return Path(run) / rel


def _spec_display(cls, value_si, value, unit) -> str:
    if cls == "length":
        return f"{_fmt_num(value_si / 10.0, 1)} cm ({_fmt_num(value_si / 25.4, 2)} in)"
    if cls == "weight":
        if value_si >= 1000:
            return f"{_fmt_num(value_si / 1000.0, 3)} kg ({_fmt_num(value_si / 453.59237, 2)} lb)"
        return f"{_fmt_num(value_si, 1)} g ({_fmt_num(value_si / 28.349523125, 2)} oz)"
    if cls == "volume":
        return f"{_fmt_num(value_si, 0)} ml ({_fmt_num(value_si / 1000.0, 2)} L; {_fmt_num(value_si / 29.5735295625, 1)} fl oz)"
    return f"{_fmt_num(value)} {unit}".strip()


def _spec_fact_cell(f):
    """One fact as text: what the source said, converted to the other units where it is a size, a weight or a volume."""
    if f.get("text") is not None:
        return str(f["text"])
    if f.get("unit_class") in SPEC_CANON:
        return f"{_spec_display(f['unit_class'], f['value_si'], f['value'], f['unit'])} (as given: {_fmt_num(f['value'], 3)} {f['unit']})"
    return f"{_fmt_num(f['value'], 3)} {f['unit']}".strip()


def _spec_groups(facts):
    """{(field, scope): [facts, in the order they were registered]}"""
    g = {}
    for f in sorted(facts, key=lambda f: int(f["id"][2:])):
        g.setdefault((f["field"], f["scope"]), []).append(f)
    return g


def _spec_spread(fs):
    """Plain arithmetic over the numeric facts of one group that share a unit class: count, lowest, highest and the highest as a percent above the lowest."""
    nums = [f for f in fs if f.get("value_si") is not None]
    if not nums:
        return None
    unit = nums[0].get("si_unit")
    vals = [f["value_si"] for f in nums if f.get("si_unit") == unit]
    lo, hi = min(vals), max(vals)
    return {"n": len(vals), "lowest": lo, "highest": hi, "unit": unit, "highest_above_lowest_pct": round((hi / lo - 1.0) * 100.0, 1) if lo else None}


def _spec_judgement(judgements, cand, field, scope, variant):
    """The agent's latest recorded judgement for a field: the one for the variant asked for, else the one that holds for every variant."""
    mine = [j for j in judgements if j["cand"] == cand and j["field"] == field and j["scope"] == scope]
    for v in ([_norm(variant)] if variant else []) + [""]:
        hit = [j for j in mine if _norm(j.get("variant")) == v]
        if hit:
            return hit[-1]
    return None


def _spec_md(name, cand, variant, facts, judgements, rejected, excluded) -> list:
    groups = _spec_groups(facts)
    L = [f"# {name or cand} - specification sheet", "",
         f"Candidate {cand} · variant: {variant or 'all (no filter)'} · generated {now_iso()}", "",
         "Every fact is shown with its source, grade and date. **The status and the value on the sheet are the researching agent's recorded judgement (`spec judge`)**, "
         "with the reason; where none was recorded, the sheet lists the facts side by side and says so. The tool picks nothing. A size or weight is never read off a photo; "
         "a fact that was not found is written 'not found'.", ""]

    def src(f):
        return f"{_md_cell(f['source'])} ({f['grade']}, {f['source_kind']}, {f['retrieved']}{', copy of ' + f['copy_of'] if f.get('copy_of') else ''})"

    def block(keys, scope="product", title=None, numbered=()):
        got = [(k, groups[(k, scope)]) for k in keys if (k, scope) in groups]
        if not got:
            return []
        out_ = [f"## {title}", ""]
        for k, fs in got:
            j = _spec_judgement(judgements, cand, k, scope, variant)
            if j:
                shown = (_spec_fact_cell(next(f for f in fs if f["id"] == j["fact"])) if j.get("fact") and any(f["id"] == j["fact"] for f in fs)
                         else (j.get("text") or (f"{j.get('value')} {j.get('unit') or ''}".strip() if j.get("value") is not None else "the fact(s) cited below")))
                out_.append(f"**{k}:** {shown} — *{j['status']}* — {j['reason']} ({j.get('by') or 'agent'}, {j['at'][:10]}; based on {', '.join(j.get('facts') or ([j['fact']] if j.get('fact') else [])) or 'the facts below'})")
            else:
                out_.append(f"**{k}:** no judgement recorded")
            sp = _spec_spread(fs)
            if sp and sp["n"] > 1:
                out_.append(f"  - the {sp['n']} numeric facts run from {sp['lowest']} to {sp['highest']} {sp['unit']} ({sp['highest_above_lowest_pct']} % above the lowest)")
            for f in fs:
                out_.append(f"  - {f['id']}: {_md_cell(_spec_fact_cell(f))} — {src(f)}" + (f" — variant: {f['variant']}" if f.get("variant") else ""))
            out_.append("")
        return out_

    ident = [k for k in ("brand", "model", "variant", "sku", "gtin") if (k, "product") in groups]
    L += block(ident, title="Reference unit")
    L += block(list(SPEC_LENGTH_FIELDS) + ["weight", "volume", "capacity"], title="Size and weight (the product itself)")
    packaged = sorted((k for (k, s_) in groups if s_ == "packaged"), key=lambda k: (0 if k in SPEC_LENGTH_FIELDS else 1 if k == "weight" else 2, k))
    L += block(packaged, scope="packaged", title="Packaged (for shipping)")
    L += block(["material", "texture", "finish"], title="Materials, texture and finish")
    L += block(["colour", "variants"], title="Colours and variants")
    L += block(["usage", "steps", "features", "included", "accessories", "care", "warnings", "openings", "branding", "print"], title="Usage and features")
    L += block(["certifications"], title="Certifications and labels (as the sources list them; the compliance lane decides)")
    L += block(list(SPEC_DOC_FIELDS), title="Documents (manuals, datasheets, videos)")
    used = {"brand", "model", "variant", "sku", "gtin"} | set(SPEC_LENGTH_FIELDS) | {"weight", "volume", "capacity", "material", "texture", "finish", "colour", "variants",
                                                                                       "usage", "steps", "features", "included", "accessories", "care", "warnings", "openings",
                                                                                       "branding", "print", "certifications"} | set(SPEC_DOC_FIELDS)
    rest = sorted(k for (k, s_) in groups if k not in used and s_ == "product")
    L += block(rest, title="Technical and other facts")
    if excluded:
        L += ["## Facts for other variants (left out by --variant)", "", "| id | field | variant |", "|---|---|---|"]
        L += [f"| {f['id']} | {f['field']} | {_md_cell(f.get('variant'))} |" for f in excluded]
        L.append("")
    if rejected:
        L += ["## Rejected facts (kept on record)", "", "| id | fact | source | why |", "|---|---|---|---|"]
        L += [f"| {f['id']} | {f['field']} {_md_cell(_spec_fact_cell(f))} | {_md_cell(f['source'])} | {_md_cell(f.get('rejected_reason'))} |" for f in rejected]
        L.append("")
    srcs = {}
    for f in facts:
        d = _domain(f["source"]) if str(f["source"]).startswith("http") else "method"
        srcs.setdefault((d, f["source_kind"], f["grade"]), set()).add(f["retrieved"])
    L += ["## Sources", "", "| domain | kind | grade | retrieved |", "|---|---|---|---|"]
    L += [f"| {d} | {k} | {g} | {', '.join(sorted(r))} |" for (d, k, g), r in sorted(srcs.items())]
    cfg = vb_cfg()
    none_ = [f for f in cfg["spec_core_fields"] if (f, "product") not in groups]
    L += ["", f"Core fields with no fact recorded: {', '.join(none_) or 'none'}."]
    return L


def _valid_date(s) -> bool:
    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", s or ""):
        return False
    try:
        dt.date.fromisoformat(s)
        return True
    except ValueError:
        return False


def cmd_spec(a):
    """The sourced specification of a candidate: a RECORD of facts, each with its source, grade, kind, date and variant, set side by side. The tool converts units
    and does plain arithmetic (the spread of numbers that differ); it does not cluster facts, judge that two texts agree, name a lead value or hand out a status.
    The researching agent reads the facts and records its judgement per field with `spec judge` (the value it stands behind, a status in its own words, the reason);
    the sheet shows that judgement, or says that none was recorded."""
    p, lk = _spec_paths(a.run)
    if a.action == "reject":        # a fact found to be wrong (another variant, a typo in a listing) stays on record but no longer appears on the sheet
        if not (a.id and (a.reason or "").strip()):
            fail("spec reject needs --id (SP###) and --reason", 2)
        with FileLock(lk):
            data = _vb_load(p, {"items": []})
            row = next((f for f in data["items"] if f["id"] == a.id), None)
            if not row:
                fail(f"unknown fact {a.id}", 2)
            row["rejected"], row["rejected_reason"], row["rejected_by"], row["rejected_at"] = True, a.reason, a.by, now_iso()
            copies = [f["id"] for f in data["items"] if f.get("copy_of") == a.id and not f.get("rejected")]
            gone = []
            if a.with_copies:                    # only when the agent says so: the facts recorded as copies of this one go with it
                for f in data["items"]:
                    if f["id"] in copies:
                        f["rejected"], f["rejected_reason"], f["rejected_by"], f["rejected_at"] = True, f"recorded as a copy of {a.id}, which was rejected: {a.reason}", a.by, now_iso()
                        gone.append(f["id"])
            data["updated"] = now_iso()
            write_json(p, data)
        out({"ok": True, "id": a.id, "rejected": True, "recorded_as_copies_of_it": copies, "copies_rejected": gone})
    cands = {c["id"]: c for c in _vb_load(_cd_paths(a.run)[0], {"items": []})["items"]}
    if not a.cand:
        fail(f"spec {a.action} needs --cand", 2)
    if a.cand not in cands:
        fail(f"unknown candidate {a.cand}", 2)
    if a.action == "add":
        field = _spec_field(a.field)
        if not field:
            fail("spec add needs --field (for example width, weight, material, usage)", 2)
        if (a.value is None) == (a.text is None):
            fail("spec add needs exactly one of --value (with --unit) or --text", 2)
        if a.text is not None and field in SPEC_TEXT_SPLIT_FIELDS:
            fail("register each dimension as its own numeric fact (--field width|height|depth|length|diameter|thickness --value N --unit cm), not as one text", 2)
        if a.text is not None and field in SPEC_FIELD_CLASS:
            fail(f"{field} is a number: use --value with --unit", 2)
        if not a.source or not a.source_kind or not a.grade:
            fail("spec add needs --source, --source-kind and --grade", 2)
        if a.grade in ("A", "B") and a.source_kind != "measured":
            if not re.match(r"^https?://", a.source.strip(), re.I):
                fail("a grade A or B fact needs the source URL (a page, manual or datasheet that states it); use grade C with a method for an estimate or D for an unverified claim", 2)
            if re.search(r"[\s\\]", a.source.strip()):
                fail("the source address has whitespace or a backslash: give the clean URL of the page", 2)
        retrieved = a.retrieved or dt.date.today().isoformat()
        if not _valid_date(retrieved):
            fail("--retrieved must be a real date, YYYY-MM-DD", 2)
        row = {"cand": a.cand, "field": field, "scope": a.scope, "variant": (a.variant or "").strip(), "value": None, "unit": None, "unit_class": None,
               "value_si": None, "si_unit": None, "text": None, "source": a.source.strip(), "domain": _domain(a.source) if re.match(r"^https?://", a.source.strip(), re.I) else "method",
               "source_kind": a.source_kind, "grade": a.grade, "retrieved": retrieved, "note": a.note, "site": _site_key(a.source), "by": a.by, "added": now_iso()}
        if a.value is not None:
            if not math.isfinite(a.value) or a.value <= 0:
                fail("--value must be a positive number", 2)
            unit = re.sub(r"\s+", " ", (a.unit or "").strip().lower().replace(".", ""))
            if not unit:
                fail("a numeric fact needs --unit", 2)
            want = SPEC_FIELD_CLASS.get(field)
            if unit in SPEC_UNITS:
                cls, factor = SPEC_UNITS[unit]
                if want and cls != want:
                    fail(f"{field} is a {want}: the unit {unit!r} is a {cls}", 2)
                value_si = round(a.value * factor, 4)
                if not math.isfinite(value_si) or value_si > 1e9:
                    fail("--value is out of range", 2)
                row.update({"value": a.value, "unit": unit, "unit_class": cls, "value_si": value_si, "si_unit": SPEC_CANON[cls]})
            elif want:
                fail(f"unknown unit {unit!r} for {field}; accepted: {', '.join(sorted(u for u, (c, _f) in SPEC_UNITS.items() if c == want and len(u) <= 5))}, and their spelled-out names", 2)
            else:
                row.update({"value": a.value, "unit": unit, "unit_class": "other", "value_si": a.value, "si_unit": unit})
        else:
            if not a.text.strip():
                fail("--text is empty", 2)
            row["text"] = a.text.strip()
        with FileLock(lk):
            data = _vb_load(p, {"created": now_iso(), "items": []})
            if a.copy_of:
                orig = next((f for f in data["items"] if f["id"] == a.copy_of and f["cand"] == a.cand), None)
                if not orig:
                    fail(f"--copy-of {a.copy_of} is not a fact of {a.cand}", 2)
                row["copy_of"], row["site"] = orig["id"], orig.get("site") or orig.get("domain")      # recorded as a copy: the same site, as the agent states
            key = (row["cand"], row["field"], row["scope"], row["variant"], row["value_si"], _norm(row["text"]), row["source"], row["grade"], row["source_kind"])
            prior_rejected = None
            for f in data["items"]:
                if (f["cand"], f["field"], f["scope"], f["variant"], f["value_si"], _norm(f["text"]), f["source"], f["grade"], f["source_kind"]) == key:
                    if f.get("rejected"):
                        prior_rejected = f["id"]
                    else:
                        out({"ok": True, "id": f["id"], "duplicate": True})
            row["id"] = f"SP{len(data['items']) + 1:03d}"
            same_site = [f["id"] for f in data["items"] if f["cand"] == a.cand and f["field"] == field and f["scope"] == row["scope"] and not f.get("rejected")
                         and (f.get("site") or f.get("domain")) == row["site"]]
            data["items"].append(row)
            data["updated"] = now_iso()
            write_json(p, data)
        out({"ok": True, "id": row["id"], "field": field, "scope": row["scope"], "value_si": row["value_si"], "si_unit": row["si_unit"], "site": row["site"],
             "other_facts_of_this_field_from_the_same_site": same_site, "same_exact_fact_was_rejected_as": prior_rejected})
    data = _vb_load(p, {"items": []})
    all_facts = [f for f in data["items"] if f["cand"] == a.cand]
    judgements = data.get("judgements", [])
    if a.action == "judge":
        field = _spec_field(a.field)
        if not (field and (a.status or "").strip() and (a.reason or "").strip()):
            fail("spec judge needs --field, --status (your label for how sure you are: in your own words) and --reason (the sentence saying why)", 2)
        fact_ids = [x for x in re.split(r"[,\s]+", a.fact or "") if x]
        bad = [x for x in fact_ids if not any(f["id"] == x and f["cand"] == a.cand for f in all_facts)]
        if bad:
            fail(f"unknown fact(s) for {a.cand}: {bad}", 2)
        if not fact_ids and a.text is None and a.value is None:
            fail("spec judge needs the value you stand behind: --fact SP### (one or several, comma separated: the first is shown), or --text, or --value with --unit", 2)
        j = {"cand": a.cand, "field": field, "scope": a.scope, "variant": (a.variant or "").strip(), "fact": fact_ids[0] if fact_ids else None, "facts": fact_ids,
             "text": a.text, "value": a.value, "unit": a.unit, "status": a.status.strip(), "reason": a.reason.strip(), "by": a.by, "at": now_iso()}
        with FileLock(lk):
            data = _vb_load(p, {"created": now_iso(), "items": []})
            j["id"] = f"J{len(data.setdefault('judgements', [])) + 1:03d}"
            data["judgements"].append(j)
            data["updated"] = now_iso()
            write_json(p, data)
        out({"ok": True, "id": j["id"], "field": field, "scope": a.scope, "status": j["status"]})
    live = [f for f in all_facts if not f.get("rejected")]
    if a.action == "list":
        rows = [f for f in all_facts if (not a.field or f["field"] == _spec_field(a.field))]
        if a.md:
            print("| id | field | scope | variant | as given | grade | kind | site | retrieved | source | copy of | rejected |\n|---|---|---|---|---|---|---|---|---|---|---|---|")
            for f in rows:
                print(f"| {f['id']} | {f['field']} | {f['scope']} | {_md_cell(f['variant'])} | {_md_cell(_spec_fact_cell(f))} | {f['grade']} | {f['source_kind']} | {f.get('site')} | "
                      f"{f['retrieved']} | {_md_cell(f['source'])} | {f.get('copy_of') or ''} | {_md_cell(f.get('rejected_reason') or '')} |")
        out({"ok": True, "count": len(rows), "items": rows if not a.md else [f["id"] for f in rows]})
    if a.action == "table":
        groups = _spec_groups(live)
        print("| field | scope | facts | values side by side (id: value, grade, site) | spread | judgement on record |\n|---|---|---|---|---|---|")
        res = {}
        for (field, scope), fs in sorted(groups.items()):
            sp = _spec_spread(fs)
            j = _spec_judgement(judgements, a.cand, field, scope, a.variant)
            side = "; ".join(f"{f['id']}: {_spec_fact_cell(f)} ({f['grade']}, {f.get('site')}{', variant ' + f['variant'] if f.get('variant') else ''})" for f in fs)
            print(f"| {field} | {scope} | {len(fs)} | {_md_cell(side)} | "
                  f"{(str(sp['highest_above_lowest_pct']) + ' % above the lowest') if sp and sp['n'] > 1 else '-'} | {_md_cell((j['status'] + ': ' + j['reason']) if j else 'none')} |")
            res[f"{field}|{scope}"] = {"facts": [f["id"] for f in fs], "spread": sp, "judgement": j}
        out({"ok": True, "fields": len(res), "table": res})
    if a.action == "gaps":
        cfg = vb_cfg()
        rows = []
        for field in cfg["spec_core_fields"]:
            fs = [f for f in live if f["field"] == field and f["scope"] == "product"]
            rows.append({"field": field, "facts": len(fs), "judgements": len([j for j in judgements if j["cand"] == a.cand and j["field"] == field and j["scope"] == "product"])})
        print("| core field | facts recorded | judgements recorded |\n|---|---|---|\n" + "\n".join(f"| {r['field']} | {r['facts']} | {r['judgements']} |" for r in rows))
        out({"ok": True, "core_fields": rows, "no_fact_recorded": [r["field"] for r in rows if not r["facts"]], "no_judgement_recorded": [r["field"] for r in rows if not r["judgements"]]})
    # render: the sheet of the candidate (spec.md and spec.json) in its pack folder, or --out
    name = cands[a.cand].get("name")
    variant = (a.variant or "").strip()
    keep = [f for f in live if not variant or _norm(f.get("variant")) in ("", _norm(variant))]
    excluded = [f for f in live if f not in keep]
    L = _spec_md(name, a.cand, variant, keep, judgements, [f for f in all_facts if f.get("rejected")], excluded)
    pack = None if a.out else _pack_dir(a.run, a.cand, name, create=True)
    md_path = Path(a.out) if a.out else pack / "spec.md"
    groups = _spec_groups(keep)
    js = {"cand": a.cand, "name": name, "pick": _pick_number(a.run, a.cand), "variant": variant or None, "generated": now_iso(),
          "fields": {f"{k}|{sc}": {"facts": [{kk: f.get(kk) for kk in ("id", "value", "unit", "text", "grade", "source", "source_kind", "retrieved", "variant", "site", "copy_of", "note")} for f in fs],
                                   "spread": _spec_spread(fs), "judgement": _spec_judgement(judgements, a.cand, k, sc, variant)} for (k, sc), fs in sorted(groups.items())},
          "facts_for_other_variants": [f["id"] for f in excluded]}
    write_text(md_path, "\n".join(L) + "\n")
    write_json(md_path.with_suffix(".json"), js)
    out({"ok": True, "md": str(md_path), "json": str(md_path.with_suffix(".json")), "pack": str(md_path.parent), "variant": variant or None,
         "fields": len(groups), "fields_with_a_judgement": sum(1 for (k, sc) in groups if js["fields"][f"{k}|{sc}"]["judgement"]), "facts_for_other_variants": [f["id"] for f in excluded]})


PHOTO_UA = "Mozilla/5.0 (compatible; atg-product-reference; read-only)"
PHOTO_BASIS = ["caption", "filename", "gallery-order", "page-text", "other"]
PHOTO_OK_TYPES = ("image/jpeg", "image/jpg", "image/pjpeg", "image/png", "image/webp")
PHOTO_SIZE_KEYS = {"w", "h", "width", "height", "size", "sz", "q", "quality", "fit", "fm", "format", "dpr", "resize", "crop", "auto", "scale",
                   "t", "ts", "v", "ver", "version", "cache", "cb", "rev"}
PHOTO_EXPIRY_KEYS = {"expires", "expire", "exp", "signature", "sig", "token", "access_token", "x-amz-signature", "x-amz-expires", "x-goog-signature",
                     "x-goog-expires", "hdnts", "key-pair-id", "policy", "se"}
_NONPUBLIC = "ATG-NONPUBLIC"


def _photo_angle(raw) -> str:
    """The view a link shows, as the caller wrote it: lowercase, words joined by hyphens. Spellings are NOT folded (rear and back are two labels to the table)."""
    return re.sub(r"[\s_]+", "-", str(raw or "").strip().lower())


def _photo_expiring_keys(url) -> list:
    """The query parameters of an address that look like a signature or an expiry (it may stop working): a fact about the address."""
    from urllib.parse import parse_qsl, urlsplit
    return sorted({k.lower() for k, _v in parse_qsl(urlsplit(url).query, keep_blank_values=True)} & PHOTO_EXPIRY_KEYS)


def _photo_expiring(url) -> bool:
    return bool(_photo_expiring_keys(url))


def _url_parts(url):
    """(scheme, host, port) the way urllib3 will read the address, or (None, reason, None). It refuses what two parsers could read differently:
    whitespace, control characters, backslashes, user information, and any address that urllib3 and urllib.parse split differently."""
    from urllib.parse import urlsplit
    import urllib3.util
    u = str(url or "")
    if re.search(r"[\s\x00-\x1f\x7f\\]", u):
        return None, "the address has whitespace, a control character or a backslash", None
    try:
        a = urllib3.util.parse_url(u)
        b = urlsplit(u)
    except Exception as e:
        return None, f"unreadable address: {str(e)[:60]}", None
    if a.scheme not in ("http", "https") or not a.host:
        return None, "only http and https addresses are fetched", None
    if a.auth or "@" in (b.netloc or ""):
        return None, "an address with user information (user@host) is not fetched", None
    host = a.host.strip("[]").lower()
    try:
        same = (b.hostname or "").lower() == host
        port = a.port or (443 if a.scheme == "https" else 80)
    except ValueError:
        same, port = False, None
    if not same:
        return None, "the address is read differently by two parsers: not fetched", None
    return a.scheme, host, port


def _ip_error(ip_text):
    """None when an address is public. An address that embeds an IPv4 address (IPv4-mapped, NAT64, 6to4) is judged by the embedded one; Teredo is refused."""
    import ipaddress
    try:
        ip = ipaddress.ip_address(str(ip_text).split("%")[0])
    except ValueError:
        return f"{ip_text} is not an IP address"
    inner = []
    if isinstance(ip, ipaddress.IPv6Address):
        if ip.ipv4_mapped:
            inner.append(ip.ipv4_mapped)
        if ip.sixtofour:
            inner.append(ip.sixtofour)
        if ip in ipaddress.ip_network("64:ff9b::/96"):
            inner.append(ipaddress.IPv4Address(int(ip) & 0xFFFFFFFF))
        if ip.teredo:
            return f"{ip} is a Teredo address"
    for x in [ip] + inner:
        if not x.is_global or x.is_multicast:
            return f"{ip} is not a public address"
    return None


def _public_host_error(url, allow_private=False):
    """None when the URL is http(s) and its host resolves only to public addresses; otherwise the reason it is not fetched. A product page is
    public: an address on the user's own machine or network is never a product photo. `allow_private` exists for the local test server only."""
    import socket
    scheme, host, port = _url_parts(url)
    if scheme is None:
        return host
    if allow_private:
        return None
    try:
        infos = socket.getaddrinfo(host, port, proto=socket.IPPROTO_TCP)
    except Exception as e:
        return f"cannot resolve {host}: {str(e)[:80]}"
    for info in infos:
        why = _ip_error(info[4][0])
        if why:
            return f"{host} resolves to a non-public address ({why}): not fetched"
    return None


_GUARD = threading.local()
_GUARD_INSTALLED = []


def _install_connect_guard():
    """Once per process: every outgoing connection of the thread that switched the guard on (_GUARD.on) goes to an address that has just been checked.
    The name is resolved here, every address must be public, and the socket is opened to that checked address, so a name cannot answer differently the
    second time (DNS rebinding). Other threads and other uses of the library are not touched."""
    if _GUARD_INSTALLED:
        return
    import socket
    import urllib3.util.connection as uc
    orig = uc.create_connection

    def guarded(address, timeout=socket._GLOBAL_DEFAULT_TIMEOUT, source_address=None, socket_options=None):
        if not getattr(_GUARD, "on", False):
            return orig(address, timeout, source_address, socket_options)
        host, port = address
        host = host.strip("[]") if isinstance(host, str) else host
        infos = socket.getaddrinfo(host, port, 0, socket.SOCK_STREAM)
        for info in infos:
            why = _ip_error(info[4][0])
            if why:
                raise OSError(f"{_NONPUBLIC}: {host}: {why}")
        err = None
        for af, st, proto, _cn, sa in infos:
            sock = None
            try:
                sock = socket.socket(af, st, proto)
                for opt in (socket_options or []):
                    sock.setsockopt(*opt)
                if timeout is not socket._GLOBAL_DEFAULT_TIMEOUT:
                    sock.settimeout(timeout)
                if source_address:
                    sock.bind(source_address)
                sock.connect(sa)
                return sock
            except OSError as e:
                err = e
                if sock is not None:
                    sock.close()
        raise err or OSError(f"no address for {host}")

    uc.create_connection = guarded
    _GUARD_INSTALLED.append(True)


def _proxy_for(url):
    """The environment proxy that applies to this very address, or None. When a proxy applies the connection goes to the proxy, so the connect-time check
    stands aside for that address (the address checks before the request still apply)."""
    try:
        import requests.utils as ru
        return ru.select_proxy(url, ru.get_environ_proxies(url))
    except Exception:
        return None


def _with_deadline(fn, seconds):
    """Run fn() in a daemon thread and stop waiting after `seconds`: a server that trickles bytes, or a page that makes the parser crawl, cannot hold the
    command. Returns (finished, value); an exception raised by fn is raised here."""
    box = {}

    def run():
        try:
            box["v"] = fn()
        except BaseException as e:
            box["e"] = e

    th = threading.Thread(target=run, daemon=True)
    th.start()
    th.join(seconds)
    if th.is_alive():
        return False, None
    if "e" in box:
        raise box["e"]
    return True, box.get("v")


def _http_get_inner(url, referer, accept, max_bytes, allow_private, ctype_error):
    import requests  # type: ignore
    from urllib.parse import urljoin
    _install_connect_guard()
    headers = {"User-Agent": PHOTO_UA, "Accept": accept}
    if referer:
        headers["Referer"] = referer
    last = None
    for attempt in range(3):
        try:
            cur = url
            for _hop in range(6):
                why = _public_host_error(cur, allow_private)
                if why:
                    return None, why, None, "", cur
                _GUARD.on = (not allow_private) and _proxy_for(cur) is None
                with requests.get(cur, stream=True, timeout=(15, 60), headers=headers, allow_redirects=False) as r:
                    if r.status_code in (301, 302, 303, 307, 308) and r.headers.get("Location"):
                        cur = urljoin(cur, r.headers["Location"])
                        continue
                    if 400 <= r.status_code < 500:
                        return None, f"blocked or not found: HTTP {r.status_code} (not retried, not bypassed)", r.status_code, "", cur
                    if r.status_code >= 500:
                        raise IOError(f"HTTP {r.status_code}")
                    ctype = r.headers.get("Content-Type", "").split(";")[0].strip().lower()
                    bad = ctype_error(ctype) if ctype_error else None
                    if bad:
                        return None, bad, r.status_code, ctype, cur
                    chunks, n = [], 0
                    for chunk in r.iter_content(1 << 20):
                        n += len(chunk)
                        if n > max_bytes:
                            return None, f"larger than {max_bytes / 1e6:.0f} MB", r.status_code, ctype, cur
                        chunks.append(chunk)
                    return b"".join(chunks), None, r.status_code, ctype, cur
            return None, "too many redirects", None, "", cur
        except Exception as e:
            if _NONPUBLIC in str(e):
                return None, "the address resolved to a non-public address when the connection was made: not fetched", None, "", url
            last = str(e)[:200]
            time.sleep(2 ** attempt)
    return None, f"download failed: {last}", None, "", url


def _http_get(url, referer, accept, max_bytes, allow_private=False, ctype_error=None, deadline=45):
    """One read-only GET of a PAGE with the toolkit's fixed identity (it never changes it). Redirects are followed by hand, at most 5, and every hop
    must be a public http(s) address (checked before the request and again at connect time). A 4xx answer (a login wall, a block, a rate limit, a
    missing file) is final: it is never retried and never worked around. Server errors and timeouts are retried twice. ctype_error(content type) may
    refuse a response before its body is read. The whole call gives up after `deadline` seconds.
    Returns (body | None, error | None, http status | None, content type, final url). Images are never fetched: see _probe_link."""
    finished, v = _with_deadline(lambda: _http_get_inner(url, referer, accept, max_bytes, allow_private, ctype_error), deadline)
    if not finished:
        return None, f"the server did not finish answering within {deadline} seconds: not read", None, "", url
    return v


def _html_ctype_error(ctype):
    if not ctype:
        return "the server states no content type: not read as a page"
    if ctype not in ("text/html", "application/xhtml+xml", "text/plain"):
        return f"not an HTML page (Content-Type {ctype})"
    return None


def _probe_inner(url, allow_private):
    import requests  # type: ignore
    from urllib.parse import urljoin
    _install_connect_guard()
    headers = {"User-Agent": PHOTO_UA, "Accept": "image/jpeg,image/png,image/webp,*/*;q=0.5"}      # no Referer: like Higgsfield's importer and the gallery page
    res = {"link_status": "unchecked", "http": None, "content_type": None, "bytes": None, "final_url": None, "error": None}
    last = None
    for attempt in range(2):
        try:
            cur = url
            for _hop in range(6):
                why = _public_host_error(cur, allow_private)
                if why:
                    return {**res, "link_status": "refused", "error": why, "final_url": cur if cur != url else None}
                _GUARD.on = (not allow_private) and _proxy_for(cur) is None
                r = requests.head(cur, timeout=(10, 20), headers=headers, allow_redirects=False)
                res["http"] = code = r.status_code
                if code in (301, 302, 303, 307, 308) and r.headers.get("Location"):
                    cur = urljoin(cur, r.headers["Location"])
                    continue
                res["final_url"] = cur if cur != url else None
                ctype = r.headers.get("Content-Type", "").split(";")[0].strip().lower()
                res["content_type"] = ctype or None
                try:
                    res["bytes"] = int(r.headers["Content-Length"]) if r.headers.get("Content-Length") else None
                except ValueError:
                    res["bytes"] = None
                if code in (401, 403, 429):
                    return {**res, "link_status": "blocked", "error": f"HTTP {code}: the site refuses a request like this one (not retried, not bypassed); the link may still load in a browser"}
                if code in (405, 501):
                    return {**res, "link_status": "unchecked", "error": f"HTTP {code}: the server does not answer a header request (and the image is not fetched instead)"}
                if 400 <= code < 500:
                    return {**res, "link_status": "dead", "error": f"HTTP {code}: nothing at this address"}
                if code >= 500:
                    raise IOError(f"HTTP {code}")
                if 200 <= code < 300:
                    if not ctype or ctype in ("application/octet-stream", "binary/octet-stream"):
                        return {**res, "link_status": "unchecked", "error": "the server does not state a content type"}
                    if ctype in PHOTO_OK_TYPES:
                        return {**res, "link_status": "ok"}
                    if ctype.startswith("image/"):
                        return {**res, "link_status": "format", "error": f"{ctype} is not a type the generation tools take as a reference (JPEG, PNG or WebP)"}
                    return {**res, "link_status": "not-image", "error": f"Content-Type {ctype}: this address is not an image"}
                return {**res, "link_status": "unchecked", "error": f"HTTP {code}"}
            return {**res, "link_status": "unchecked", "error": "too many redirects"}
        except Exception as e:
            if _NONPUBLIC in str(e):
                return {**res, "link_status": "refused", "error": "the address resolved to a non-public address when the connection was made: not probed"}
            last = str(e)[:160]
            time.sleep(1 + attempt)
    return {**res, "link_status": "unchecked", "error": f"no answer: {last}"}


def _probe_link(url, referer=None, allow_private=False, deadline=40):
    """Is this image address alive, and is it an image? One HEAD request: the status line and the headers, never a body, so no image is downloaded, and
    when a server does not answer HEAD the link stays unchecked (there is no GET instead). No Referer is sent, as when Higgsfield's importer or the gallery
    page loads the image. Redirects are followed by hand, at most 5, each hop a public http(s) address. link_status: ok (an image of a type the generation
    tools take), format (another image type), not-image, dead (404 and other 4xx), blocked (401, 403, 429: final, never retried or worked around; the link
    may still load in a browser), unchecked (HEAD not answered, no content type, a server error, no answer in `deadline` seconds), refused (not a public
    http(s) address: nothing was sent). A probe from this machine does not promise that another service (Higgsfield's importer, a browser) can fetch it."""
    finished, v = _with_deadline(lambda: _probe_inner(url, allow_private), deadline)
    if not finished:
        return {"link_status": "unchecked", "http": None, "content_type": None, "bytes": None, "final_url": None, "error": f"no answer within {deadline} seconds"}
    return v


def _photo_norm(url) -> str:
    """An image address without its scheme and without the parameters that only change its size or caching: two addresses that normalise alike
    are the same image."""
    from urllib.parse import parse_qsl, urlencode, urlsplit
    u = urlsplit(url.strip())
    q = sorted((k.lower(), v) for k, v in parse_qsl(u.query, keep_blank_values=True) if k.lower() not in PHOTO_SIZE_KEYS)
    return u.netloc.lower() + u.path + ("?" + urlencode(q) if q else "")


from html.parser import HTMLParser

PHOTO_SCRIPT_URL_RX = re.compile(r"""(?:https?:)?//[A-Za-z0-9.-]{1,120}\.[A-Za-z]{2,}(?::\d{1,5})?/[^\s"'<>\\)]{0,200}?\.(?:jpe?g|png|webp)(?:\?[^\s"'<>\\)]{0,200})?""", re.I)


def _parse_srcset(ss):
    """[(address, descriptor)] of a srcset value: candidates are separated by commas, an address may contain commas, a descriptor is 100w or 2x."""
    out_, i, n = [], 0, len(ss)
    while i < n:
        while i < n and (ss[i].isspace() or ss[i] == ","):
            i += 1
        j = i
        while j < n and not ss[j].isspace():
            j += 1
        url, i = ss[i:j], j
        if url.endswith(","):
            url, desc = url.rstrip(","), ""
        else:
            k = ss.find(",", i)
            k = n if k < 0 else k
            desc, i = ss[i:k].strip(), k
        if url:
            out_.append((url, desc))
    return out_


class _ImgCollector(HTMLParser):
    """Collects the image addresses that a product page declares: its Open Graph and Twitter images, the images in its JSON-LD data, link
    rel=image_src and preloaded images, the <img> and <source> tags (src, the lazy-load attributes, the largest srcset entry), links straight to an
    image file, and image addresses written into the page's own scripts (a gallery built from a JSON blob). A <base href> is honoured. It also keeps the
    first 20 KB of the visible text, for the bot-check test."""
    LAZY = ("data-zoom-image", "data-large", "data-large-img", "data-original", "data-hires", "data-src", "data-lazy-src", "data-image", "src")

    def __init__(self, base):
        super().__init__(convert_charrefs=True)
        self.base, self.items, self.title = base, [], ""
        self._ld, self._scr, self._buf, self._in_title, self._base_set, self._hidden, self._text, self._tlen = False, False, [], False, False, 0, [], 0

    @property
    def text(self):
        return " ".join(self._text)[:20000]

    def add(self, url, source, attrs=None, declared=None):
        from urllib.parse import urldefrag, urljoin
        url = (url or "").strip()
        if not url or url.lower().startswith(("data:", "javascript:", "blob:", "about:")):
            return
        try:
            url = urldefrag(urljoin(self.base, url))[0]
        except Exception:
            return
        if not re.match(r"^https?://", url, re.I):
            return
        a = attrs or {}
        dims = [declared] if declared else []
        for k in ("width", "height"):
            m = re.match(r"^\s*(\d{1,5})\s*(px)?\s*$", a.get(k, ""))
            if m:
                dims.append(int(m.group(1)))
        self.items.append({"url": url, "source": source, "alt": (a.get("alt") or a.get("title") or "")[:120],
                           "label": " ".join(x for x in (a.get("class", ""), a.get("id", "")) if x)[:120], "declared_px": max(dims) if dims else None})

    def handle_starttag(self, tag, attrs):
        a = {k.lower(): (v or "") for k, v in attrs}
        if tag == "base" and a.get("href") and not self._base_set:
            from urllib.parse import urljoin
            self.base, self._base_set = urljoin(self.base, a["href"]), True
        elif tag == "meta":
            key = (a.get("property") or a.get("name") or a.get("itemprop") or "").lower()
            if key in ("og:image", "og:image:url", "og:image:secure_url", "twitter:image", "twitter:image:src", "image"):
                self.add(a.get("content"), "meta " + key)
        elif tag == "link":
            rel = a.get("rel", "").lower()
            if "image_src" in rel:
                self.add(a.get("href"), "link image_src")
            elif "preload" in rel and a.get("as", "").lower() == "image":
                self.add(a.get("href"), "link preload")
        elif tag in ("img", "source"):
            for k in self.LAZY:
                if a.get(k):
                    self.add(a[k], f"{tag} {k}", a)
            ss = a.get("srcset") or a.get("data-srcset")
            if ss:
                best, best_key = None, (-1, -1.0)
                for url_, desc in _parse_srcset(ss[:20000]):
                    m = re.match(r"^(\d+(?:\.\d+)?)([wx])$", desc)
                    key = (1 if (m and m.group(2) == "w") else 0, float(m.group(1)) if m else 0.0)
                    if key > best_key:
                        best, best_key = (url_, int(key[1]) if key[0] else None), key
                if best:
                    self.add(best[0], f"{tag} srcset", a, best[1])
        elif tag == "a":
            href = a.get("href", "")
            if re.search(r"\.(jpe?g|png|webp)(\?|$)", href, re.I):
                self.add(href, "a href (linked image)", a)
        elif tag == "script":
            self._scr, self._ld, self._buf = True, "ld+json" in a.get("type", "").lower(), []
        elif tag == "title":
            self._in_title = True
        elif tag in ("style", "noscript"):
            self._hidden += 1

    def handle_data(self, data):
        if self._scr:
            self._buf.append(data)
            return
        if self._in_title and len(self.title) < 200:
            self.title += data
        if not self._hidden and self._tlen < 20000:
            self._text.append(data)
            self._tlen += len(data)

    def handle_endtag(self, tag):
        if tag == "script" and self._scr:
            text, ld = "".join(self._buf)[:400_000], self._ld
            self._scr = self._ld = False
            if ld:
                try:
                    self._walk(json.loads(text))
                except Exception:
                    pass
            elif re.search(r"\.(?:jpe?g|png|webp)", text, re.I):
                text = text.replace("\\u002F", "/").replace("\\u002f", "/").replace("\\/", "/")
                for n, m in enumerate(PHOTO_SCRIPT_URL_RX.finditer(text)):
                    if n >= 200:
                        break
                    self.add(m.group(0), "script data")
        elif tag == "title":
            self._in_title = False
        elif tag in ("style", "noscript") and self._hidden:
            self._hidden -= 1

    def _walk(self, node, depth=0):
        if depth > 40:
            return
        if isinstance(node, list):
            for x in node[:500]:
                self._walk(x, depth + 1)
        elif isinstance(node, dict):
            for k, v in node.items():
                if str(k).lower() == "image":
                    for x in (v if isinstance(v, list) else [v])[:200]:
                        if isinstance(x, str):
                            self.add(x, "json-ld image")
                        elif isinstance(x, dict):
                            self.add(x.get("url") or x.get("contentUrl"), "json-ld image")
                elif isinstance(v, (dict, list)):
                    self._walk(v, depth + 1)


def _photo_find(page_html, page_url, limit):
    """The image addresses a page declares, in the order the page lists them, with what the page says about each: where it was found (meta, JSON-LD, <img>, script
    data ...), its alt text, its class and id text, the size the page declares, its file name and extension, and the signature or expiry parameters in the address.
    No score, no 'looks like a banner' flag and no guess at the view: nobody has looked at any of them, and a page also lists related products, banners and icons,
    so the reader picks. Returns (rows, how many in all, title, the first 300 characters of the visible text, the base address)."""
    from urllib.parse import urlparse
    col = _ImgCollector(page_url)
    try:
        col.feed(page_html)
        col.close()
    except Exception:
        pass
    merged = {}
    for it in col.items:
        u = it["url"]
        name = urlparse(u).path.rsplit("/", 1)[-1]
        ext = name.rsplit(".", 1)[-1].lower() if "." in name else ""
        cur = merged.get(u)
        if cur is None:
            merged[u] = {"url": u, "sources": [it["source"]], "alt": it["alt"], "label": it["label"], "declared_px": it["declared_px"], "file": name, "extension": ext,
                         "expiring_query_keys": _photo_expiring_keys(u)}
        else:
            if it["source"] not in cur["sources"]:
                cur["sources"].append(it["source"])
            cur["declared_px"] = max([x for x in (cur["declared_px"], it["declared_px"]) if x] or [None]) if (cur["declared_px"] or it["declared_px"]) else None
            if not cur["alt"] and it["alt"]:
                cur["alt"] = it["alt"]
            if not cur["label"] and it["label"]:
                cur["label"] = it["label"]
    rows = list(merged.values())
    return rows[:limit], len(rows), col.title.strip(), " ".join(col.text.split())[:300], col.base


def _photo_coverage(rows, cfg):
    """Counts of the recorded links per view label, as written, and for the core views the config lists. A tabulation: no view is 'missing' or 'covered', the agent reads it."""
    live = [r for r in rows if r["status"] == "active"]
    by = {}
    for r in live:
        d = by.setdefault(r["angle"], {"angle": r["angle"], "links": 0, "link_ok": 0, "https": 0, "looked_at": 0, "ids": []})
        d["links"] += 1
        d["link_ok"] += 1 if r.get("link_status") == "ok" else 0
        d["https"] += 1 if r.get("https") else 0
        d["looked_at"] += 1 if r.get("looked_at") else 0
        d["ids"].append(r["id"])
    core = [by.get(x, {"angle": x, "links": 0, "link_ok": 0, "https": 0, "looked_at": 0, "ids": []}) for x in cfg["photo_core_angles"]]
    return {"links": len(live), "link_ok": sum(1 for r in live if r.get("link_status") == "ok"), "link_not_ok": sum(1 for r in live if r.get("link_status") != "ok"),
            "rejected": sum(1 for r in rows if r["status"] == "rejected"), "by_angle": sorted(by.values(), key=lambda d: d["angle"]), "core_angles": core,
            "flags": {"brand_marks": [r["id"] for r in live if r.get("brand_marks")], "watermark": [r["id"] for r in live if r.get("watermark")],
                      "other_variant": [r["id"] for r in live if r.get("same_variant") is False], "rights_unknown": [r["id"] for r in live if r.get("rights", "unknown") == "unknown"]},
            "not_https": [r["id"] for r in live if not r.get("https")], "may_expire": [r["id"] for r in live if r.get("expiring")],
            "looked_at": [r["id"] for r in live if r.get("looked_at")]}


def _photo_md(cand, name, rows, summ=None) -> list:
    L = [f"# {name or cand} - photo links", "",
         "Links to images that belong to their owners. **Nothing was downloaded or stored**: each address was probed with a header request only. "
         "The angle is as the source labels it (the basis column), and no image has been looked at unless the 'looked at' column says so; open `photos.html` "
         "to see them in your browser. A link can expire or be hotlink-protected: save an image yourself if you need to keep it.", ""]
    if summ:
        L += [f"Links: {summ['links']} active, {summ['link_ok']} confirmed as images by a header request, {summ['link_not_ok']} not confirmed; {summ['rejected']} rejected.", "",
              "| core view | links | confirmed | https | looked at |", "|---|---|---|---|---|"]
        L += [f"| {d['angle']} | {d['links']} | {d['link_ok']} | {d['https']} | {d['looked_at']} |" for d in summ["core_angles"]]
        other = [d for d in summ["by_angle"] if d["angle"] not in {x["angle"] for x in summ["core_angles"]}]
        if other:
            L += ["", "Other views recorded: " + ", ".join(f"{d['angle']} ({d['links']}, {d['link_ok']} confirmed)" for d in other)]
        L.append("")
    L += ["| id | angle | basis | source | link | https | may expire | bytes | declared px | variant | looked at | background | watermark | third-party brand marks | same variant | rights | status | image address | found on |",
          "|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|"]
    yn = lambda v: "-" if v is None else ("yes" if v else "no")
    for r in rows:
        why = f" ({_md_cell(r.get('reason'))})" if r.get("reason") else ""
        L.append("| " + " | ".join([r["id"], r["angle"], r.get("basis") or "-", r["source_kind"], r.get("link_status") or "-", "yes" if r.get("https") else "no",
                                    "yes" if r.get("expiring") else "no", str(r["bytes"]) if r.get("bytes") else "-", str(r.get("declared_px") or "-"), _md_cell(r.get("variant") or "-"),
                                    "yes" if r.get("looked_at") else "no", r.get("background") or "-", yn(r.get("watermark")), yn(r.get("brand_marks")),
                                    yn(r.get("same_variant")), r.get("rights", "unknown"), r["status"] + why, _md_cell(r["url"]), _md_cell(r["page_url"])]) + " |")
    return L


def _photo_gallery_html(name, cand, rows, summ) -> str:
    e = lambda s: html.escape("" if s is None else str(s), quote=True)
    live = [r for r in rows if r["status"] == "active"]
    css = ("body{font:14px/1.45 system-ui,sans-serif;margin:16px;background:#fafafa;color:#111}"
           "@media(prefers-color-scheme:dark){body{background:#161616;color:#eee}a{color:#8ab4f8}figure{border-color:#333;background:#1e1e1e}}"
           "h1{font-size:20px;margin:0 0 8px}p{max-width:72ch}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px;margin-top:16px}"
           "figure{margin:0;border:1px solid #ddd;border-radius:8px;padding:8px;background:#fff}"
           "img{width:100%;height:240px;object-fit:contain;background:#ececec;border-radius:4px}figcaption{font-size:12px;margin-top:6px;word-break:break-word}"
           ".warn{color:#a15c00}")
    parts = ["<!doctype html>", '<html lang="en"><head><meta charset="utf-8">', '<meta name="viewport" content="width=device-width,initial-scale=1">',
             '<meta name="referrer" content="no-referrer">', f"<title>{e(name or cand)} - photo links</title>", f"<style>{css}</style></head><body>",
             f"<h1>{e(name or cand)} - photo links</h1>",
             "<p>These are links to images that belong to their owners. Nothing was downloaded or stored: this page makes your browser load each image from its own site. "
             "The angle is as the source labels it, and nobody has looked at an image unless its caption says so. An image that does not load may be hotlink-protected "
             "or may have expired: open its page, and save the image yourself if you need to keep it.</p>"]
    if summ:
        parts.append(f"<p>{summ['links']} active link(s), {summ['link_ok']} confirmed as images by a header request. Core views (links, confirmed): "
                     + e("; ".join(f"{d['angle']} {d['links']}, {d['link_ok']}" for d in summ["core_angles"])) + ".</p>")
    parts.append('<div class="grid">')
    for r in live:
        flags = ", ".join(x for x, on in (("watermark", r.get("watermark")), ("third-party brand marks", r.get("brand_marks")), ("other variant", r.get("same_variant") is False),
                                          ("may expire", r.get("expiring"))) if on)
        cap = [f"<b>{e(r['id'])} &middot; {e(r['angle'])}</b> ({e(r.get('basis') or 'basis not stated')})",
               f"{e(r['source_kind'])} &middot; link: {e(r.get('link_status'))}" + ("" if r.get("https") else ' &middot; <span class="warn">not https</span>')
               + (" &middot; looked at" if r.get("looked_at") else " &middot; not looked at") + f" &middot; rights: {e(r.get('rights', 'unknown'))}"]
        if flags:
            cap.append(f'<span class="warn">{e(flags)}</span>')
        if r.get("variant"):
            cap.append(f"variant: {e(r['variant'])}")
        if r.get("note"):
            cap.append(e(r["note"]))
        cap.append(f'<a href="{e(r["url"])}" rel="noopener noreferrer">image</a> &middot; <a href="{e(r["page_url"])}" rel="noopener noreferrer">found on</a>')
        parts.append(f'<figure><a href="{e(r["url"])}" rel="noopener noreferrer"><img src="{e(r["url"])}" alt="{e((name or cand) + " - " + r["angle"])}" '
                     f'loading="lazy" referrerpolicy="no-referrer"></a><figcaption>{"<br>".join(cap)}</figcaption></figure>')
    parts.append("</div></body></html>")
    return "\n".join(parts) + "\n"


def cmd_photo(a):
    """The photo LINKS of a candidate: pages are read for the image addresses they declare, each address is probed with a header request, and the links are recorded
    with their view label, its basis and what the probe found. Nothing is downloaded. The tool scores no address, flags no 'junk', guesses no view, counts no link as
    enough and suggests no set: which addresses show the reference unit, from which angle, and whether the set is enough are the agent's decisions, recorded with
    `photo set` (the visual flags need --looked-at yes) and read from the coverage table."""
    cfg = vb_cfg()
    p, lk = _photo_paths(a.run)
    cands = {c["id"]: c for c in _vb_load(_cd_paths(a.run)[0], {"items": []})["items"]}
    if not a.cand and a.action != "set":
        fail(f"photo {a.action} needs --cand", 2)
    if a.action == "set":
        data = _vb_load(p, {"items": []})
        row = next((r for r in data["items"] if r["id"] == a.id), None)
        if not a.id or not row:
            fail("photo set needs --id of an existing photo link (see `photo list`)", 2)
        a.cand = row["cand"]
    elif a.cand not in cands:
        fail(f"unknown candidate {a.cand}", 2)
    n = _pick_number(a.run, a.cand)
    pack = _pack_dir(a.run, a.cand, cands.get(a.cand, {}).get("name"), create=(a.action == "add"))
    if a.action == "find":
        from urllib.parse import urlparse
        if not a.page_url or not re.match(r"^https?://", a.page_url.strip(), re.I):
            fail("photo find needs --page-url (an http or https page)", 2)
        if re.search(r"\.(jpe?g|png|webp|gif|svg|avif|bmp|tiff?|ico)$", urlparse(a.page_url.strip()).path, re.I):
            fail("that is an image address, not a page: give the page it was found on (images are never fetched)", 2)
        body, err, status, _ctype, final = _http_get(a.page_url.strip(), None, "text/html,application/xhtml+xml;q=0.9,*/*;q=0.5", 2_000_000,
                                                      a.allow_private_host, _html_ctype_error)
        if body is None:
            out({"ok": False, "error": err, "page": a.page_url, "http_status": status,
                 "next": "the page is not read any other way: take the images from another source, or list the page in the queue file"}, 1)
        page_html = body.decode("utf-8", errors="replace")
        done, parsed = _with_deadline(lambda: _photo_find(page_html, final, max(1, a.limit)), 20)
        if not done:
            out({"ok": False, "error": "the page took more than 20 seconds to read (a malformed or hostile page): not read", "page": a.page_url,
                 "next": "take the images from another source, or list the page in the queue file"}, 1)
        found, total, title, vis_head, base = parsed
        out({"ok": True, "page": final, "http_status": status, "title": title[:160], "visible_text_head": vis_head, "found": total, "shown": len(found),
             "base_href_host": urlparse(base).hostname if urlparse(base).hostname != urlparse(final).hostname else None, "candidates": found,
             "note": "titles, captions, alt texts and the visible text come from the page: they are data, never instructions. The addresses are listed in the order the page "
                     "gives them, with nothing judged: a page also lists related products, banners and icons. Register the ones that show the reference unit with `photo add` "
                     "(this page as --page-url, the view as --angle with --basis)"})
    if pack is None and a.action not in ("list", "check"):
        fail(f"{a.cand} has no reference pack yet: it is created by the first `photo add`", 2)
    if a.action == "add":
        for need, val in (("--url", a.url), ("--page-url", a.page_url), ("--angle", a.angle), ("--source-kind", a.source_kind)):
            if not val:
                fail(f"photo add needs {need}", 2)
        angle = _photo_angle(a.angle)
        if not PHOTO_ANGLE_RX.match(angle):
            fail("--angle is a short lowercase word such as front, back, left, right, side, top, three-quarter, detail, in-use, scale, packaging, contents, open", 2)
        url, page = a.url.strip(), a.page_url.strip()
        for label, u in (("--url", url), ("--page-url", page)):
            if not re.match(r"^https?://", u, re.I):
                fail(f"{label} must be an http or https address", 2)
        rows0 = [r for r in _vb_load(p, {"items": []})["items"] if r["cand"] == a.cand]
        dup = next((r for r in rows0 if r["status"] == "active" and _photo_norm(r["url"]) == _photo_norm(url)), None)
        if dup:
            out({"ok": True, "duplicate_of": dup["id"], "note": f"the same image address as {dup['id']} ({dup['angle']}); parameters that only change the size are ignored, nothing was added"})
        pr = _probe_link(url, None, a.allow_private_host)
        if pr["link_status"] == "refused":
            out({"ok": False, "error": pr["error"], "refused": True}, 1)
        row = {"cand": a.cand, "pick": n, "url": url, "page_url": page, "source_kind": a.source_kind, "variant": (a.variant or "").strip(), "angle": angle,
               "basis": a.basis, "retrieved": dt.date.today().isoformat(), "note": a.note, "https": url.lower().startswith("https://"), "expiring": _photo_expiring(url),
               "link_status": pr["link_status"], "http": pr["http"], "content_type": pr["content_type"], "bytes": pr["bytes"], "final_url": pr["final_url"],
               "probe_error": pr["error"], "declared_px": a.declared_px, "rights": "unknown", "looked_at": False, "background": None,
               "watermark": None, "brand_marks": None, "same_variant": None, "status": "active", "by": a.by, "added": now_iso()}
        with FileLock(lk):
            data = _vb_load(p, {"created": now_iso(), "items": []})
            row["id"] = f"PH{len(data['items']) + 1:03d}"
            data["items"].append(row)
            data["updated"] = now_iso()
            write_json(p, data)
        out({"ok": True, "id": row["id"], "link_status": pr["link_status"], "http": pr["http"], "content_type": pr["content_type"], "bytes": pr["bytes"], "https": row["https"],
             "may_expire": row["expiring"], "final_url": pr["final_url"], "probe_error": pr["error"],
             "next": "recorded as it is, nothing was judged or rejected: reject a link with `photo set --reject --reason ...`; nothing was downloaded; the angle is yours to state as the "
                     "source labels it - do not set the visual flags (nobody has looked at the image)"})
    if a.action == "set":
        visual = {"background": a.background, "watermark": a.watermark, "brand_marks": a.brand_marks, "same_variant": a.same_variant}
        if any(v is not None for v in visual.values()) and a.looked_at != "yes":
            fail("a background, watermark, brand-marks or same-variant flag is a statement about the image itself: pass --looked-at yes only if you opened "
                 "the image yourself (for example in the user's browser). A background agent cannot see images, so it leaves these unset", 2)
        with FileLock(lk):
            data = _vb_load(p, {"items": []})
            row = next(r for r in data["items"] if r["id"] == a.id)
            if a.rights and a.rights != "unknown" and len(((a.note if a.note is not None else row.get("note")) or "").strip()) < 12:
                fail("--rights other than unknown needs a --note that says where the page states it (a licence, a reseller or press-kit permission, or 'own sample photo')", 2)
            for k, v in (("angle", a.angle), ("basis", a.basis), ("rights", a.rights), ("note", a.note), ("variant", a.variant)):
                if v is not None:
                    if k == "angle":
                        v = _photo_angle(v)
                        if not PHOTO_ANGLE_RX.match(v):
                            fail("--angle is a short lowercase word", 2)
                    row[k] = v
            for k, v in visual.items():
                if v is not None:
                    row[k] = v if k == "background" else (v == "yes")
            if a.looked_at == "yes":
                row["looked_at"], row["looked_on"] = True, dt.date.today().isoformat()
            if a.reject:
                if not (a.reason or "").strip():
                    fail("--reject needs --reason", 2)
                row["status"], row["reason"] = "rejected", a.reason
            if a.restore:
                row["status"], row["reason"] = "active", None
            row.setdefault("history", []).append({"at": now_iso(), "by": a.by, "reject": bool(a.reject), "reason": a.reason})
            data["updated"] = now_iso()
            write_json(p, data)
        out({"ok": True, **{k: row.get(k) for k in ("id", "angle", "basis", "link_status", "looked_at", "background", "watermark", "brand_marks", "same_variant", "rights", "status")}})
    rows = [r for r in _vb_load(p, {"items": []})["items"] if r["cand"] == a.cand]
    name = cands[a.cand].get("name")
    summ = _photo_coverage(rows, cfg)
    if a.action == "list":
        L = _photo_md(a.cand, name, rows, summ)
        if a.out:
            write_text(Path(a.out), "\n".join(L) + "\n")
        if a.md:
            print("\n".join(L))
        out({"ok": True, "count": len(rows), "items": rows if not (a.md or a.out) else [r["id"] for r in rows], "out": a.out})
    if pack is not None:                                           # check: refresh the files that carry the links
        write_text(pack / "photos.md", "\n".join(_photo_md(a.cand, name, rows, summ)) + "\n")
        write_text(pack / "photos.html", _photo_gallery_html(name, a.cand, rows, summ))
        keep = ("id", "angle", "basis", "url", "page_url", "source_kind", "variant", "link_status", "content_type", "bytes", "final_url", "https", "expiring",
                "declared_px", "rights", "looked_at", "background", "watermark", "brand_marks", "same_variant", "retrieved", "note")
        write_json(pack / "photo-links.json", {"cand": a.cand, "name": name, "generated": now_iso(), "nothing_downloaded": True, "coverage": summ,
                                               "links": [{k: r.get(k) for k in keep} for r in rows if r["status"] == "active"]})
    out({"ok": True, **summ, "pack": str(pack) if pack is not None else None})


# --------------------------------------------------------------------------- CLI

def main():
    ap = argparse.ArgumentParser(prog="atg.py", description=__doc__.split("\n\n")[0])
    sp = ap.add_subparsers(dest="cmd", required=True)

    p = sp.add_parser("new-run"); p.add_argument("--mode", choices=["analyze", "edit"], required=True)
    p.add_argument("--source", nargs="*", help="analyze: the references folder; edit: video file(s) or folder")
    p.add_argument("--assets", nargs="*", help="analyze: ALL client asset files/folders, given up front")
    p.add_argument("--examples", nargs="*", help="optional, both modes: your own finished videos (study only)")
    p.add_argument("--submode", choices=["recreate", "create", "viral-browser"],
                   help="analyze: the sub-mode (viral-browser adds 30-research/ and deliverables/)")
    p.add_argument("--baseline", nargs="*", help="viral-browser, optional: videos that did NOT spread (contrast set)")
    p.add_argument("--slug"); p.add_argument("--runs-root"); p.set_defaults(fn=cmd_new_run)

    p = sp.add_parser("state"); p.add_argument("--run", required=True)
    p.add_argument("action", choices=["get", "set", "append"]); p.add_argument("pairs", nargs="*")
    p.set_defaults(fn=cmd_state)

    p = sp.add_parser("inventory"); p.add_argument("paths", nargs="+", help="files and/or folders")
    p.add_argument("--run"); p.add_argument("--as", dest="role", choices=["references", "sources", "assets", "examples", "baseline"],
                                            default="references")
    p.add_argument("--scope", help="asset scope: 'project' (analyze, default) or e.g. 'video-01' (edit)")
    p.add_argument("--max-depth", type=int); p.set_defaults(fn=cmd_inventory)

    p = sp.add_parser("prep-assets"); p.add_argument("--run", required=True); p.add_argument("--scope")
    p.set_defaults(fn=cmd_prep_assets)

    p = sp.add_parser("ledger"); p.add_argument("action", choices=["begin", "set", "show"])
    p.add_argument("--run", required=True); p.add_argument("--video"); p.add_argument("--attempt", type=int, default=1)
    p.add_argument("--request", help="the request JSON about to be submitted (begin)")
    p.add_argument("--fingerprint"); p.add_argument("--job")
    p.add_argument("--status", choices=["submitted", "unknown", "completed", "failed", "accepted", "rejected", "superseded"])
    p.add_argument("--note")
    p.add_argument("--lane", help="lane override (default: the video number before any '-')")
    p.add_argument("--max-open", type=int, help="the cap that begin reports the open submissions against (default production.max_parallel_jobs)")
    p.set_defaults(fn=cmd_ledger)

    p = sp.add_parser("open"); p.add_argument("--file", required=True); p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_open)

    p = sp.add_parser("model-menu"); p.add_argument("--mode", choices=["analyze", "edit"])
    p.add_argument("--live-ids", help="comma/space separated model ids from models_explore list type=video")
    p.add_argument("--live-file", help="JSON file with the models_explore list output (items[].id)")
    p.set_defaults(fn=cmd_model_menu)

    def media_opts(p):
        p.add_argument("--fps", type=float, default=cfg_get("analysis.baseline_fps", 5.0),
                       help="baseline sampling rate (default 5)")
        p.add_argument("--dense-fps", type=float, default=cfg_get("analysis.dense_fps", 10.0),
                       help="rate used around motion peaks and in the first second (default 10)")
        p.add_argument("--static-threshold", type=float, default=cfg_get("analysis.static_threshold", 2.5),
                       help="mean abs grey difference (0-255) below which a frame counts as a static duplicate; 0 disables thinning")
        p.add_argument("--max-frames", type=int, default=cfg_get("analysis.max_baseline_frames", 1800))
        p.add_argument("--whisper-model", default=cfg_get("whisper_model", "small"))
        p.add_argument("--language", default="auto")
        p.add_argument("--no-transcript", action="store_true")
        p.add_argument("--no-vad", action="store_true", help="transcribe without the voice-activity filter: sung words over music are not dropped, "
                                                            "but words may be invented over pure music (a second pass for a music-led video)")
        p.add_argument("--no-ocr", action="store_true")
        p.add_argument("--ocr-frames", type=int, default=cfg_get("analysis.ocr_frames", 12))

    p = sp.add_parser("prep-video"); p.add_argument("video"); p.add_argument("--out", required=True)
    p.add_argument("--id"); media_opts(p); p.set_defaults(fn=cmd_prep_video)

    p = sp.add_parser("prep-all"); p.add_argument("--run", required=True); p.add_argument("--only")
    p.add_argument("--set", dest="inv_set", choices=["references", "examples", "baseline"], default="references",
                   help="examples: prepare the examples inventory (10-media/E…, examples-index.md); "
                        "baseline: the Viral-Browser contrast set (10-media/B…, baseline-index.md)")
    p.add_argument("--redo", action="store_true"); p.add_argument("--skip-images", action="store_true")
    p.add_argument("--jobs", type=int, default=cfg_get("analysis.jobs", 2)); media_opts(p)
    p.set_defaults(fn=cmd_prep_all)

    p = sp.add_parser("frames"); p.add_argument("video"); p.add_argument("--out", required=True)
    p.add_argument("--at"); p.add_argument("--range", action="append")
    p.add_argument("--fps", type=float, default=15.0, help="rate for --range (default 15)")
    p.add_argument("--label"); p.add_argument("--title"); p.add_argument("--sheet", action="store_true")
    p.add_argument("--max-side", type=int, default=1280); p.set_defaults(fn=cmd_frames)

    p = sp.add_parser("prep-image"); p.add_argument("image"); p.add_argument("--out", required=True)
    p.add_argument("--max-side", type=int, default=1280); p.set_defaults(fn=cmd_prep_image)

    p = sp.add_parser("doc-text"); p.add_argument("file"); p.add_argument("--out"); p.set_defaults(fn=cmd_doc_text)

    p = sp.add_parser("hf-put"); p.add_argument("--file", required=True); p.add_argument("--url", required=True)
    p.add_argument("--content-type"); p.add_argument("--retries", type=int, default=3)
    p.add_argument("--timeout", type=int, default=900); p.set_defaults(fn=cmd_hf_put)

    p = sp.add_parser("hf-get"); p.add_argument("--url", required=True); p.add_argument("--out", required=True)
    p.add_argument("--retries", type=int, default=4); p.set_defaults(fn=cmd_hf_get)

    p = sp.add_parser("fetch-audio"); p.add_argument("--url", required=True, help="direct audio-file URL")
    p.add_argument("--out", required=True); p.add_argument("--page", help="the source page the URL came from")
    p.add_argument("--license", required=True, help="license as stated on the source page")
    p.add_argument("--title"); p.add_argument("--author"); p.add_argument("--role", help="soundtrack | sfx:<name>")
    p.add_argument("--retries", type=int, default=3); p.set_defaults(fn=cmd_fetch_audio)

    p = sp.add_parser("audio-profile"); p.add_argument("--audio", required=True, help="files_audio file or the original video")
    p.add_argument("--out", required=True); p.add_argument("--transcript", help="10-media/<V>/transcript.json")
    p.add_argument("--cuts", help="10-media/<V>/cuts.json"); p.set_defaults(fn=cmd_audio_profile)

    p = sp.add_parser("audio-context", help="what the references say and sound like: the transcripts, the language, the speech facts and the sound facts of every prepared video, in one digest; --check verifies it and the cards")
    p.add_argument("--run", required=True)
    p.add_argument("--set", choices=["references", "baseline", "examples"], default="references")
    p.add_argument("--profile", action="store_true", help="also measure the sound design (audio-profile.json) of the videos that lack it")
    p.add_argument("--second-pass", action="store_true", dest="second_pass", help="for a video in which no speech was found, transcribe its audio again WITHOUT the voice filter "
                   "(sung words are not dropped; words may be invented over pure music or a tone) and show the result in the digest; nothing prepared is changed")
    p.add_argument("--whisper-model", default=cfg_get("whisper_model", "small"), help="the model of the second pass (default: the configured one)")
    p.add_argument("--check", action="store_true", help="exit 1 when a transcript is missing, failed or skipped, or when a card lacks its 'Audio context:' and 'Said:' lines; "
                                                         "writes nothing unless --out is given (other agents may be reading the digest)")
    p.add_argument("--cards", action="store_true", help="with --check: every video must also HAVE a card")
    p.add_argument("--out", help="where to write the digest (default 20-analysis/audio-context.md; the data file is written beside it)")
    p.set_defaults(fn=cmd_audio_context)

    p = sp.add_parser("split-audio"); p.add_argument("paths", nargs="+", help="the given video folder(s)/file(s)")
    p.add_argument("--run"); p.add_argument("--redo", action="store_true")
    p.add_argument("--audio-only", action="store_true", help="files_audio/ only, no silent copies (Analyze Create)")
    p.set_defaults(fn=cmd_split_audio)

    p = sp.add_parser("finalize"); p.add_argument("--run", required=True); p.add_argument("--file", required=True)
    p.add_argument("--original", required=True, help="the ORIGINAL video path (as in the inventory)")
    p.add_argument("--video", help="V id, for the run record"); p.add_argument("--expect-size", default="720x1280")
    p.set_defaults(fn=cmd_finalize)

    p = sp.add_parser("restore-audio"); p.add_argument("--generated", required=True)
    p.add_argument("--audio", help="original audio from files_audio (preferred)")
    p.add_argument("--audio-offset", type=float, default=0.0, help="audio_offset from audio-split.json")
    p.add_argument("--source", help="original video (alternative to --audio)")
    p.add_argument("--start", type=float, default=0.0, help="segment start in the original timeline")
    p.add_argument("--out", required=True); p.add_argument("--duration", type=float)
    p.set_defaults(fn=cmd_restore_audio)

    p = sp.add_parser("sync-check", help="do the output's actions land where the original audio expects them?")
    p.add_argument("--source", required=True, help="the source picture the output must follow (silent copy / prepared source / own-silent.mp4)")
    p.add_argument("--output", required=True, help="the generated picture (raw, trimmed, joined or with-original-audio)")
    p.add_argument("--start", type=float, default=0.0, help="segment start in the source timeline (same as restore-audio --start)")
    p.add_argument("--duration", type=float, help="limit the compared span")
    p.add_argument("--out", required=True, help="folder for sync-check.json and sync-sheet.jpg")
    p.add_argument("--fps", type=float, default=30.0)
    p.add_argument("--tol", type=float, default=0.10, help="list the windows whose offset is beyond this many seconds (a list on request, not a verdict)")
    p.add_argument("--min-corr", type=float, default=0.5, help="the summary uses only the windows whose correlation is at least this (all windows stay listed)")
    p.add_argument("--min-motion", type=float, default=0.25, help="the summary uses only the windows whose motion is at least this share of the whole segment's")
    p.add_argument("--max-lag", type=float, default=1.5, help="largest offset searched, seconds")
    p.add_argument("--window", type=float, default=2.0, help="window for the per-window offsets, seconds")
    p.add_argument("--at", help="sheet timestamps on the output timeline, comma-separated (default: the source's strongest motion moments)")
    p.add_argument("--anchors", type=int, default=8, help="number of automatic sheet timestamps")
    p.set_defaults(fn=cmd_sync_check)

    p = sp.add_parser("qc"); p.add_argument("--video", required=True); p.add_argument("--out", required=True)
    p.add_argument("--fps", type=float, default=cfg_get("analysis.baseline_fps", 5.0))
    p.add_argument("--expect-duration", type=float); p.add_argument("--expect-aspect", default="9:16")
    p.add_argument("--expect-size", default=cfg_get("output.size", "720x1280"))
    p.add_argument("--mode", choices=["analyze", "edit"], default="analyze")
    p.add_argument("--allowed-text", help="planned/kept text, '|' separated (captions you burned in, real label text)")
    p.add_argument("--dense", action="append", metavar="LABEL:START-END",
                   help="QC checkpoint rendered at the full frame rate (seconds), e.g. sip:3.5-5.6 — a use beat, "
